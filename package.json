{
	"name": "bread",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"prebuild": "node scripts/generate-data.mjs",
		"build": "npm run prebuild && astro check && astro build",
		"preview": "astro preview",
		"lint": "biome check .",
		"format": "biome format --write .",
		"generate-types": "wrangler types",
		"prepare": "husky",
		"test": "vitest run",
		"check:production-edge": "bash scripts/check_production_edge.sh",
		"setup": "mise trust && bun install",
		"assets:check": "bun run scripts/check-assets.ts",
		"check": "bun run assets:check",
		"assets:generate": "bun run scripts/generate-scenes.ts"
	},
	"dependencies": {
		"@astrojs/mdx": "^6.0.1",
		"@astrojs/rss": "^4.0.18",
		"@astrojs/sitemap": "^3.7.3",
		"alpinejs": "^3.15.12",
		"astro": "^6.4.2",
		"bun": "^1.3.14",
		"leaflet": "^1.9.4",
		"pagefind": "^1.5.2",
		"preact": "^10.29.2",
		"vite-plugin-pwa": "^1.3.0",
		"workbox-window": "^7.4.1"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/cloudflare": "^13.6.0",
		"@biomejs/biome": "^2.4.16",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.5",
		"prettier": "^3.8.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.7",
		"wrangler": "^4.95.0"
	},
	"overrides": {
		"vite": "^7"
	}
}
