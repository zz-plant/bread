---
interface Props {
  href: string;
  label: string;
  external?: boolean;
  variant?: 'list' | 'rail';
}

const { href, label, external = false, variant = 'list' } = Astro.props;

const FALLBACK_HREF = '#';
const ALLOWED_PROTOCOLS = new Set(['http:', 'https:', 'mailto:', 'tel:']);

const sanitizeHref = (value: string): string => {
  const normalizedValue = value.trim();
  if (!normalizedValue) return FALLBACK_HREF;

  if (
    normalizedValue.startsWith('/') ||
    normalizedValue.startsWith('#') ||
    normalizedValue.startsWith('?') ||
    normalizedValue.startsWith('./') ||
    normalizedValue.startsWith('../')
  ) {
    return normalizedValue;
  }

  const hasExplicitScheme = /^[a-zA-Z][a-zA-Z\d+.-]*:/.test(normalizedValue);
  if (!hasExplicitScheme) return normalizedValue;

  try {
    const parsed = new URL(normalizedValue, 'https://bread.invalid');
    return ALLOWED_PROTOCOLS.has(parsed.protocol) ? normalizedValue : FALLBACK_HREF;
  } catch {
    return FALLBACK_HREF;
  }
};

const safeHref = sanitizeHref(href);
const isSafeExternal = external && safeHref !== FALLBACK_HREF;
---

<a
  href={safeHref}
  class:list={['card-link', variant === 'rail' && 'card-link--rail']}
  target={isSafeExternal ? '_blank' : undefined}
  rel={isSafeExternal ? 'noreferrer noopener' : undefined}
>
  {label}
</a>

<style>
  .card-link {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: none;
  }

  .card-link:hover,
  .card-link:focus-visible {
    text-decoration: underline;
  }

  .card-link--rail {
    display: block;
    padding: 0.72rem 0.8rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    text-decoration: none;
    text-transform: uppercase;
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    background: var(--color-surface);
    transition: border-color 180ms ease, color 180ms ease;
    font-weight: 400;
  }

  .card-link--rail:hover,
  .card-link--rail:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-text);
    text-decoration: none;
    outline: none;
  }
</style>
