---
interface Props {
  href: string;
  label: string;
  external?: boolean;
  className?: string;
}

const { href, label, external = false, className } = Astro.props;

const FALLBACK_HREF = '#';
const ALLOWED_PROTOCOLS = new Set(['http:', 'https:', 'mailto:', 'tel:']);

const sanitizeHref = (value: string): string => {
  if (!value) return FALLBACK_HREF;

  if (value.startsWith('/') || value.startsWith('#') || value.startsWith('?')) return value;

  try {
    const parsed = new URL(value);
    return ALLOWED_PROTOCOLS.has(parsed.protocol) ? value : FALLBACK_HREF;
  } catch {
    return FALLBACK_HREF;
  }
};

const safeHref = sanitizeHref(href);
const isSafeExternal = external && safeHref !== FALLBACK_HREF;
---

<a
  href={safeHref}
  class:list={['card-link', className]}
  target={isSafeExternal ? '_blank' : undefined}
  rel={isSafeExternal ? 'noreferrer noopener' : undefined}
>
  {label}
</a>
