---
import { EVENT_FLYER_SIZES, FEATURED_IMAGE_SIZES } from "../utils/images";
import ResponsiveImage from "./ResponsiveImage.astro";

interface Visual {
	src: string;
	alt: string;
	title: string;
	caption: string;
	href: string;
}

interface Event {
	id: string;
	title: string;
	year: string;
	isoDate: string;
	date: string;
	month: string;
	day: string;
	flyer?: string;
	venue: string;
	lineup: string;
	confidence: string;
	status: string;
	source: {
		label: string;
		href?: string;
		external?: boolean;
	};
}

interface Props {
	visuals: Visual[];
	events: Event[];
}

const { visuals, events } = Astro.props;
const visualDestinations = Array.from(
	new Map(
		visuals.map((item) => [
			item.href,
			item.href === "/archive/flyers/" ? "All flyers →" : "Read the story →",
		]),
	).entries(),
);
---

<article class="panel active" id="panel-events" role="tabpanel" aria-labelledby="tab-events">
  <h2 class="visually-hidden">Events</h2>

  <section class="featured-visuals" aria-labelledby="featured-visuals-title">
    <div class="featured-visuals-head">
      <h3 id="featured-visuals-title">Flyers and photos</h3>
      <nav class="featured-visual-links" aria-label="More flyers and photos">
        {visualDestinations.map(([href, label]) => <a href={href}>{label}</a>)}
      </nav>
    </div>
    <ul class="featured-visual-grid">
      {visuals.map((item, visualIndex) => (
        <li>
          <figure>
            <ResponsiveImage src={item.src} alt={item.alt} sizes={FEATURED_IMAGE_SIZES} priority={visualIndex === 0} />
            <figcaption>
              <p>{item.title}</p>
              <small>{item.caption}</small>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </section>

  <div class="events-toolbar" role="search" aria-label="Search and sort events">
    <div class="search-wrapper">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
      <input type="search" id="eventSearch" name="event-search" placeholder="Search by name, venue, or artist" aria-label="Search events by name, venue, or artist" autocomplete="off" />
    </div>
    <label class="event-control">
      <span>Sort</span>
      <select id="eventSort">
        <option value="oldest">Oldest first</option>
        <option value="newest">Newest first</option>
      </select>
    </label>
    <p class="result-count" id="eventsResultCount" aria-live="polite">{events.length} events</p>
  </div>

  <ul class="cards event-list">
    {events.map((event, index) => (
      <li class:list={['card', 'event-row', (index === 0 || events[index - 1].year !== event.year) && 'year-start']} id={`event-${event.id}`} data-kind="event" data-index={index} data-year={event.year} data-venue={event.venue} data-lineup={event.lineup} data-status={event.status} data-has-source={event.source.href ? 'true' : 'false'}>
        <p class="event-date"><time datetime={event.isoDate}><span class="event-month">{event.month}</span> <span class="event-day">{event.day}</span><span class="visually-hidden">, {event.year}</span></time></p>
        <div class="event-flyer">
          {event.flyer && (
            <a href={event.flyer} target="_blank" rel="noreferrer noopener">
              <ResponsiveImage src={event.flyer} alt={`${event.title} flyer`} sizes={EVENT_FLYER_SIZES} />
            </a>
          )}
        </div>
        <div class="event-main">
          <h3 class="title">
            {event.title}
            {event.status !== 'played' && (
              <span class={`status-badge status-${event.status}`}>{event.status}</span>
            )}
          </h3>
          <p class="lineup">{event.lineup}</p>
        </div>
        <p class="meta event-venue">{event.venue}</p>
        {event.source.href && (
          <p class="status source-row"><a href={event.source.href} target={event.source.external ? '_blank' : undefined} rel={event.source.external ? 'noreferrer noopener' : undefined}>{event.source.label}{event.source.external ? ' ↗' : ''}</a></p>
        )}
      </li>
    ))}
  </ul>
  <p class="events-empty" id="eventsEmpty" hidden>No events match that search.</p>
  <div class="load-more-container">
    <button class="chip" type="button" id="loadMoreEvents">Show more</button>
  </div>
</article>
