---
interface Visual {
	src: string;
	alt: string;
	title: string;
	caption: string;
	href: string;
}

interface Event {
	id: string;
	title: string;
	year: string;
	date: string;
	venue: string;
	lineup: string;
	confidence: string;
	status: string;
	source: {
		label: string;
		href?: string;
		external?: boolean;
	};
}

interface Props {
	visuals: Visual[];
	events: Event[];
}

const { visuals, events } = Astro.props;
const visualDestinations = Array.from(
	new Map(
		visuals.map((item) => [
			item.href,
			item.href === "/archive/flyers/" ? "Browse flyers →" : "Read the story →",
		]),
	).entries(),
);
---

<article class="panel active" id="panel-events" role="tabpanel" aria-labelledby="tab-events">
  <div class="panel-heading">
    <div>
      <p class="section-kicker">Documented chronology</p>
      <h2>Events</h2>
    </div>
    <p class="result-count" id="eventsResultCount">{events.length} events shown</p>
  </div>
  <p class="events-intro">Dates, venues, lineups, and sources from the documented archive.</p>

  <div class="events-toolbar" aria-label="Search and sort events">
    <div class="search-wrapper">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
      <input type="search" id="eventSearch" name="event-search" placeholder="Search title, venue, or lineup…" aria-label="Search events by title, venue, or lineup" autocomplete="off" />
    </div>
    <label class="event-control">
      <span>Sort</span>
      <select id="eventSort" aria-label="Sort events">
        <option value="oldest">Oldest first</option>
        <option value="newest">Newest first</option>
        <option value="year">Group by year</option>
      </select>
    </label>
  </div>

  <section class="featured-visuals" aria-label="Featured visuals">
    <div class="featured-visuals-head">
      <h3>Flyers + photos</h3>
      <p>A few flyer and party photos from the archive.</p>
    </div>
    <ul class="featured-visual-grid">
      {visuals.map((item, visualIndex) => (
        <li>
          <figure>
            <img src={item.src} alt={item.alt} width="960" height="720" loading={visualIndex === 0 ? 'eager' : 'lazy'} fetchpriority={visualIndex === 0 ? 'high' : undefined} decoding={visualIndex === 0 ? 'sync' : 'async'} sizes="(max-width: 780px) 92vw, 32vw" />
            <figcaption>
              <p>{item.title}</p>
              <small>{item.caption}</small>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
    <nav class="featured-visual-links" aria-label="Visual archive links">
      {visualDestinations.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
  </section>

  <ul class="cards">
     {events.map((event, index) => (
       <li class="card" id={`event-${event.id}`} data-kind="event" data-index={index} data-year={event.year} data-venue={event.venue} data-lineup={event.lineup} data-status={event.status} data-has-source={event.source.href ? 'true' : 'false'}>
         <div class="card-header">
           <h3 class="title">{event.title}</h3>
           <span class={`status-badge status-${event.status}`} aria-label={`Status: ${event.status}`}>
            {event.status === 'played' && '✓ '}
            {event.status === 'cancelled' && '✕ '}
            {event.status === 'postponed' && '⏸ '}
            {event.status}
          </span>
         </div>
         <p class="meta">{event.year} · {event.date} · {event.venue}</p>
         <p class="lineup">{event.lineup}</p>
         {event.source.href ? (
           <p class="status source-row">Source: <a href={event.source.href} target={event.source.external ? '_blank' : undefined} rel={event.source.external ? 'noreferrer noopener' : undefined}>{event.source.label}</a></p>
         ) : (
           <p class="status source-row">Source: {event.source.label}</p>
         )}
       </li>
      ))}
  </ul>
  <div class="load-more-container">
    <button class="chip" type="button" id="loadMoreEvents">Load more events</button>
  </div>
</article>
