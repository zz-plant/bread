---
// Renders an image from public/ through the resized AVIF/WebP/JPEG copies
// that scripts/generate-responsive-images.mjs writes during prebuild.
import type { HTMLAttributes } from "astro/types";
import manifest from "../data/responsive-images.json";
import type { ResponsiveImageEntry } from "../utils/images";

interface Props
	extends Omit<
		HTMLAttributes<"img">,
		| "src"
		| "srcset"
		| "sizes"
		| "width"
		| "height"
		| "loading"
		| "decoding"
		| "fetchpriority"
	> {
	/** Path of the original under public/, e.g. "/drive/img_0530.jpg". */
	src: string;
	alt: string;
	sizes: string;
	/** The page's largest image in the first screen: fetch it first, never lazily. */
	priority?: boolean;
}

const { src, alt, sizes, priority = false, ...attributes } = Astro.props;
const image = (manifest as Record<string, ResponsiveImageEntry>)[src];

if (!image) {
	throw new Error(
		`No resized copies of ${src}. Put the original in public/ and run "npm run prebuild".`,
	);
}
---

<picture>
  {image.avif && <source type="image/avif" srcset={image.avif} sizes={sizes} />}
  <source type="image/webp" srcset={image.webp} sizes={sizes} />
  <img
    src={image.fallback.src}
    srcset={image.fallback.srcset}
    sizes={sizes}
    alt={alt}
    width={image.width}
    height={image.height}
    loading={priority ? "eager" : "lazy"}
    decoding={priority ? "sync" : "async"}
    fetchpriority={priority ? "high" : undefined}
    {...attributes}
  />
</picture>

<style>
  /* Lay out the <img> as if it were not wrapped: page grids and their gaps
     then see one child, as they did before <picture> was added. */
  picture {
    display: contents;
  }

  source {
    display: none;
  }
</style>
