---
import CardLink from "../CardLink.astro";

interface Props {
	directoryLinks: { label: string; href: string; external: boolean }[];
	soundcloudEmbedCollections: {
		title: string;
		description: string;
		href: string;
		height: number;
		visual: boolean;
	}[];
	platformEmbeds: {
		ipr: { title: string; href: string; src: string; height: number };
		appleShow: { title: string; href: string; src: string; height: number };
		appleEpisode: { title: string; href: string; src: string; height: number };
		facebook: { title: string; href: string; src: string; height: number };
	};
	residentSoundcloudProfiles: { name: string; role: string; href: string }[];
	buildSoundCloudEmbedSrc: (href: string, visual?: boolean) => string;
}

const {
	directoryLinks,
	soundcloudEmbedCollections,
	platformEmbeds,
	residentSoundcloudProfiles,
	buildSoundCloudEmbedSrc,
} = Astro.props;
---

<article class="panel" id="panel-links" role="tabpanel" aria-labelledby="tab-links" hidden>
  <h2>More links</h2>
  <ul class="route-list">
    {directoryLinks.map((item) => (
      <li>
        <CardLink href={item.href} label={item.label} external={item.external} />
      </li>
    ))}
  </ul>
</article>

<article class="panel" id="panel-audio" role="tabpanel" aria-labelledby="tab-audio" hidden>
  <h2>Listen</h2>
  <p class="audio-intro">Listen to BREAD uploads, playlists, and resident pages. Each player below loads on demand when you click "Load player".</p>
  <div class="audio-actions">
    <a href="https://soundcloud.com/breadfm" target="_blank" rel="noreferrer noopener">Open BREAD profile ↗</a>
  </div>
  <ul class="audio-grid">
    {soundcloudEmbedCollections.map((item) => (
      <li class="audio-card">
        <h3>{item.title}</h3>
        <p>{item.description}</p>
        <div class="embed-preview" data-title={item.title} data-height={item.height} data-allow="autoplay" data-embed-src={buildSoundCloudEmbedSrc(item.href, item.visual)}>
          <p>Player is paused until you load it.</p>
          <button class="chip load-player" type="button">Load player</button>
        </div>
        <a href={item.href} target="_blank" rel="noreferrer noopener">Open on SoundCloud ↗</a>
      </li>
    ))}
  </ul>
  <section class="resident-audio" aria-label="Resident channels">
    <h3>Resident pages</h3>
    <p class="resident-audio-copy">Quick player cards for each resident profile in this archive.</p>
    <ul class="resident-audio-grid">
      {residentSoundcloudProfiles.map((profile) => (
        <li>
          <h4>{profile.name}</h4>
          <p>{profile.role}</p>
          <div class="embed-preview" data-title={`${profile.name} SoundCloud profile`} data-height="166" data-allow="autoplay" data-embed-src={buildSoundCloudEmbedSrc(profile.href, false)}>
            <p>Load this resident player when needed.</p>
            <button class="chip load-player" type="button">Load player</button>
          </div>
          <a href={profile.href} target="_blank" rel="noreferrer noopener">Visit profile ↗</a>
        </li>
      ))}
    </ul>
  </section>
  <section class="platform-embeds" aria-label="Other players">
    <h3>Other players</h3>
    <p class="resident-audio-copy">More listening spots: Internet Public Radio, Apple Podcasts, and Facebook. Instagram and RA are linked in the links tab.</p>
    <ul class="audio-grid">
      <li class="audio-card">
        <h4>{platformEmbeds.ipr.title}</h4>
        <div class="embed-preview featured-player" data-title={platformEmbeds.ipr.title} data-height={platformEmbeds.ipr.height} data-embed-src={platformEmbeds.ipr.src}>
          <p>Load the IPR player when needed.</p>
          <button class="chip load-player" type="button">Load player</button>
        </div>
        <a href={platformEmbeds.ipr.href} target="_blank" rel="noreferrer noopener">Open IPR episode ↗</a>
      </li>
      <li class="audio-card">
        <h4>{platformEmbeds.appleShow.title}</h4>
        <div class="embed-preview" data-title={platformEmbeds.appleShow.title} data-height={platformEmbeds.appleShow.height} data-allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write" data-sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-top-navigation-by-user-activation" data-embed-src={platformEmbeds.appleShow.src}>
          <p>Load the Apple Podcasts show embed when needed.</p>
          <button class="chip load-player" type="button">Load player</button>
        </div>
        <a href={platformEmbeds.appleShow.href} target="_blank" rel="noreferrer noopener">Open Apple show ↗</a>
      </li>
      <li class="audio-card">
        <h4>{platformEmbeds.appleEpisode.title}</h4>
        <div class="embed-preview" data-title={platformEmbeds.appleEpisode.title} data-height={platformEmbeds.appleEpisode.height} data-allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write" data-sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-top-navigation-by-user-activation" data-embed-src={platformEmbeds.appleEpisode.src}>
          <p>Load the Apple Podcasts episode embed when needed.</p>
          <button class="chip load-player" type="button">Load player</button>
        </div>
        <a href={platformEmbeds.appleEpisode.href} target="_blank" rel="noreferrer noopener">Open Apple episode ↗</a>
      </li>
      <li class="audio-card">
        <h4>{platformEmbeds.facebook.title}</h4>
        <div class="embed-preview" data-title={platformEmbeds.facebook.title} data-height={platformEmbeds.facebook.height} data-allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share" data-embed-src={platformEmbeds.facebook.src}>
          <p>Load the Facebook page embed only if you need it.</p>
          <button class="chip load-player" type="button">Load player</button>
        </div>
        <a href={platformEmbeds.facebook.href} target="_blank" rel="noreferrer noopener">Open Facebook page ↗</a>
      </li>
    </ul>
  </section>
</article>