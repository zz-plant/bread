---
import CardLink from "../CardLink.astro";

interface Props {
	directoryLinks: { label: string; href: string; external: boolean }[];
	soundcloudEmbedCollections: {
		title: string;
		description: string;
		href: string;
		height: number;
		visual: boolean;
	}[];
	platformEmbeds: {
		ipr: { title: string; href: string; src: string; height: number };
		appleShow: { title: string; href: string; src: string; height: number };
		appleEpisode: { title: string; href: string; src: string; height: number };
		facebook: { title: string; href: string; src: string; height: number };
	};
	residentSoundcloudProfiles: { name: string; role: string; href: string }[];
	buildSoundCloudEmbedSrc: (href: string, visual?: boolean) => string;
}

const {
	directoryLinks,
	soundcloudEmbedCollections,
	platformEmbeds,
	residentSoundcloudProfiles,
	buildSoundCloudEmbedSrc,
} = Astro.props;

const listeningLinks = directoryLinks.filter(
	(item) => item.href !== "https://soundcloud.com/breadfm",
);

const [featuredCollection, ...moreCollections] = soundcloudEmbedCollections;
const appleAllow =
	"autoplay *; encrypted-media *; fullscreen *; clipboard-write";
const appleSandbox =
	"allow-forms allow-popups allow-same-origin allow-scripts allow-top-navigation-by-user-activation";

const radioPlayers = [
	{
		...platformEmbeds.ipr,
		linkLabel: "Internet Public Radio",
	},
	{
		...platformEmbeds.appleShow,
		linkLabel: "Apple Podcasts",
		allow: appleAllow,
		sandbox: appleSandbox,
	},
	{
		...platformEmbeds.appleEpisode,
		linkLabel: "Apple Podcasts",
		allow: appleAllow,
		sandbox: appleSandbox,
	},
	{
		...platformEmbeds.facebook,
		linkLabel: "Facebook",
		allow:
			"autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share",
	},
];
---

<article class="panel" id="panel-audio" role="tabpanel" aria-labelledby="tab-audio" hidden>
  <h2 class="visually-hidden">Listen</h2>

  <div class="listen-intro">
    <p class="audio-intro">Mixes and radio shows from BREAD and the residents.</p>
    <a class="chip-link" href="https://soundcloud.com/breadfm" target="_blank" rel="noreferrer noopener">BREAD on SoundCloud ↗</a>
  </div>

  {featuredCollection && (
    <section class="listen-featured player-row" data-player aria-labelledby="listen-featured-title">
      <div class="player-head">
        <div>
          <h3 id="listen-featured-title">{featuredCollection.title}</h3>
          <p>{featuredCollection.description}</p>
        </div>
        <div class="player-actions">
          <button class="chip load-player" type="button" aria-label={`Load ${featuredCollection.title} player`}>
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 1l9 5-9 5z" fill="currentColor"/></svg>
            Load player
          </button>
          <a href={featuredCollection.href} target="_blank" rel="noreferrer noopener">SoundCloud ↗</a>
        </div>
      </div>
      <div class="embed-preview" data-autoload data-title={featuredCollection.title} data-height="360" data-allow="autoplay" data-embed-src={buildSoundCloudEmbedSrc(featuredCollection.href, featuredCollection.visual)} hidden></div>
    </section>
  )}

  <section class="listen-section" aria-labelledby="more-collections-title">
    <h3 id="more-collections-title">More from BREAD</h3>
    <ul class="player-list">
      {moreCollections.map((item) => (
        <li class="player-row" data-player>
          <div class="player-head">
            <div>
              <h4>{item.title}</h4>
              <p>{item.description}</p>
            </div>
            <div class="player-actions">
              <button class="chip load-player" type="button" aria-label={`Load ${item.title} player`}>
                <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 1l9 5-9 5z" fill="currentColor"/></svg>
                Load player
              </button>
              <a href={item.href} target="_blank" rel="noreferrer noopener">SoundCloud ↗</a>
            </div>
          </div>
          <div class="embed-preview" data-title={item.title} data-height={item.height} data-allow="autoplay" data-embed-src={buildSoundCloudEmbedSrc(item.href, item.visual)} hidden></div>
        </li>
      ))}
    </ul>
  </section>

  <section class="listen-section resident-audio" aria-labelledby="resident-audio-title">
    <h3 id="resident-audio-title">Residents</h3>
    <ul class="player-list">
      {residentSoundcloudProfiles.map((profile) => (
        <li class="player-row" data-player>
          <div class="player-head">
            <div>
              <h4>{profile.name}</h4>
              <p>{profile.role}</p>
            </div>
            <div class="player-actions">
              <button class="chip load-player" type="button" aria-label={`Load ${profile.name} player`}>
                <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 1l9 5-9 5z" fill="currentColor"/></svg>
                Load player
              </button>
              <a href={profile.href} target="_blank" rel="noreferrer noopener">SoundCloud ↗</a>
            </div>
          </div>
          <div class="embed-preview" data-title={`${profile.name} on SoundCloud`} data-height="166" data-allow="autoplay" data-embed-src={buildSoundCloudEmbedSrc(profile.href, false)} hidden></div>
        </li>
      ))}
    </ul>
  </section>

  <section class="listen-section platform-embeds" aria-labelledby="platform-embeds-title">
    <h3 id="platform-embeds-title">Radio and podcasts</h3>
    <ul class="player-list">
      {radioPlayers.map((player) => (
        <li class="player-row" data-player>
          <div class="player-head">
            <div>
              <h4>{player.title}</h4>
            </div>
            <div class="player-actions">
              <button class="chip load-player" type="button" aria-label={`Load ${player.title} player`}>
                <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 1l9 5-9 5z" fill="currentColor"/></svg>
                Load player
              </button>
              <a href={player.href} target="_blank" rel="noreferrer noopener">{player.linkLabel} ↗</a>
            </div>
          </div>
          <div class="embed-preview" data-title={player.title} data-height={player.height} data-allow={player.allow} data-sandbox={player.sandbox} data-embed-src={player.src} hidden></div>
        </li>
      ))}
    </ul>
  </section>

  <section class="listening-links" aria-labelledby="listening-links-title">
    <h3 id="listening-links-title">Elsewhere</h3>
    <ul class="route-list">
      {listeningLinks.map((item) => (
        <li>
          <CardLink href={item.href} label={item.label} external={item.external} />
        </li>
      ))}
    </ul>
  </section>
</article>
