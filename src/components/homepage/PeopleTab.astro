---
interface Person {
	name: string;
	role: string;
	notes?: string;
	links: Record<string, string | undefined>;
}

interface Props {
	roster: Person[];
}

const { roster } = Astro.props;
---

<article class="panel" id="panel-people" role="tabpanel" aria-labelledby="tab-people" hidden>
  <h2 class="visually-hidden">People</h2>
  <ul class="cards people">
    {roster.map((person: Person) => (
      <li class="card person" data-kind="person">
        <h3 class="person-name">{person.name}</h3>
        <p class="person-role">{person.role}</p>
        {person.notes && <p class="person-notes">{person.notes}</p>}
        <div class="person-links">
          {person.links.sc && (
            <a href={person.links.sc} class="person-link" target="_blank" rel="noreferrer noopener" aria-label={`${person.name} on SoundCloud`}>SoundCloud</a>
          )}
          {person.links.bc && (
            <a href={person.links.bc} class="person-link" target="_blank" rel="noreferrer noopener" aria-label={`${person.name} on Bandcamp`}>Bandcamp</a>
          )}
          {person.links.ig && (
            <a href={person.links.ig} class="person-link" target="_blank" rel="noreferrer noopener" aria-label={`${person.name} on Instagram`}>Instagram</a>
          )}
          {person.links.ra && (
            <a href={person.links.ra} class="person-link" target="_blank" rel="noreferrer noopener" aria-label={`${person.name} on Resident Advisor`}>RA</a>
          )}
        </div>
      </li>
    ))}
  </ul>
</article>
