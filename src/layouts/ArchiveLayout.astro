---
import Breadcrumbs from "../components/Breadcrumbs.astro";
import {
	createBreadcrumbListSchema,
	createCollectionPageSchema,
} from "../utils/structuredData";
import BaseLayout from "./BaseLayout.astro";

interface BreadcrumbItem {
	label: string;
	href?: string;
}

interface Stat {
	label: string;
	value: string | number;
}

interface Props {
	title: string;
	heading?: string;
	description: string;
	intro?: string;
	context?: string;
	breadcrumbItems: BreadcrumbItem[];
	stats?: Stat[];
	ogImage?: string;
	ogImageAlt?: string;
	structuredData?: Record<string, unknown>[];
}

const {
	title,
	heading = title,
	description,
	intro,
	context,
	breadcrumbItems,
	stats = [],
	ogImage,
	ogImageAlt,
	structuredData: extraStructuredData = [],
} = Astro.props;

const pageStructuredData = createCollectionPageSchema({
	site: Astro.site,
	pathname: Astro.url.pathname,
	name: title,
	description,
	isPartOf: "BREAD",
});

const breadcrumbStructuredData = createBreadcrumbListSchema({
	site: Astro.site,
	items: breadcrumbItems.map((item) => ({
		name: item.label,
		pathname: item.href || Astro.url.pathname,
	})),
});

const structuredData = [pageStructuredData, breadcrumbStructuredData, ...extraStructuredData].filter(
	(entry): entry is Record<string, unknown> => Boolean(entry),
);
---

<BaseLayout
  title={title}
  description={description}
  structuredData={structuredData}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
>
  <header class="page-header">
    <Breadcrumbs items={breadcrumbItems} />
    <h1>{heading}</h1>
    {intro && <p class="intro">{intro}</p>}
    {context && <p class="context"><Fragment set:html={context} /></p>}
    {
      stats.length > 0 && (
        <ul class="stats-strip" aria-label="Overview">
          {stats.map((stat) => (
            <li>
              <span class="stat-value">{stat.value}</span>
              <span class="stat-label">{stat.label}</span>
            </li>
          ))}
        </ul>
      )
    }
  </header>

  <slot />
</BaseLayout>
