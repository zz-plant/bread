---
import globalStylesUrl from "../styles/global.css?url";
import printStylesUrl from "../styles/print.css?url";
import { OG_IMAGE_HEIGHT, OG_IMAGE_WIDTH } from "../utils/ogImage";

interface NavLink {
	label: string;
	href: string;
}

interface Props {
	title: string;
	description?: string;
	showSiteFrame?: boolean;
	structuredData?: Record<string, unknown> | Record<string, unknown>[];
	canonical?: string;
	ogImage?: string;
	ogImageAlt?: string;
	noindex?: boolean;
	ogType?: "website" | "article";
	navLinks?: NavLink[];
	topStrip?: { left: string; right: string };
	footerNote?: string;
	wide?: boolean;
}

const DEFAULT_NAV_LINKS: NavLink[] = [
	{ label: "Home", href: "/" },
	{ label: "Archive", href: "/archive/" },
	{ label: "Story", href: "/story/" },
];

const {
	title,
	description = "History, flyers, and radio from BREAD in San Francisco.",
	showSiteFrame = true,
	structuredData,
	canonical,
	ogImage = "/og-default.svg",
	ogImageAlt,
	noindex = false,
	ogType,
	navLinks = DEFAULT_NAV_LINKS,
	topStrip,
	footerNote = "BREAD archive and story.",
	wide = false,
} = Astro.props;

const structuredDataEntries = (
	Array.isArray(structuredData) ? structuredData : [structuredData]
).filter((entry): entry is Record<string, unknown> => Boolean(entry));

const serializeJsonForScript = (value: Record<string, unknown>) =>
	JSON.stringify(value).replace(/</g, "\\u003c");

const pathname = Astro.url.pathname;
const toAbsoluteUrl = (value: string | undefined): string | undefined => {
	if (!value) return undefined;

	if (value.startsWith("http://") || value.startsWith("https://")) return value;
	if (!Astro.site) return undefined;

	return new URL(
		value.startsWith("/") ? value : `/${value}`,
		Astro.site,
	).toString();
};

const canonicalUrl = canonical
	? toAbsoluteUrl(canonical)
	: toAbsoluteUrl(Astro.url.pathname);
const ogImageUrl = toAbsoluteUrl(ogImage);
const resolvedOgType = ogType ?? "website";
const resolvedOgImageAlt = ogImageAlt ?? `${title} — ${description}`;

const isActiveLink = (href: string): boolean => {
	const path = pathname.replace(/\/+$/, "") || "/";
	const target = href.replace(/\/+$/, "") || "/";
	if (target === "/") return path === "/";
	if (path === target) return true;
	return path.startsWith(`${target}/`);
};

const activeLinkHref = navLinks
	.filter((link) => isActiveLink(link.href))
	.sort((a, b) => b.href.length - a.href.length)[0]?.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href={globalStylesUrl} />
    <link rel="stylesheet" href={printStylesUrl} media="print" />
    <title>{title}</title>

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:site_name" content="BREAD" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={resolvedOgType} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />}
    {ogImageUrl && <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />}
    {ogImageUrl && <meta property="og:image:alt" content={resolvedOgImageAlt} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:image:alt" content={resolvedOgImageAlt} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      structuredDataEntries.map((entry) => (
        <script is:inline type="application/ld+json" set:html={serializeJsonForScript(entry)} />
      ))
    }
  </head>
  <body>
    {
      showSiteFrame ? (
        <div class:list={['site-shell', wide && 'site-shell--wide']}>
          <a class="skip-link" href="#main-content">Skip to content</a>
          <header class="site-header">
            {
              topStrip && (
                <div class="site-topstrip" aria-hidden="true">
                  <span>{topStrip.left}</span>
                  <span>{topStrip.right}</span>
                </div>
              )
            }
            <div class="site-header-inner">
              <a class="brand" href="/">BREAD</a>
              <nav aria-label="Primary">
                <ul>
                  {navLinks.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        aria-current={activeLinkHref === link.href ? 'page' : undefined}
                        class={activeLinkHref === link.href ? 'active' : undefined}
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>
          </header>

          <main id="main-content" class="content-wrap">
            <slot />
          </main>

          <footer class="site-footer">
            <div class="site-footer-inner">
              <p>{footerNote}</p>
              <nav aria-label="Footer">
                <ul>
                  {navLinks.map((link) => (
                    <li><a href={link.href}>{link.label}</a></li>
                  ))}
                </ul>
              </nav>
            </div>
          </footer>
        </div>
      ) : (
        <main>
          <slot />
        </main>
      )
    }
    <script>
      import { enableHapticNavigation } from '../utils/haptics';

      enableHapticNavigation();

      // Share buttons
      document.querySelectorAll('.share-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const platform = e.currentTarget.dataset.platform;
          const container = e.currentTarget.closest('.share-buttons');
          if (!container) return;
          
          const url = new URL(container.dataset.url || window.location.pathname, window.location.origin).toString();
          const title = container.dataset.title || document.title;

          if (platform === 'native') {
            if (navigator.share) {
              try {
                await navigator.share({ title, url });
                return;
              } catch (error) {
                if (error?.name === 'AbortError') return;
              }
            }
            await navigator.clipboard.writeText(url);
            const originalText = e.currentTarget.textContent;
            e.currentTarget.textContent = '✓';
            setTimeout(() => { e.currentTarget.textContent = originalText; }, 2000);
          } else if (platform === 'copy') {
            await navigator.clipboard.writeText(url);
            const originalText = e.currentTarget.textContent;
            e.currentTarget.textContent = '✓';
            setTimeout(() => { e.currentTarget.textContent = originalText; }, 2000);
          } else if (platform === 'twitter') {
            window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`, '_blank');
          }
        });
      });
    </script>
  </body>
</html>

<style>
  :global(h1, h2, h3) {
    line-height: 1.2;
    color: var(--color-text);
  }

  :global(p),
  :global(li) {
    line-height: 1.7;
  }

  :global(a) {
    color: var(--color-accent);
  }

  :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: 1.5rem 0;
  }

  .site-shell {
    min-height: 100vh;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  .skip-link {
    position: absolute;
    left: 0.75rem;
    top: -3rem;
    background: var(--color-surface-raised);
    color: var(--color-text);
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    z-index: 30;
  }

  .skip-link:focus {
    top: 0.75rem;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .site-header-inner {
    width: min(64rem, 100%);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.8rem max(1rem, env(safe-area-inset-right)) 0.8rem max(1rem, env(safe-area-inset-left));
  }

  .site-shell--wide .site-header-inner,
  .site-shell--wide .site-footer-inner {
    width: min(90rem, 100%);
  }

  .site-topstrip {
    width: min(90rem, 100%);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem max(1rem, env(safe-area-inset-right)) 0.4rem max(1rem, env(safe-area-inset-left));
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
  }

  .brand {
    color: var(--color-text);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    padding: 0.2rem 0.4rem;
    margin-left: -0.4rem;
  }

  .brand:hover,
  .brand:focus-visible {
    background: var(--color-surface);
  }

  nav ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.45rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  nav a {
    color: var(--color-text);
    text-decoration: none;
    padding: 0.55rem 0.85rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    touch-action: manipulation;
  }

  nav a:hover,
  nav a:focus-visible,
  nav a.active {
    background: var(--color-surface);
    color: var(--color-accent);
  }

  .content-wrap {
    width: min(52rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: 1.5rem 0 calc(3rem + env(safe-area-inset-bottom));
  }

  .site-footer {
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.9rem;
    padding: 1.2rem max(1rem, env(safe-area-inset-right)) calc(1.6rem + env(safe-area-inset-bottom)) max(1rem, env(safe-area-inset-left));
  }

  .site-footer-inner {
    width: min(64rem, 100%);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer ul {
    list-style: none;
    display: flex;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer a:hover,
  .site-footer a:focus-visible {
    text-decoration: underline;
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .site-header-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.65rem;
    }

    nav {
      width: 100%;
    }

    nav ul {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.4rem;
      width: 100%;
      justify-content: stretch;
    }

    nav li,
    nav a {
      width: 100%;
    }

    nav a {
      justify-content: center;
    }

    .content-wrap {
      width: min(52rem, calc(100% - 1.25rem));
      padding-top: 1.1rem;
    }

    .site-footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .site-footer ul {
      gap: 0.55rem 0.8rem;
    }
  }
</style>
