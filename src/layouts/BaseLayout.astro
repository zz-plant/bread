---
import Logo from "../components/Logo.astro";
import globalStylesUrl from "../styles/global.css?url";
import printStylesUrl from "../styles/print.css?url";
import { toDocumentTitle } from "../utils/content";
import { OG_IMAGE_HEIGHT, OG_IMAGE_WIDTH } from "../utils/og-image-core.mjs";

interface NavLink {
	label: string;
	href: string;
}

interface Props {
	title: string;
	description?: string;
	showSiteFrame?: boolean;
	structuredData?: Record<string, unknown> | Record<string, unknown>[];
	canonical?: string;
	ogImage?: string;
	ogImageAlt?: string;
	noindex?: boolean;
	ogType?: "website" | "article";
	navLinks?: NavLink[];
	footerNavLinks?: NavLink[];
	footerNote?: string;
}

// The BREAD wordmark links home, so the nav only lists the other sections.
const DEFAULT_NAV_LINKS: NavLink[] = [
	{ label: "Archive", href: "/archive/" },
	{ label: "Flyers", href: "/archive/flyers/" },
	{ label: "Radio", href: "/archive/radio-shows/" },
	{ label: "Story", href: "/story/" },
];

// The footer points outward instead of repeating the header nav.
const FOOTER_LINKS: NavLink[] = [
	{ label: "SoundCloud", href: "https://soundcloud.com/breadfm" },
	{ label: "Instagram", href: "https://instagram.com/bread_sf" },
	{ label: "Resident Advisor", href: "https://ra.co/promoters/51043" },
];

const {
	title,
	description = "History, flyers, and radio from BREAD in San Francisco.",
	showSiteFrame = true,
	structuredData,
	canonical,
	ogImage = "/og/og-default.png",
	ogImageAlt,
	noindex = false,
	ogType,
	navLinks = DEFAULT_NAV_LINKS,
	footerNavLinks = FOOTER_LINKS,
	footerNote = "BREAD · San Francisco, 2015–2024",
} = Astro.props;

const structuredDataEntries = (
	Array.isArray(structuredData) ? structuredData : [structuredData]
).filter((entry): entry is Record<string, unknown> => Boolean(entry));

const serializeJsonForScript = (value: Record<string, unknown>) =>
	JSON.stringify(value).replace(/</g, "\\u003c");

const pathname = Astro.url.pathname;
const toAbsoluteUrl = (value: string | undefined): string | undefined => {
	if (!value) return undefined;

	if (value.startsWith("http://") || value.startsWith("https://")) return value;
	if (!Astro.site) return undefined;

	return new URL(
		value.startsWith("/") ? value : `/${value}`,
		Astro.site,
	).toString();
};

const canonicalUrl = canonical
	? toAbsoluteUrl(canonical)
	: toAbsoluteUrl(Astro.url.pathname);
const ogImageUrl = toAbsoluteUrl(ogImage);
const resolvedOgType = ogType ?? "website";
const resolvedOgImageAlt = ogImageAlt ?? `${title} — ${description}`;

const isActiveLink = (href: string): boolean => {
	const path = pathname.replace(/\/+$/, "") || "/";
	const target = href.replace(/\/+$/, "") || "/";
	if (target === "/") return path === "/";
	if (path === target) return true;
	return path.startsWith(`${target}/`);
};

const activeLinkHref = navLinks
	.filter((link) => isActiveLink(link.href))
	.sort((a, b) => b.href.length - a.href.length)[0]?.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,500..900&display=swap" rel="stylesheet" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href={globalStylesUrl} />
    <link rel="stylesheet" href={printStylesUrl} media="print" />
    <title>{toDocumentTitle(title)}</title>

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:site_name" content="BREAD" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={resolvedOgType} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />}
    {ogImageUrl && <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />}
    {ogImageUrl && <meta property="og:image:alt" content={resolvedOgImageAlt} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:image:alt" content={resolvedOgImageAlt} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      structuredDataEntries.map((entry) => (
        <script is:inline type="application/ld+json" set:html={serializeJsonForScript(entry)} />
      ))
    }
  </head>
  <body>
    {
      showSiteFrame ? (
        <div class="site-shell">
          <a class="skip-link" href="#main-content">Skip to content</a>
          <header class="site-header">
            <div class="site-header-inner">
              <a class="brand" href="/" aria-current={pathname === '/' ? 'page' : undefined}>
                <span class="visually-hidden">BREAD</span>
                <Logo />
              </a>
              <nav aria-label="Primary">
                <ul>
                  {navLinks.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        aria-current={activeLinkHref === link.href ? 'page' : undefined}
                        class={activeLinkHref === link.href ? 'active' : undefined}
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>
          </header>

          <main id="main-content" class="content-wrap">
            <slot />
          </main>

          <footer class="site-footer">
            <div class="site-footer-inner">
              <p class="footer-note"><Logo variant="icon" />{footerNote}</p>
              <nav aria-label="BREAD elsewhere">
                <ul>
                  {footerNavLinks.map((link) => {
                    const external = link.href.startsWith('http');
                    return (
                      <li>
                        <a href={link.href} target={external ? '_blank' : undefined} rel={external ? 'noreferrer noopener' : undefined}>
                          {link.label}{external && ' ↗'}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </nav>
            </div>
          </footer>
        </div>
      ) : (
        <main>
          <slot />
        </main>
      )
    }
    <script>
      import { enableHapticNavigation } from '../utils/haptics';

      enableHapticNavigation();
    </script>
  </body>
</html>

<style>
  .site-shell {
    min-height: 100vh;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr auto;
  }

  .skip-link {
    position: absolute;
    left: 0.75rem;
    top: -3rem;
    background: var(--color-surface-raised);
    color: var(--color-text);
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    z-index: 30;
  }

  .skip-link:focus {
    top: 0.75rem;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .site-header-inner,
  .site-footer-inner,
  .content-wrap {
    width: min(var(--page-width), calc(100% - 2 * var(--gutter)));
    margin: 0 auto;
  }

  .site-header-inner {
    min-height: var(--header-height);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  /* The flyers' toast-and-wordmark lockup; its height sets its size. */
  .brand {
    flex: none;
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-text-strong);
    font-size: 1.7rem;
    text-decoration: none;
  }

  .brand:hover {
    opacity: 0.8;
  }

  .site-header nav {
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .site-header nav::-webkit-scrollbar {
    display: none;
  }

  .site-header ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.15rem;
  }

  .site-header nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.7rem;
    color: var(--color-text-secondary);
    font: var(--text-label);
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    touch-action: manipulation;
  }

  .site-header nav a:hover {
    color: var(--color-text);
  }

  .site-header nav a.active {
    color: var(--color-text-strong);
    box-shadow: inset 0 -3px var(--color-accent);
  }

  .content-wrap {
    padding-bottom: calc(var(--space-2xl) + env(safe-area-inset-bottom));
  }

  .site-footer {
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font: var(--text-caption);
    padding: 1.5rem 0 calc(1.75rem + env(safe-area-inset-bottom));
  }

  .site-footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 1.5rem;
    flex-wrap: wrap;
  }

  .site-footer p {
    margin: 0;
  }

  .footer-note {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .footer-note :global(.logo) {
    height: 1.6rem;
    color: var(--color-text-strong);
  }

  .site-footer ul {
    list-style: none;
    display: flex;
    gap: 0.35rem 1.25rem;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .site-footer a {
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .brand {
      font-size: 1.35rem;
    }

    .site-header nav a {
      padding: 0 0.45rem;
      font-size: 0.88rem;
      font-stretch: condensed;
      letter-spacing: 0.03em;
    }

    .site-header-inner {
      gap: 0.5rem;
    }

    .site-header ul {
      margin-right: -0.5rem;
    }
  }
</style>
