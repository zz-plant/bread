---
interface Props {
  title: string;
  description?: string;
  showSiteFrame?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'Bread static site powered by Astro.',
  showSiteFrame = true,
  structuredData,
  canonical,
  ogImage = '/og-default.svg',
  noindex = false,
  ogType
} = Astro.props;

const structuredDataEntries = (Array.isArray(structuredData) ? structuredData : [structuredData]).filter(
  (entry): entry is Record<string, unknown> => Boolean(entry)
);

const serializeJsonForScript = (value: Record<string, unknown>) =>
  JSON.stringify(value).replace(/</g, '\\u003c');

const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const isNarrative = pathname.startsWith('/blog/');
const isArchive = pathname.startsWith('/archive/') && !isNarrative;
const isEditorial = isArchive || isNarrative;
const routeContext = isHome
  ? 'You are here: Home overview'
  : isArchive
    ? 'You are here: Archive records'
    : isNarrative
      ? 'You are here: Story history'
      : undefined;

const toAbsoluteUrl = (value: string | undefined): string | undefined => {
  if (!value) return undefined;

  if (value.startsWith('http://') || value.startsWith('https://')) return value;
  if (!Astro.site) return undefined;

  return new URL(value.startsWith('/') ? value : `/${value}`, Astro.site).toString();
};

const canonicalUrl = canonical ? toAbsoluteUrl(canonical) : toAbsoluteUrl(Astro.url.pathname);
const ogImageUrl = toAbsoluteUrl(ogImage);
const resolvedOgType = ogType ?? (isNarrative ? 'article' : 'website');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:site_name" content="BREAD" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={resolvedOgType} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      structuredDataEntries.map((entry) => (
        <script is:inline type="application/ld+json" set:html={serializeJsonForScript(entry)} />
      ))
    }
  </head>
  <body class={isEditorial ? 'editorial-theme' : undefined}>
    {
      showSiteFrame ? (
        <div class="site-shell">
          <a class="skip-link" href="#main-content">Skip to content</a>
          <header class="site-header">
            <div class="site-header-inner">
              <a class="brand" href="/">BREAD</a>
              <nav aria-label="Primary">
                <ul>
                  <li><a href="/" aria-current={isHome ? 'page' : undefined} class={isHome ? 'active' : undefined}>Home</a></li>
                  <li><a href="/archive/" aria-current={isArchive ? 'page' : undefined} class={isArchive ? 'active' : undefined}>Archive</a></li>
                  <li><a href="/blog/the-story-of-bread/" aria-current={isNarrative ? 'page' : undefined} class={isNarrative ? 'active' : undefined}>Story</a></li>
                </ul>
              </nav>
            </div>
          </header>

          <main id="main-content" class="content-wrap">
            {routeContext && <p class="route-context">{routeContext}</p>}
            <slot />
          </main>

          <footer class="site-footer">
            <div class="site-footer-inner">
              <p>Built with Astro for long-lived archival publishing.</p>
              <nav aria-label="Footer">
                <ul>
                  <li><a href="/">Home</a></li>
                  <li><a href="/archive/">Archive</a></li>
                  <li><a href="/blog/the-story-of-bread/">Story</a></li>
                </ul>
              </nav>
            </div>
          </footer>
        </div>
      ) : (
        <main>
          <slot />
        </main>
      )
    }
  </body>
</html>

<style>
  :root {
    --surface-base: #f8fafc;
    --surface-raised: #ffffff;
    --surface-muted: #e2e8f0;
    --surface-dark-base: #020617;
    --surface-dark-raised: #0b1220;
    --surface-dark-muted: #1f2937;
    --text-base: #111827;
    --text-muted: #475569;
    --text-dark-base: #e5e7eb;
    --text-dark-muted: #94a3b8;
    --accent-link: #0f766e;
    --accent-link-dark: #fb923c;
    --accent-brand: #ff5a1f;
    --radius-pill: 999px;
    --radius-md: 0.5rem;
    color-scheme: light;
    font-family: Inter, system-ui, -apple-system, Segoe UI, sans-serif;
    color: var(--text-base);
    background: var(--surface-base);
  }

  body {
    margin: 0;
    background: linear-gradient(180deg, #fbfcfe 0%, #f8fafc 100%);
    min-height: 100vh;
  }

  body.editorial-theme {
    color-scheme: dark;
    color: var(--text-dark-base);
    background: linear-gradient(180deg, #101725 0%, #020617 100%);
  }

  .site-shell {
    min-height: 100vh;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  .skip-link {
    position: absolute;
    left: 0.75rem;
    top: -3rem;
    background: #0f172a;
    color: #fff;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    z-index: 30;
  }

  .skip-link:focus {
    top: 0.75rem;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    padding: 0.8rem max(1rem, env(safe-area-inset-right)) 0.8rem max(1rem, env(safe-area-inset-left));
    border-bottom: 1px solid #dbe4f5;
    background: rgb(255 255 255 / 94%);
    backdrop-filter: blur(10px);
  }

  body.editorial-theme .site-header {
    border-bottom-color: #1f2937;
    background: rgb(2 6 23 / 92%);
  }

  .site-header-inner {
    width: min(64rem, 100%);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .brand {
    color: #0f172a;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  body.editorial-theme .brand {
    color: #f8fafc;
  }

  nav ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.45rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  nav a {
    color: #1e293b;
    text-decoration: none;
    border-radius: var(--radius-pill);
    padding: 0.55rem 0.85rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    touch-action: manipulation;
  }

  body.editorial-theme nav a {
    color: #cbd5e1;
  }

  nav a:hover,
  nav a:focus-visible,
  nav a.active {
    background: #e2e8f0;
    color: #0f172a;
    font-weight: 600;
  }

  body.editorial-theme nav a:hover,
  body.editorial-theme nav a:focus-visible,
  body.editorial-theme nav a.active {
    background: #1f2937;
    color: #f8fafc;
  }

  .content-wrap {
    width: min(52rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: 1.5rem 0 calc(3rem + env(safe-area-inset-bottom));
  }

  .route-context {
    margin: 0 0 0.8rem;
    display: inline-flex;
    border: 1px solid #cbd5e1;
    border-radius: var(--radius-pill);
    padding: 0.3rem 0.7rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #334155;
    background: #f8fafc;
  }

  body.editorial-theme .route-context {
    border-color: #334155;
    background: #0f172a;
    color: #cbd5e1;
  }

  .site-footer {
    border-top: 1px solid #dbe4f5;
    color: #475569;
    font-size: 0.9rem;
    padding: 1.2rem max(1rem, env(safe-area-inset-right)) calc(1.6rem + env(safe-area-inset-bottom)) max(1rem, env(safe-area-inset-left));
  }

  .site-footer-inner {
    width: min(64rem, 100%);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer ul {
    list-style: none;
    display: flex;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer a:hover,
  .site-footer a:focus-visible {
    text-decoration: underline;
  }

  body.editorial-theme .site-footer {
    border-top-color: #1f2937;
    color: #94a3b8;
  }

  :global(h1, h2, h3) {
    line-height: 1.2;
    color: #0f172a;
  }

  body.editorial-theme :global(h1, h2, h3) {
    color: #f8fafc;
  }

  :global(p),
  :global(li) {
    line-height: 1.7;
  }

  :global(a) {
    color: var(--accent-link);
  }

  body.editorial-theme :global(a) {
    color: var(--accent-link-dark);
  }

  :global(hr) {
    border: 0;
    border-top: 1px solid #dbe4f5;
    margin: 1.5rem 0;
  }

  body.editorial-theme :global(hr) {
    border-top-color: #1f2937;
  }

  @media (max-width: 640px) {
    .site-header-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.65rem;
    }

    nav {
      width: 100%;
    }

    nav ul {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.4rem;
      width: 100%;
      justify-content: stretch;
    }

    nav li,
    nav a {
      width: 100%;
    }

    nav a {
      justify-content: center;
    }

    .content-wrap {
      width: min(52rem, calc(100% - 1.25rem));
      padding-top: 1.1rem;
    }

    .site-footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .site-footer ul {
      gap: 0.55rem 0.8rem;
    }
  }
</style>
