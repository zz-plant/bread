---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, toContentSlug } from '../../utils/content';

export async function getStaticPaths() {
  const pages = await getCollection('archive');

  return pages.map((page) => ({
    params: { slug: toContentSlug(page.id) },
    props: { page }
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <h1>{page.data.title}</h1>
  <p>{page.data.description}</p>
  <p class="route-note">This page is part of the source-first archive. For the narrative chapter view, open <a href="/blog/the-story-of-bread/">Narrative history</a>.</p>
  <small>Last updated: {formatDate(page.data.updated)}</small>
  <hr />
  <Content />
</BaseLayout>


<style>
  .route-note {
    margin: 0.5rem 0 0.35rem;
    color: #cbd5e1;
  }
</style>
