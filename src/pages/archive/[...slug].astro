---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, toContentSlug } from '../../utils/content';
import { includeInArchiveCatchall } from '../../utils/archive';
import { createBreadcrumbListSchema, createCollectionPageSchema } from '../../utils/structuredData';

export async function getStaticPaths() {
  const pages = (await getCollection('archive')).filter((page) => includeInArchiveCatchall(page.slug));

  return pages.map((page) => ({
    params: { slug: toContentSlug(page.id) },
    props: { page }
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const archivePages = (await getCollection('archive'))
  .filter((entry) => includeInArchiveCatchall(entry.slug))
  .sort((a, b) => a.data.order - b.data.order);
const currentIndex = archivePages.findIndex((entry) => entry.id === page.id);
const previousPage = currentIndex > 0 ? archivePages[currentIndex - 1] : undefined;
const nextPage = currentIndex >= 0 && currentIndex < archivePages.length - 1
  ? archivePages[currentIndex + 1]
  : undefined;
const currentSlug = toContentSlug(page.id);

const archivePageStructuredData = createCollectionPageSchema({
  site: Astro.site,
  pathname: Astro.url.pathname,
  name: page.data.title,
  description: page.data.description,
  isPartOf: 'BREAD Archive'
});

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Archive', href: '/archive/' },
  { label: page.data.title }
];

const breadcrumbStructuredData = createBreadcrumbListSchema({
  site: Astro.site,
  items: [
    { name: 'Home', pathname: '/' },
    { name: 'Archive', pathname: '/archive/' },
    { name: page.data.title, pathname: `/archive/${currentSlug}/` }
  ]
});

const structuredDataEntries = [archivePageStructuredData, breadcrumbStructuredData].filter((entry): entry is Record<string, unknown> => Boolean(entry));
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  structuredData={structuredDataEntries}
  ogImage={`/og/archive/${toContentSlug(page.id)}.svg`}
  ogImageAlt={`${page.data.title} — ${page.data.description}`}
>
  <article class="archive-shell">
    <header class="archive-header">
      <p class="section-kicker">Archive section</p>
      <h1>{page.data.title}</h1>
      <p>{page.data.description}</p>
      <p class="section-meta">Last updated {formatDate(page.data.updated)}</p>
      <Breadcrumbs items={breadcrumbItems} />
      <nav class="section-pagination" aria-label="Archive section pagination">
        {previousPage && <a href={`/archive/${toContentSlug(previousPage.id)}/`}>← {previousPage.data.title}</a>}
        {nextPage && <a href={`/archive/${toContentSlug(nextPage.id)}/`}>{nextPage.data.title} →</a>}
      </nav>
    </header>
    <hr />
    <Content />
  </article>
</BaseLayout>


<style>

  .archive-shell {
    border: 1px solid var(--surface-dark-muted);
    border-radius: var(--radius-md);
    background: rgb(15 23 42 / 55%);
    padding: 1rem;
  }

  .archive-header {
    display: grid;
    gap: 0.35rem;
  }

  .section-kicker {
    margin: 0;
    color: #94a3b8;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .section-meta {
    margin: 0.35rem 0 0;
    color: #cbd5e1;
    font-size: 0.82rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .section-pagination {
    margin-top: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .section-pagination a {
    border: 1px solid var(--surface-dark-muted);
    border-radius: 999px;
    padding: 0.45rem 0.8rem;
    color: var(--accent-link-dark);
    text-decoration: none;
    font-size: 0.84rem;
    background: rgb(2 6 23 / 45%);
  }

  .section-pagination a:hover,
  .section-pagination a:focus-visible {
    border-color: #475569;
    text-decoration: underline;
  }
</style>
