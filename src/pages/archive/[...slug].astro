---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, toContentSlug } from '../../utils/content';
import { createCollectionPageSchema } from '../../utils/structuredData';

export async function getStaticPaths() {
  const hiddenSlugs = new Set(['timeline', 'research-methods-confidence']);
  const pages = (await getCollection('archive')).filter((page) => !hiddenSlugs.has(page.slug));

  return pages.map((page) => ({
    params: { slug: toContentSlug(page.id) },
    props: { page }
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const archivePages = (await getCollection('archive'))
  .filter((entry) => entry.slug !== 'timeline')
  .sort((a, b) => a.data.order - b.data.order);
const currentIndex = archivePages.findIndex((entry) => entry.id === page.id);
const previousPage = currentIndex > 0 ? archivePages[currentIndex - 1] : undefined;
const nextPage = currentIndex >= 0 && currentIndex < archivePages.length - 1
  ? archivePages[currentIndex + 1]
  : undefined;

const archivePageStructuredData = createCollectionPageSchema({
  site: Astro.site,
  pathname: Astro.url.pathname,
  name: page.data.title,
  description: page.data.description,
  isPartOf: 'BREAD Archive'
});
---

<BaseLayout title={page.data.title} description={page.data.description} structuredData={archivePageStructuredData}>
  <article class="archive-shell">
    <header class="archive-header">
      <p class="section-kicker">Archive section</p>
      <h1>{page.data.title}</h1>
      <p>{page.data.description}</p>
      <p class="section-meta">Last updated {formatDate(page.data.updated)}</p>
      <nav class="section-links" aria-label="Archive section links">
        <a href="/archive/">Archive index</a>
        {previousPage && <a href={`/archive/${toContentSlug(previousPage.id)}/`}>← {previousPage.data.title}</a>}
        {nextPage && <a href={`/archive/${toContentSlug(nextPage.id)}/`}>{nextPage.data.title} →</a>}
      </nav>
    </header>
    <hr />
    <Content />
  </article>
</BaseLayout>


<style>

  .archive-shell {
    border: 1px solid var(--surface-dark-muted);
    border-radius: var(--radius-md);
    background: rgb(15 23 42 / 55%);
    padding: 1rem;
  }

  .archive-header {
    display: grid;
    gap: 0.35rem;
  }

  .section-kicker {
    margin: 0;
    color: #94a3b8;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .section-meta {
    margin: 0.35rem 0 0;
    color: #cbd5e1;
    font-size: 0.82rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .section-links {
    margin-top: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .section-links a {
    border: 1px solid var(--surface-dark-muted);
    border-radius: 999px;
    padding: 0.45rem 0.8rem;
    color: var(--accent-link-dark);
    text-decoration: none;
    font-size: 0.84rem;
    background: rgb(2 6 23 / 45%);
  }

  .section-links a:hover,
  .section-links a:focus-visible {
    border-color: #475569;
    text-decoration: underline;
  }
</style>
