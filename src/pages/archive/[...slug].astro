---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, toContentSlug } from '../../utils/content';

export async function getStaticPaths() {
  const pages = (await getCollection('archive')).filter((page) => page.slug !== 'timeline');

  return pages.map((page) => ({
    params: { slug: toContentSlug(page.id) },
    props: { page }
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <p class="section-kicker">Archive records</p>
  <h1>{page.data.title}</h1>
  <p>{page.data.description}</p>
  <small class="updated-at">Last updated: {formatDate(page.data.updated)}</small>
  <hr />
  <Content />
</BaseLayout>


<style>
  .section-kicker {
    margin: 0;
    color: #94a3b8;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .updated-at {
    display: inline-block;
    margin-top: 0.35rem;
    color: #cbd5e1;
  }
</style>
