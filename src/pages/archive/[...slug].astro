---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, toContentSlug } from '../../utils/content';

export async function getStaticPaths() {
  const pages = (await getCollection('archive')).filter((page) => page.slug !== 'timeline');

  return pages.map((page) => ({
    params: { slug: toContentSlug(page.id) },
    props: { page }
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <p class="section-kicker">Archive section</p>
  <h1>{page.data.title}</h1>
  <p>{page.data.description}</p>
  <p class="section-meta">Last updated {formatDate(page.data.updated)}</p>
  <hr />
  <Content />
</BaseLayout>


<style>
  .section-kicker {
    margin: 0;
    color: #94a3b8;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .section-meta {
    margin: 0.35rem 0 0;
    color: #cbd5e1;
    font-size: 0.82rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
</style>
