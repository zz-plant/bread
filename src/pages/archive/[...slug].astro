---
import { getCollection, render } from "astro:content";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { includeInArchiveCatchall } from "../../utils/archive";
import { formatDate, toContentSlug } from "../../utils/content";
import {
	createBreadcrumbListSchema,
	createCollectionPageSchema,
} from "../../utils/structuredData";

export async function getStaticPaths() {
	const pages = (await getCollection("archive")).filter((page) =>
		includeInArchiveCatchall(page.id),
	);

	return pages.map((page) => ({
		params: { slug: toContentSlug(page.id) },
		props: { page },
	}));
}

const { page } = Astro.props;
const { Content } = await render(page);
const archivePages = (await getCollection("archive"))
	.filter((entry) => includeInArchiveCatchall(entry.id))
	.sort((a, b) => a.data.order - b.data.order);
const currentIndex = archivePages.findIndex((entry) => entry.id === page.id);
const previousPage =
	currentIndex > 0 ? archivePages[currentIndex - 1] : undefined;
const nextPage =
	currentIndex >= 0 && currentIndex < archivePages.length - 1
		? archivePages[currentIndex + 1]
		: undefined;
const currentSlug = toContentSlug(page.id);

const archivePageStructuredData = createCollectionPageSchema({
	site: Astro.site,
	pathname: Astro.url.pathname,
	name: page.data.title,
	description: page.data.description,
	isPartOf: "BREAD Archive",
});

const breadcrumbItems = [
	{ label: "Home", href: "/" },
	{ label: "Archive", href: "/archive/" },
	{ label: page.data.title },
];

const breadcrumbStructuredData = createBreadcrumbListSchema({
	site: Astro.site,
	items: [
		{ name: "Home", pathname: "/" },
		{ name: "Archive", pathname: "/archive/" },
		{ name: page.data.title, pathname: `/archive/${currentSlug}/` },
	],
});

const structuredDataEntries = [
	archivePageStructuredData,
	breadcrumbStructuredData,
].filter((entry): entry is Record<string, unknown> => Boolean(entry));
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  structuredData={structuredDataEntries}
  ogImage={`/og/archive/${toContentSlug(page.id)}.png`}
  ogImageAlt={`${page.data.title} — ${page.data.description}`}
>
  <article>
    <header class="page-header">
      <Breadcrumbs items={breadcrumbItems} />
      <h1>{page.data.title}</h1>
      <p class="intro">{page.data.description}</p>
      <p class="section-meta">Updated {formatDate(page.data.updated)}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <nav class="pager" aria-label="More archive pages">
      {previousPage && (
        <a class="pager-prev" href={`/archive/${toContentSlug(previousPage.id)}/`}>
          <span>← Previous</span>
          <strong>{previousPage.data.title}</strong>
        </a>
      )}
      {nextPage && (
        <a class="pager-next" href={`/archive/${toContentSlug(nextPage.id)}/`}>
          <span>Next →</span>
          <strong>{nextPage.data.title}</strong>
        </a>
      )}
    </nav>
  </article>
</BaseLayout>
