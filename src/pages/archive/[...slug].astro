---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, toContentSlug } from '../../utils/content';

export async function getStaticPaths() {
  const pages = await getCollection('archive');

  return pages.map((page) => ({
    params: { slug: toContentSlug(page.id) },
    props: { page }
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <p><a href="/archive/">← Back to archive</a></p>
  <h1>{page.data.title}</h1>
  <p>{page.data.description}</p>
  <small>Last updated: {formatDate(page.data.updated)}</small>
  <hr />
  <Content />
</BaseLayout>
