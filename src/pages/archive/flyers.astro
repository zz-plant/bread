---
import { existsSync, readdirSync } from 'node:fs';
import { extname } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import {
  createBreadcrumbListSchema,
  createCollectionPageSchema,
  createItemListSchema
} from '../../utils/structuredData';

interface ParsedFlyerAsset {
  filename: string;
  imagePath: string;
  title: string;
  series: string;
  source: string;
  dateLabel?: string;
  hasYear: boolean;
  dateSort: number;
  assetType: string;
}

interface FlyerFileCandidate {
  filename: string;
  imagePath: string;
  source: 'Main site folder' | 'Imported archive';
}

const supportedImageExtensions = new Set(['.jpg', '.jpeg', '.png', '.webp', '.gif', '.avif']);
const extensionPriority: Record<string, number> = {
  '.webp': 5,
  '.jpg': 4,
  '.jpeg': 4,
  '.png': 3,
  '.avif': 2,
  '.gif': 1
};

const monthDirectory: Record<string, { index: number; label: string }> = {
  jan: { index: 1, label: 'January' },
  january: { index: 1, label: 'January' },
  feb: { index: 2, label: 'February' },
  february: { index: 2, label: 'February' },
  mar: { index: 3, label: 'March' },
  march: { index: 3, label: 'March' },
  apr: { index: 4, label: 'April' },
  april: { index: 4, label: 'April' },
  may: { index: 5, label: 'May' },
  jun: { index: 6, label: 'June' },
  june: { index: 6, label: 'June' },
  jul: { index: 7, label: 'July' },
  july: { index: 7, label: 'July' },
  aug: { index: 8, label: 'August' },
  august: { index: 8, label: 'August' },
  sep: { index: 9, label: 'September' },
  sept: { index: 9, label: 'September' },
  september: { index: 9, label: 'September' },
  oct: { index: 10, label: 'October' },
  october: { index: 10, label: 'October' },
  nov: { index: 11, label: 'November' },
  november: { index: 11, label: 'November' },
  dec: { index: 12, label: 'December' },
  december: { index: 12, label: 'December' }
};

const assetTypeDirectory: Record<string, string> = {
  flyer: 'Flyer',
  poster: 'Poster',
  instagram: 'Instagram',
  story: 'Story'
};

const tokenOverrides: Record<string, string> = {
  dj: 'DJ',
  djs: 'DJs',
  tf1000: 'TF1000',
  shl: 'SHL',
  fb: 'FB',
  ig: 'IG',
  bw: 'B/W',
  yxexaxr: 'YXEXAXR'
};

const toTitleToken = (token: string): string => {
  const normalized = token.toLowerCase();
  if (tokenOverrides[normalized]) return tokenOverrides[normalized];
  if (/^\d+$/.test(token)) return token;
  if (token.length === 1) return token.toUpperCase();

  return token[0].toUpperCase() + token.slice(1).toLowerCase();
};

const toTitle = (tokens: string[]): string => tokens.filter(Boolean).map((token) => toTitleToken(token)).join(' ');

const walkImageDirectory = (
  directory: URL,
  imagePathPrefix: string,
  source: FlyerFileCandidate['source'],
  recursive: boolean
): FlyerFileCandidate[] => {
  const output: FlyerFileCandidate[] = [];
  const entries = readdirSync(directory, { withFileTypes: true });

  for (const entry of entries) {
    if (entry.isDirectory()) {
      if (!recursive) continue;

      const nestedDirectory = new URL(`${entry.name}/`, directory);
      const nestedPrefix = `${imagePathPrefix}${entry.name}/`;
      output.push(...walkImageDirectory(nestedDirectory, nestedPrefix, source, recursive));
      continue;
    }

    if (!entry.isFile()) continue;
    if (entry.name === '_import-manifest.json') continue;

    const extension = extname(entry.name).toLowerCase();
    if (!supportedImageExtensions.has(extension)) continue;

    output.push({
      filename: entry.name,
      imagePath: `${imagePathPrefix}${entry.name}`,
      source
    });
  }

  return output;
};

interface ParsedDateResult {
  label: string;
  sortValue: number;
  consumedTokens: number;
  hasYear: boolean;
}

const parseDateFromTail = (
  tokens: string[]
): ParsedDateResult | undefined => {
  if (tokens.length >= 3) {
    const yearToken = tokens[tokens.length - 3];
    const monthToken = tokens[tokens.length - 2];
    const dayToken = tokens[tokens.length - 1];

    const year = Number.parseInt(yearToken, 10);
    const month = Number.parseInt(monthToken, 10);
    const day = Number.parseInt(dayToken, 10);

    if (
      /^\d{4}$/.test(yearToken) &&
      /^\d{1,2}$/.test(monthToken) &&
      /^\d{1,2}$/.test(dayToken) &&
      !Number.isNaN(year) &&
      !Number.isNaN(month) &&
      !Number.isNaN(day) &&
      month >= 1 &&
      month <= 12 &&
      day >= 1 &&
      day <= 31
    ) {
      const date = new Date(Date.UTC(year, month - 1, day));
      const label = date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

      return {
        label,
        sortValue: year * 10000 + month * 100 + day,
        consumedTokens: 3,
        hasYear: true
      };
    }
  }

  if (tokens.length >= 2) {
    const monthToken = tokens[tokens.length - 2].toLowerCase();
    const dayToken = tokens[tokens.length - 1];
    const month = monthDirectory[monthToken];
    const day = Number.parseInt(dayToken, 10);

    if (month && !Number.isNaN(day) && day >= 1 && day <= 31) {
      return {
        label: `${month.label} ${day}`,
        sortValue: month.index * 100 + day,
        consumedTokens: 2,
        hasYear: false
      };
    }
  }

  return undefined;
};

const parseCompactDate = (basename: string): ParsedDateResult | undefined => {
  const match = basename.match(/(?:^|[^0-9])(\d{2})(\d{2})(\d{2})(?:[^0-9]|$)/);
  if (!match) return undefined;

  const yearShort = Number.parseInt(match[1], 10);
  const month = Number.parseInt(match[2], 10);
  const day = Number.parseInt(match[3], 10);
  if (Number.isNaN(yearShort) || Number.isNaN(month) || Number.isNaN(day)) return undefined;
  if (month < 1 || month > 12 || day < 1 || day > 31) return undefined;

  const year = 2000 + yearShort;
  const date = new Date(Date.UTC(year, month - 1, day));
  const label = date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

  return {
    label,
    sortValue: year * 10000 + month * 100 + day,
    consumedTokens: 0,
    hasYear: true
  };
};

const parseIsoDate = (basename: string): ParsedDateResult | undefined => {
  const match = basename.match(/(20\d{2})[-_](\d{1,2})[-_](\d{1,2})/);
  if (!match) return undefined;

  const year = Number.parseInt(match[1], 10);
  const month = Number.parseInt(match[2], 10);
  const day = Number.parseInt(match[3], 10);
  if (Number.isNaN(year) || Number.isNaN(month) || Number.isNaN(day)) return undefined;
  if (month < 1 || month > 12 || day < 1 || day > 31) return undefined;

  const date = new Date(Date.UTC(year, month - 1, day));
  const label = date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

  return {
    label,
    sortValue: year * 10000 + month * 100 + day,
    consumedTokens: 0,
    hasYear: true
  };
};

const getPreferredFlyerFiles = (): FlyerFileCandidate[] => {
  const publicDirectory = new URL('../../../public/', import.meta.url);
  const driveDirectory = new URL('../../../public/drive/', import.meta.url);
  const driveDirectoryAvailable = existsSync(driveDirectory);
  const candidates = [
    ...walkImageDirectory(publicDirectory, '/', 'Main site folder', false),
    ...(driveDirectoryAvailable ? walkImageDirectory(driveDirectory, '/drive/', 'Imported archive', true) : [])
  ];
  const preferredBySlug = new Map<string, FlyerFileCandidate>();

  for (const candidate of candidates) {
    const extension = extname(candidate.filename).toLowerCase();
    const basename = candidate.filename.slice(0, -extension.length).toLowerCase();
    const isTopLevelFlyer =
      candidate.source === 'Main site folder' && (basename.startsWith('bread-') || basename.startsWith('toasted-trax-'));
    const isDriveFlyer = candidate.source === 'Imported archive';
    if (!isTopLevelFlyer && !isDriveFlyer) continue;

    const current = preferredBySlug.get(basename);
    if (!current) {
      preferredBySlug.set(basename, candidate);
      continue;
    }

    const nextScore = extensionPriority[extension] ?? 0;
    const currentExtension = extname(current.filename).toLowerCase();
    const currentScore = extensionPriority[currentExtension] ?? 0;
    const nextSourceScore = candidate.source === 'Main site folder' ? 2 : 1;
    const currentSourceScore = current.source === 'Main site folder' ? 2 : 1;
    if (nextScore > currentScore || (nextScore === currentScore && nextSourceScore > currentSourceScore)) {
      preferredBySlug.set(basename, candidate);
    }
  }

  return [...preferredBySlug.values()].sort((left, right) => left.filename.localeCompare(right.filename));
};

const parseFlyerAsset = (file: FlyerFileCandidate): ParsedFlyerAsset | undefined => {
  const { filename } = file;
  const extension = extname(filename).toLowerCase();
  const basename = filename.slice(0, -extension.length);
  const normalized = basename.toLowerCase();
  const normalizedForTokens = normalized.replace(/[()]/g, '').replace(/[.\s_]+/g, '-');

  const series =
    normalizedForTokens.startsWith('toasted-trax-') || normalizedForTokens.startsWith('toastedtrax-')
      ? 'Toasted Trax'
      : normalizedForTokens.startsWith('bread')
      ? 'BREAD'
      : file.source === 'Imported archive'
      ? 'Drive archive'
      : 'Archive';

  const body = normalizedForTokens
    .replace(/^bread[-_]*/, '')
    .replace(/^toasted[-_]*trax[-_]*/, '')
    .replace(/^drive[-_]*/, '');
  let tokens = body.split('-').filter(Boolean);
  if (tokens.length === 0) return undefined;

  let assetType = 'Image';
  if (tokens.some((token) => token === 'story')) {
    assetType = 'Story';
  } else if (tokens.some((token) => token === 'ig' || token === 'instagram')) {
    assetType = 'Instagram';
  } else if (tokens.some((token) => token === 'fb' || token === 'facebook')) {
    assetType = 'Facebook';
  } else if (tokens.some((token) => token === 'poster')) {
    assetType = 'Poster';
  } else if (tokens.some((token) => token === 'flyer' || token === 'flier')) {
    assetType = 'Flyer';
  } else {
    const tailToken = tokens[tokens.length - 1];
    if (assetTypeDirectory[tailToken]) {
      assetType = assetTypeDirectory[tailToken];
      tokens = tokens.slice(0, -1);
    }
  }

  const parsedDate = parseDateFromTail(tokens) ?? parseIsoDate(normalizedForTokens) ?? parseCompactDate(normalizedForTokens);
  if (parsedDate) tokens = tokens.slice(0, -parsedDate.consumedTokens);

  const eventCore = toTitle(tokens);
  const title = eventCore ? `${series} ${eventCore}` : series;

  return {
    filename,
    imagePath: file.imagePath,
    title,
    series,
    source: file.source,
    dateLabel: parsedDate?.label,
    hasYear: parsedDate?.hasYear ?? false,
    dateSort: parsedDate?.sortValue ?? 0,
    assetType
  };
};

const flyerAssets = getPreferredFlyerFiles()
  .map((file) => parseFlyerAsset(file))
  .filter((asset): asset is ParsedFlyerAsset => Boolean(asset))
  .sort((left, right) => {
    if (left.hasYear !== right.hasYear) return left.hasYear ? -1 : 1;
    if (left.dateSort !== right.dateSort) return right.dateSort - left.dateSort;
    return left.title.localeCompare(right.title);
  });

const datedAssetCount = flyerAssets.filter((asset) => Boolean(asset.dateLabel)).length;
const seriesCount = new Set(flyerAssets.map((asset) => asset.series)).size;
const importedAssetCount = flyerAssets.filter((asset) => asset.source === 'Imported archive').length;
const topLevelAssetCount = flyerAssets.filter((asset) => asset.source === 'Main site folder').length;

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Archive', href: '/archive/' },
  { label: 'Flyers' }
];

const breadcrumbStructuredData = createBreadcrumbListSchema({
  site: Astro.site,
  items: [
    { name: 'Home', pathname: '/' },
    { name: 'Archive', pathname: '/archive/' },
    { name: 'Flyers', pathname: '/archive/flyers/' }
  ]
});

const pageStructuredData = createCollectionPageSchema({
  site: Astro.site,
  pathname: Astro.url.pathname,
  name: 'BREAD Flyer Gallery',
  description: 'Gallery of BREAD and Toasted Trax flyers and promo images from the main folder and imported archive files.',
  isPartOf: 'BREAD'
});

const imageListStructuredData = createItemListSchema({
  name: 'BREAD Flyer Assets',
  description: 'Flyer cards built from the main image folder and imported archive files.',
  itemListElement: flyerAssets.map((asset, index) => ({
    '@type': 'ImageObject',
    name: asset.dateLabel ? `${asset.title} — ${asset.dateLabel}` : asset.title,
    position: index + 1,
    contentUrl: Astro.site ? new URL(asset.imagePath, Astro.site).toString() : asset.imagePath
  }))
});

const structuredDataEntries = [pageStructuredData, breadcrumbStructuredData, imageListStructuredData].filter(
  (entry): entry is Record<string, unknown> => Boolean(entry)
);

const summaryStats = [
  { label: 'Images', value: flyerAssets.length },
  { label: 'Images with dates', value: datedAssetCount },
  { label: 'Main folder images', value: topLevelAssetCount },
  { label: 'Imported images', value: importedAssetCount },
  { label: 'Series', value: seriesCount }
];
---

<BaseLayout
  title="BREAD Archive: Flyers"
  description="Browse BREAD and Toasted Trax flyers and promo images from the main image folder and imported archive files."
  structuredData={structuredDataEntries}
  ogImageAlt="BREAD flyer and poster image gallery"
>
  <header class="page-header panel">
    <p class="section-kicker">Archive section</p>
    <h1>Flyers</h1>
    <p class="intro">Flyers, posters, and promo images from the main folder and imported archive files.</p>
    <p class="context">Looking for radio episode art? Open <a href="/archive/radio-shows/">Radio shows</a>.</p>
    <Breadcrumbs items={breadcrumbItems} />
  </header>

  <section class="overview-stats" aria-label="Flyer gallery stats">
    {summaryStats.map((item) => (
      <p>
        <span>{item.value}</span>
        <small>{item.label}</small>
      </p>
    ))}
  </section>

  <section class="flyer-grid" aria-label="Flyer image gallery">
    {flyerAssets.map((asset, index) => (
      <article class="flyer-card panel" id={`flyer-${index + 1}`}>
        <img src={asset.imagePath} alt={`${asset.title}${asset.dateLabel ? ` on ${asset.dateLabel}` : ''}`} loading="lazy" decoding="async" />
        <div class="flyer-meta">
          <p class="flyer-title">{asset.title}</p>
          <p class="flyer-subline">{asset.assetType}{asset.dateLabel ? ` · ${asset.dateLabel}` : ''}</p>
          <p class="flyer-source">{asset.source}</p>
          <p class="flyer-file">file: <code>{asset.filename}</code></p>
          <p class="flyer-action"><a href={asset.imagePath} target="_blank" rel="noreferrer noopener">Open full image ↗</a></p>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .panel {
    border: 1px solid var(--surface-dark-muted);
    border-radius: var(--radius-md);
    background: rgb(15 23 42 / 55%);
    padding: 1rem;
  }

  .page-header {
    display: grid;
    gap: 0.45rem;
  }

  .section-kicker {
    margin: 0;
    color: #94a3b8;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .intro,
  .context {
    margin: 0;
    color: #cbd5e1;
  }

  .overview-stats {
    margin: 1rem 0 1.2rem;
    display: grid;
    gap: 0.7rem;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  }

  .overview-stats p {
    margin: 0;
    border: 1px solid var(--surface-dark-muted);
    border-radius: var(--radius-md);
    background: rgb(2 6 23 / 45%);
    padding: 0.75rem 0.85rem;
    display: grid;
    gap: 0.2rem;
  }

  .overview-stats span {
    color: #f8fafc;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .overview-stats small {
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    font-size: 0.64rem;
  }

  .flyer-grid {
    display: grid;
    gap: 0.9rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .flyer-card {
    padding: 0.8rem;
    display: grid;
    gap: 0.75rem;
  }

  .flyer-card img {
    width: 100%;
    height: auto;
    border-radius: 0.45rem;
    border: 1px solid #334155;
    display: block;
    object-fit: cover;
  }

  .flyer-meta {
    display: grid;
    gap: 0.35rem;
  }

  .flyer-title {
    margin: 0;
    color: #f8fafc;
    font-size: 1rem;
    font-weight: 650;
  }

  .flyer-subline {
    margin: 0;
    color: #fdba74;
    font-size: 0.92rem;
  }

  .flyer-file {
    margin: 0;
    color: #94a3b8;
    font-size: 0.78rem;
    overflow-wrap: anywhere;
  }

  .flyer-source {
    margin: 0;
    color: #93c5fd;
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .flyer-file code {
    background: rgb(15 23 42 / 70%);
    border: 1px solid #334155;
    border-radius: 0.35rem;
    padding: 0.08rem 0.28rem;
  }

  .flyer-action {
    margin: 0;
    font-size: 0.86rem;
  }

  .flyer-action a {
    color: var(--accent-link-dark);
    text-decoration: none;
  }

  .flyer-action a:hover,
  .flyer-action a:focus-visible {
    text-decoration: underline;
  }
</style>
