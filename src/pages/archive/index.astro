---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { toContentSlug } from '../../utils/content';
import CardLink from '../../components/CardLink.astro';
import { primaryRoutes } from '../../utils/routes';

const archivePages = (await getCollection('archive')).sort((a, b) => a.data.order - b.data.order);
const overviewStats = [
  { label: 'Archive sections', value: archivePages.length },
  { label: 'Primary routes', value: primaryRoutes.length },
  { label: 'Coverage period', value: '2015—2021' }
];
---

<BaseLayout
  title="BREAD Archive"
  description="An information architecture for a long-living BREAD archive: overview, timeline, people, and venue shifts."
>
  <p class="section-kicker">Archive records</p>
  <h1>BREAD Archive</h1>
  <p class="intro">A durable map of timeline, people, venues, methods, and narrative context.</p>

  <ul class="overview-stats" aria-label="Archive overview stats">
    {
      overviewStats.map((item) => (
        <li>
          <span class="stat-value">{item.value}</span>
          <span class="stat-label">{item.label}</span>
        </li>
      ))
    }
  </ul>

  <ul class="archive-map">
    {
      archivePages.map((page) => (
        <li>
          <p class="section-kicker">Archive section</p>
          <CardLink href={`/archive/${toContentSlug(page.id)}/`} label={`${page.data.title} →`} />
          <p>{page.data.description}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .section-kicker {
    margin: 0;
    color: #94a3b8;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .intro {
    margin-bottom: 1rem;
    color: #cbd5e1;
  }

  .overview-stats,
  .archive-map {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.85rem;
  }

  .overview-stats {
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    margin-bottom: 1rem;
  }

  .overview-stats li,
  .archive-map li {
    border: 1px solid var(--surface-dark-muted);
    background: linear-gradient(180deg, #111827, #0b1220);
    border-radius: var(--radius-md);
    padding: 0.9rem 1rem;
  }

  .stat-value {
    display: block;
    font-size: 1.35rem;
    font-weight: 700;
    color: #f8fafc;
    line-height: 1;
  }

  .stat-label {
    display: block;
    margin-top: 0.35rem;
    color: #94a3b8;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .archive-map li {
    transition: border-color 160ms ease, transform 160ms ease;
  }

  .archive-map li:hover {
    border-color: #334155;
    transform: translateY(-1px);
  }

  .archive-map :global(.card-link) {
    color: var(--accent-link-dark);
    font-weight: 600;
    text-decoration: none;
  }

  .archive-map :global(.card-link:hover),
  .archive-map :global(.card-link:focus-visible) {
    text-decoration: underline;
  }

  .archive-map p {
    margin: 0.45rem 0 0;
    color: #cbd5e1;
  }
</style>
