---
import { getCollection } from "astro:content";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CardLink from "../../components/CardLink.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { includeInArchiveIndex } from "../../utils/archive";
import { formatDate, toContentSlug } from "../../utils/content";
import {
	createBreadcrumbListSchema,
	createCollectionPageSchema,
} from "../../utils/structuredData";

const archivePages = (await getCollection("archive"))
	.filter((page) => includeInArchiveIndex(page.id))
	.sort((a, b) => a.data.order - b.data.order);
const latestArchiveUpdate = archivePages.reduce(
	(latest, page) => (page.data.updated > latest ? page.data.updated : latest),
	archivePages[0]?.data.updated ?? new Date(),
);

const primaryIds = new Set(["overview", "timeline", "people-network"]);
const referenceIds = new Set(["event-ledger"]);
const primaryPages = archivePages.filter((p) => primaryIds.has(p.id));
const referencePages = archivePages.filter((p) => referenceIds.has(p.id));

const visualSections = [
	{
		id: "flyers",
		title: "Flyers",
		description: "Flyers, posters, and promo art for BREAD and Toasted Trax.",
		href: "/archive/flyers/",
	},
	{
		id: "radio-shows",
		title: "Radio Shows",
		description:
			"Cover art for BREAD FM shows, plus links to every BREAD channel.",
		href: "/archive/radio-shows/",
	},
	{
		id: "map",
		title: "Venue Map",
		description: "Where the nights happened, on a map and venue by venue.",
		href: "/archive/map/",
	},
];

const archiveIndexStructuredData = createCollectionPageSchema({
	site: Astro.site,
	pathname: Astro.url.pathname,
	name: "BREAD Archive",
	description:
		"The BREAD archive: timeline, events, people, venues, flyers, and radio.",
	isPartOf: "BREAD",
});

const breadcrumbItems = [{ label: "Home", href: "/" }, { label: "Archive" }];

const breadcrumbStructuredData = createBreadcrumbListSchema({
	site: Astro.site,
	items: [
		{ name: "Home", pathname: "/" },
		{ name: "Archive", pathname: "/archive/" },
	],
});

const structuredDataEntries = [
	archiveIndexStructuredData,
	breadcrumbStructuredData,
].filter((entry): entry is Record<string, unknown> => Boolean(entry));
---

<BaseLayout
  title="BREAD Archive"
  description="The BREAD archive: timeline, events, people, venues, flyers, and radio."
  structuredData={structuredDataEntries}
  ogImage="/og/archive.png"
  ogImageAlt="BREAD archive"
>
  <header class="page-header panel">
    <p class="section-kicker">Archive</p>
    <h1>BREAD Archive</h1>
    <p class="intro">Flyers, lineups, and links from BREAD's run, 2015–2024. For the short version, read <a href="/story/">the story</a>.</p>
    <p class="section-meta">Updated {formatDate(latestArchiveUpdate)}</p>
    <Breadcrumbs items={breadcrumbItems} />
  </header>

  <section class="archive-group" aria-labelledby="primary-heading">
    <h2 id="primary-heading" class="group-heading">History</h2>
    <ul class="archive-map">
      {primaryPages.map((page) => (
        <li class="tile">
          <CardLink href={`/archive/${toContentSlug(page.id)}/`} label={`${page.data.title}`} />
          <p>{page.data.description}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="archive-group" aria-labelledby="visual-heading">
    <h2 id="visual-heading" class="group-heading">Flyers, radio, and venues</h2>
    <ul class="archive-map">
      {visualSections.map((section) => (
        <li class="tile">
          <CardLink href={section.href} label={section.title} />
          <p>{section.description}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="archive-group" aria-labelledby="reference-heading">
    <h2 id="reference-heading" class="group-heading">Reference</h2>
    <ul class="archive-map">
      {referencePages.map((page) => (
        <li class="tile">
          <CardLink href={`/archive/${toContentSlug(page.id)}/`} label={`${page.data.title}`} />
          <p>{page.data.description}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .archive-group {
    margin-top: var(--space-xl);
  }

  .archive-group:first-of-type {
    margin-top: var(--space-lg);
  }

  .group-heading {
    margin: 0 0 var(--space-sm);
    font: var(--text-overline);
    text-transform: uppercase;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.45rem;
  }

  .archive-map {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.65rem;
  }

  .archive-map p {
    margin: 0.35rem 0 0;
    font: var(--text-caption);
    color: var(--color-text-muted);
  }

  .archive-map .section-kicker {
    margin: 0;
    font: var(--text-footnote);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
</style>
