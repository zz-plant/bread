---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate, toContentSlug } from '../../utils/content';
import { includeInArchiveIndex } from '../../utils/archive';
import CardLink from '../../components/CardLink.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { createBreadcrumbListSchema, createCollectionPageSchema } from '../../utils/structuredData';

const archivePages = (await getCollection('archive'))
  .filter((page) => includeInArchiveIndex(page.id))
  .sort((a, b) => a.data.order - b.data.order);
const latestArchiveUpdate = archivePages.reduce((latest, page) =>
  page.data.updated > latest ? page.data.updated : latest,
  archivePages[0]?.data.updated ?? new Date()
);

const archiveIndexStructuredData = createCollectionPageSchema({
  site: Astro.site,
  pathname: Astro.url.pathname,
  name: 'BREAD Archive',
  description: 'Overview page for BREAD archive sections including timeline, venues, and people.',
  isPartOf: 'BREAD'
});

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Archive' }
];

const breadcrumbStructuredData = createBreadcrumbListSchema({
  site: Astro.site,
  items: [
    { name: 'Home', pathname: '/' },
    { name: 'Archive', pathname: '/archive/' }
  ]
});

const structuredDataEntries = [archiveIndexStructuredData, breadcrumbStructuredData].filter((entry): entry is Record<string, unknown> => Boolean(entry));
const archiveRouteCount = archivePages.length + 2;

const overviewStats = [
  { label: 'Archive sections', value: archiveRouteCount },
  { label: 'Page', value: 'Archive home' },
  { label: 'Last updated', value: formatDate(latestArchiveUpdate) }
];
---

<BaseLayout
  title="BREAD Archive"
  description="Browse the BREAD archive: timeline, people, venues, and event notes."
  structuredData={structuredDataEntries}
  ogImage="/og/archive.svg"
  ogImageAlt="BREAD archive home covering eras, venues, people, and events"
>
  <header class="archive-header panel">
    <p class="section-kicker">Archive</p>
    <h1>BREAD Archive</h1>
    <p class="intro">Start with timeline, people, venues, and event notes.</p>
    <p class="context">Want the full background? Read <a href="/story/">Story</a>.</p>
    <Breadcrumbs items={breadcrumbItems} />
  </header>

  <section class="overview-stats" aria-label="Archive overview stats">
    {overviewStats.map((item) => (
      <p>
        <span>{item.value}</span>
        <small>{item.label}</small>
      </p>
    ))}
  </section>

  <ul class="archive-map">
    <li>
      <p class="section-kicker">Archive section</p>
      <CardLink href="/archive/flyers/" label="Flyers →" />
      <p>Browse BREAD and Toasted Trax flyers and posters from the main image folder and imported archive files.</p>
    </li>
    <li>
      <p class="section-kicker">Archive section</p>
      <CardLink href="/archive/radio-shows/" label="Radio shows →" />
      <p>Browse BREAD FM artwork cards with names and dates pulled from each image filename.</p>
    </li>
    {
      archivePages.map((page) => (
        <li>
          <p class="section-kicker">Archive section</p>
          <CardLink href={`/archive/${toContentSlug(page.id)}/`} label={`${page.data.title} →`} />
          <p>{page.data.description}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .archive-header {
    display: grid;
    gap: 0.4rem;
  }

  .panel {
    border: 1px solid var(--surface-dark-muted);
    border-radius: var(--radius-md);
    background: rgb(15 23 42 / 55%);
    padding: 1rem;
  }

  .section-kicker {
    margin: 0;
    color: #94a3b8;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .intro,
  .context {
    margin: 0;
    color: #cbd5e1;
  }

  .overview-stats {
    margin: 1rem 0 1.1rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.7rem;
  }

  .overview-stats p {
    margin: 0;
    border: 1px solid var(--surface-dark-muted);
    border-radius: var(--radius-md);
    background: rgb(2 6 23 / 45%);
    padding: 0.75rem 0.85rem;
    display: grid;
    gap: 0.2rem;
  }

  .overview-stats span {
    color: #f8fafc;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .overview-stats small {
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    font-size: 0.64rem;
  }

  .archive-map {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.85rem;
  }

  .archive-map li {
    border: 1px solid var(--surface-dark-muted);
    background: rgb(15 23 42 / 55%);
    border-radius: var(--radius-md);
    padding: 0.9rem 1rem;
    transition: border-color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
  }

  .archive-map li:hover {
    border-color: #475569;
    transform: translateY(-1px);
    box-shadow: 0 10px 26px rgb(2 6 23 / 35%);
  }

  .archive-map :global(.card-link) {
    color: var(--accent-link-dark);
    font-weight: 600;
    text-decoration: none;
  }

  .archive-map :global(.card-link:hover),
  .archive-map :global(.card-link:focus-visible) {
    text-decoration: underline;
  }

  .archive-map p {
    margin: 0.45rem 0 0;
    color: #cbd5e1;
  }
</style>
