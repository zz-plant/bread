---
import { getCollection } from "astro:content";
import ArchiveLayout from "../../layouts/ArchiveLayout.astro";

const events = (await getCollection("events"))
	.filter((event) => event.data.confidence !== "unverified")
	.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const UNKNOWN_VENUE_LABEL = "Exact venue unknown";

const venueCoordinates: Record<
	string,
	{ lat: number; lng: number; label: string }
> = {
	F8: { lat: 37.7756, lng: -122.4089, label: "1192 Folsom St, SoMa" },
	Codeword: { lat: 37.7786, lng: -122.3929, label: "SoMa" },
	"Underground SF": { lat: 37.7702, lng: -122.445, label: "Lower Haight" },
	"60 6th St": { lat: 37.781, lng: -122.4088, label: "SoMa" },
	"Public Works Loft": { lat: 37.7689, lng: -122.4193, label: "Mission" },
	Mighty: { lat: 37.7671, lng: -122.4064, label: "San Francisco" },
	"Club 6ix": { lat: 37.7852, lng: -122.4089, label: "SoMa" },
	OMG: { lat: 37.7813, lng: -122.4096, label: "SoMa" },
	"SoMa, San Francisco": {
		lat: 37.7785,
		lng: -122.4056,
		label: UNKNOWN_VENUE_LABEL,
	},
	"Mission District, San Francisco": {
		lat: 37.7599,
		lng: -122.4148,
		label: UNKNOWN_VENUE_LABEL,
	},
	"San Francisco": {
		lat: 37.7749,
		lng: -122.4194,
		label: UNKNOWN_VENUE_LABEL,
	},
	Twitch: { lat: 37.7749, lng: -122.4194, label: "Online stream" },
	"Internet Public Radio": {
		lat: 40.7128,
		lng: -74.006,
		label: "Online radio",
	},
	HKCR: { lat: 22.3193, lng: 114.1694, label: "Online radio, Hong Kong" },
};

const venueMap = new Map<
	string,
	{
		venue: string;
		label: string;
		lat: number;
		lng: number;
		count: number;
		years: Set<string>;
		events: { title: string; date: string; id: string }[];
	}
>();

for (const event of events) {
	const coords =
		venueCoordinates[event.data.venue] ?? venueCoordinates["San Francisco"];
	const current = venueMap.get(event.data.venue) ?? {
		venue: event.data.venue,
		label: coords.label,
		lat: coords.lat,
		lng: coords.lng,
		count: 0,
		years: new Set<string>(),
		events: [],
	};
	current.count += 1;
	current.years.add(event.data.year);
	current.events.push({
		title: event.data.title,
		date: event.data.date.toISOString().slice(0, 10),
		id: event.id,
	});
	venueMap.set(event.data.venue, current);
}

const venues = Array.from(venueMap.values())
	.map((venue) => ({ ...venue, years: Array.from(venue.years).sort() }))
	.sort((a, b) => b.count - a.count || a.venue.localeCompare(b.venue));

const breadcrumbItems = [
	{ label: "Home", href: "/" },
	{ label: "Archive", href: "/archive/" },
	{ label: "Venue map" },
];

const stats = [
	{ label: "Venues", value: venues.length },
	{ label: "Events mapped", value: events.length },
];
---

<ArchiveLayout
  title="BREAD Archive: Venue Map"
  description="Where BREAD events happened, from F8 and Underground SF to Twitch and online radio."
  breadcrumbItems={breadcrumbItems}
  stats={stats}
  intro="Where BREAD events happened, venue by venue."
  context='Dates, lineups, and sources for each night are on the <a href="/archive/event-ledger/">Event list</a>.'
  ogImage="/og/archive/map.png"
  ogImageAlt="BREAD venue map"
>
  <section class="map-panel" aria-label="Venue map">
    <div id="venueMap" class="venue-map" data-venues={JSON.stringify(venues)}>
      <p>Map tiles load from OpenStreetMap.</p>
      <button class="map-load" type="button">Load map</button>
    </div>
  </section>

  <section class="venue-list" aria-label="Venue list">
    {venues.map((venue) => (
      <article class="tile venue-card">
        <p class="section-kicker">{venue.label}</p>
        <h2>{venue.venue}</h2>
        <p>{venue.count} event{venue.count === 1 ? '' : 's'} · {venue.years.join(', ')}</p>
        <ul>
          {venue.events.slice(0, 4).map((event) => (
            <li><a href={`/#event-${event.id}`}>{event.date} · {event.title}</a></li>
          ))}
        </ul>
      </article>
    ))}
  </section>

  <section class="venue-phases" aria-labelledby="venue-phases-title">
    <h2 id="venue-phases-title">How the venues changed</h2>
    <p>The pilot and most of the early nights were at F8 on Folsom. From 2017, more nights moved to Underground SF in the Lower Haight. Other rooms that show up in the records: Public Works Loft, Mighty, Bruno's, Codeword, Club 6ix, and OMG.</p>

    <h3>Formats</h3>
    <ul>
      <li><strong>Club nights (2015–2018):</strong> residents plus guests, mostly in SoMa and the Lower Haight.</li>
      <li><strong>Fundraiser streams (2020–2021):</strong> Twitch streams during the pandemic.</li>
      <li><strong>Radio:</strong> BREAD FM's Wednesday show on Radio Valencia, a monthly show on Internet Public Radio from 2022, and a residency on HKCR from 2023.</li>
    </ul>

    <p>When a source doesn't give an exact venue, the event is listed by neighborhood or just as San Francisco.</p>
    <p>See also: <a href="/archive/timeline/">Timeline</a> and <a href="/archive/people-network/">People</a>.</p>
  </section>
</ArchiveLayout>

<script>
  const mapRoot = document.getElementById('venueMap');
  const loadButton = mapRoot?.querySelector('.map-load');

  async function loadMap() {
    if (!mapRoot || mapRoot.dataset.loaded === 'true') return;
    mapRoot.dataset.loaded = 'true';
    const venues = JSON.parse(mapRoot.dataset.venues || '[]');
    const leaflet = await import('leaflet');
    await import('leaflet/dist/leaflet.css');
    mapRoot.replaceChildren();
    const map = leaflet.map(mapRoot).setView([37.7749, -122.4194], 11);
    leaflet.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap contributors',
    }).addTo(map);
    const bounds = [];
    venues.forEach((venue) => {
      const marker = leaflet.marker([venue.lat, venue.lng]).addTo(map);
      const countLabel = `${venue.count} ${venue.count === 1 ? 'event' : 'events'}`;
      marker.bindPopup(`<strong>${venue.venue}</strong><br>${countLabel}<br><a href="/#event-${venue.events[0]?.id}">First event</a>`);
      bounds.push([venue.lat, venue.lng]);
    });
    if (bounds.length) map.fitBounds(bounds, { padding: [24, 24] });
  }

  loadButton?.addEventListener('click', loadMap);
</script>

<style>
  .map-panel {
    margin: var(--space-md) 0;
  }

  .venue-map {
    min-height: min(70vh, 34rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    display: grid;
    place-items: center;
    gap: 0.8rem;
    padding: 1rem;
    overflow: hidden;
  }

  .map-load {
    min-height: 44px;
    border: 1px solid var(--color-accent);
    background: var(--color-bg);
    color: var(--color-text);
    padding: 0.7rem 1rem;
  }

  .venue-list {
    display: grid;
    gap: 0.75rem;
  }

  .venue-card p {
    margin: 0.2rem 0;
  }

  .venue-card .section-kicker,
  .venue-card h2 {
    margin: 0;
  }

  .venue-card ul {
    margin: 0.7rem 0 0;
    padding-left: 1.1rem;
  }

  .venue-phases {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .venue-phases h2 {
    margin: 0 0 var(--space-md);
    font: var(--text-title);
  }

  .venue-phases h3 {
    margin: var(--space-lg) 0 var(--space-sm);
    font: var(--text-subtitle);
    color: var(--color-text);
  }

  .venue-phases h4 {
    margin: var(--space-md) 0 var(--space-xs);
    font: var(--text-body-strong);
    color: var(--color-text);
  }

  .venue-phases p {
    margin: var(--space-xs) 0 var(--space-sm);
    color: var(--color-text-muted);
  }

  .venue-phases ul {
    margin: 0 0 var(--space-md) var(--space-md);
    padding-left: var(--space-lg);
  }

  .venue-phases li {
    margin: var(--space-xs) 0;
    line-height: 1.6;
  }

  .venue-phases strong {
    color: var(--color-text);
  }

  .venue-phases a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .venue-phases a:hover {
    text-decoration: underline;
  }

  @media (max-width: 780px) {
    .venue-map {
      min-height: 65vh;
      border-radius: 1rem;
    }
  }
</style>
