---
import { getCollection } from "astro:content";
import ArchiveLayout from "../../layouts/ArchiveLayout.astro";

const events = (await getCollection("events"))
	.filter((event) => event.data.confidence !== "unverified")
	.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const UNKNOWN_VENUE_LABEL = "Exact venue unknown";

// Venues are grouped by city on the page. The map opens on the Bay Area and
// has a second view for Tokyo, since one view of both would be mostly ocean.
const CITY_ORDER = ["San Francisco", "Oakland", "Tokyo"];
const cityRegion = (city: string) => (city === "Tokyo" ? "Tokyo" : "Bay Area");

// Online venues keep a pin location for the data shape but are left off the map.
const venueCoordinates: Record<
	string,
	{
		lat: number;
		lng: number;
		label: string;
		city?: string;
		online?: boolean;
	}
> = {
	F8: { lat: 37.7756, lng: -122.4089, label: "1192 Folsom St, SoMa" },
	Codeword: { lat: 37.7786, lng: -122.3929, label: "917 Folsom St, SoMa" },
	"Underground SF": {
		lat: 37.7702,
		lng: -122.445,
		label: "424 Haight St, Lower Haight",
	},
	"Public Works Loft": { lat: 37.7689, lng: -122.4193, label: "Mission" },
	Mighty: { lat: 37.7671, lng: -122.4064, label: "San Francisco" },
	"Club 6ix": { lat: 37.781, lng: -122.4088, label: "60 6th St, SoMa" },
	OMG: { lat: 37.7813, lng: -122.4096, label: "SoMa" },
	"Bruno's": { lat: 37.7589, lng: -122.419, label: "2389 Mission St, Mission" },
	"Milk Bar": {
		lat: 37.7693,
		lng: -122.4523,
		label: "1840 Haight St, Upper Haight",
	},
	"SoMa, San Francisco": {
		lat: 37.7785,
		lng: -122.4056,
		label: UNKNOWN_VENUE_LABEL,
	},
	"San Francisco": {
		lat: 37.7749,
		lng: -122.4194,
		label: UNKNOWN_VENUE_LABEL,
	},
	"Slug Bar, Oakland": {
		lat: 37.8053,
		lng: -122.2727,
		label: "Downtown Oakland",
		city: "Oakland",
	},
	"Kagurane Tokyo": {
		lat: 35.7035,
		lng: 139.7345,
		label: "Kagurazaka, Tokyo",
		city: "Tokyo",
	},
	// No address on record; pinned at the city centre like the unknown SF venues.
	"Space Tokyo": {
		lat: 35.6812,
		lng: 139.7671,
		label: "Tokyo",
		city: "Tokyo",
	},
	Twitch: {
		lat: 37.7749,
		lng: -122.4194,
		label: "Online stream",
		online: true,
	},
	"Internet Public Radio": {
		lat: 40.7128,
		lng: -74.006,
		label: "Online radio",
		online: true,
	},
	HKCR: {
		lat: 22.3193,
		lng: 114.1694,
		label: "Online radio, Hong Kong",
		online: true,
	},
};

const venueMap = new Map<
	string,
	{
		venue: string;
		label: string;
		lat: number;
		lng: number;
		city: string;
		online: boolean;
		count: number;
		years: Set<string>;
		events: { title: string; date: string; id: string }[];
	}
>();

for (const event of events) {
	const coords =
		venueCoordinates[event.data.venue] ?? venueCoordinates["San Francisco"];
	const current = venueMap.get(event.data.venue) ?? {
		venue: event.data.venue,
		label: coords.label,
		lat: coords.lat,
		lng: coords.lng,
		city: coords.city ?? "San Francisco",
		online: coords.online ?? false,
		count: 0,
		years: new Set<string>(),
		events: [],
	};
	current.count += 1;
	current.years.add(event.data.year);
	current.events.push({
		title: event.data.title,
		date: event.data.date.toISOString().slice(0, 10),
		id: event.id,
	});
	venueMap.set(event.data.venue, current);
}

const venues = Array.from(venueMap.values())
	.map((venue) => ({ ...venue, years: Array.from(venue.years).sort() }))
	.sort((a, b) => b.count - a.count || a.venue.localeCompare(b.venue));
const inPersonVenues = venues.filter((venue) => !venue.online);
const onlineVenues = venues.filter((venue) => venue.online);
const mapVenues = inPersonVenues.map(
	({ venue, lat, lng, city, count, events }) => ({
		venue,
		lat,
		lng,
		region: cityRegion(city),
		count,
		firstEventId: events[0]?.id,
	}),
);
const mapRegions = Array.from(new Set(mapVenues.map((venue) => venue.region)));
const venueGroups = [
	...CITY_ORDER.map((city) => ({
		id: city.toLowerCase().replace(/\s+/g, "-"),
		title: city,
		items: inPersonVenues.filter((venue) => venue.city === city),
	})),
	{ id: "online", title: "Online", items: onlineVenues },
].filter((group) => group.items.length > 0);

const breadcrumbItems = [
	{ label: "Home", href: "/" },
	{ label: "Archive", href: "/archive/" },
	{ label: "Venue map" },
];

const stats = [
	{ label: "venues", value: inPersonVenues.length },
	{ label: "online", value: onlineVenues.length },
	{ label: "events", value: events.length },
];
---

<ArchiveLayout
  title="BREAD Archive: Venue Map"
  heading="Venue map"
  description="Where BREAD events happened, from F8 and Underground SF to Tokyo, Oakland, Twitch, and online radio."
  breadcrumbItems={breadcrumbItems}
  stats={stats}
  intro="Where BREAD events happened, venue by venue."
  context='Dates, lineups, and sources for each night are on the <a href="/archive/event-ledger/">Event list</a>.'
  ogImage="/og/archive/map.png"
  ogImageAlt="BREAD venue map"
>
  <section class="map-panel" aria-label="Map of venues in San Francisco, Oakland, and Tokyo">
    <div id="venueMap" class="venue-map" data-venues={JSON.stringify(mapVenues)}>
      <div class="map-placeholder">
        <p>Venues in San Francisco, Oakland, and Tokyo on a map. Tiles load from OpenStreetMap.</p>
        <button class="chip map-load" type="button">Load map</button>
      </div>
    </div>
    {mapRegions.length > 1 && (
      <div class="map-views" id="mapViews" role="group" aria-label="Map view" hidden>
        {mapRegions.map((region, index) => (
          <button class="chip" type="button" data-region={region} aria-pressed={index === 0 ? 'true' : 'false'}>{region}</button>
        ))}
      </div>
    )}
  </section>

  {venueGroups.map((group) => (
    <section class="venue-group" aria-labelledby={`venues-${group.id}`}>
      <h2 class="group-heading" id={`venues-${group.id}`}>{group.title}</h2>
      <ul class="venue-list">
        {group.items.map((venue) => (
          <li class="venue-card">
            <p class="section-kicker">{venue.label}</p>
            <h3>{venue.venue}</h3>
            <p class="venue-count">{venue.count} {venue.count === 1 ? 'event' : 'events'} · {venue.years.join(', ')}</p>
            <ul class="venue-events">
              {venue.events.map((event) => (
                <li><a href={`/#event-${event.id}`}><span>{event.date}</span> {event.title}</a></li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="venue-phases prose" aria-labelledby="venue-phases-title">
    <h2 id="venue-phases-title">How the venues changed</h2>
    <p>F8, at 1192 Folsom in SoMa, was the first home: the pilot in February 2015, BREAD #2 and #3, and the one-year anniversary all happened there. In 2016 the nights moved around: Underground SF, Mighty, Public Works Loft, Bruno's, Club 6ix, and Codeword, where the Toasted Trax nights ran.</p>
    <p>From 2017 the base was Underground SF, at 424 Haight in the Lower Haight. The last club night on record, in May 2018, was at OMG.</p>
    <p>After that there was no room for almost five years. The 2021 fundraisers went out on Twitch, and BREAD FM's later shows on Internet Public Radio and HKCR were online too.</p>
    <p>When BREAD played in rooms again, in 2023, it was away from San Francisco: Kagurane and Space Tokyo in March, then Slug Bar in Oakland in April. The last entry is a night in SoMa, announced in March 2024.</p>

    <h3>Formats</h3>
    <ul>
      <li><strong>Club nights (2015–2018):</strong> residents plus guests, mostly in SoMa and the Lower Haight.</li>
      <li><strong>Radio (around 2017):</strong> BREAD FM, Wednesdays from 4 to 6pm on Radio Valencia, while the club nights were still running.</li>
      <li><strong>Fundraiser streams (2021):</strong> three Twitch streams, with DJs playing from several cities.</li>
      <li><strong>Radio (2022–2023):</strong> a monthly show on Internet Public Radio from 2022, then a residency on HKCR from 2023.</li>
      <li><strong>One-off nights (2023–2024):</strong> two in Tokyo, one in Oakland, and one announced for SoMa.</li>
    </ul>

    <p>When a source doesn't give a venue, the event is listed by neighborhood or just as San Francisco. The April 2016 night with Nightsweats is one of those: its flyer says only "top secret location."</p>
    <p>See also: <a href="/archive/timeline/">Timeline</a> and <a href="/archive/people-network/">People</a>.</p>
  </section>
</ArchiveLayout>

<script>
  const mapRoot = document.getElementById('venueMap');
  const loadButton = mapRoot?.querySelector('.map-load');
  const mapViews = document.getElementById('mapViews');

  async function loadMap() {
    if (!mapRoot || mapRoot.dataset.loaded === 'true') return;
    mapRoot.dataset.loaded = 'true';
    mapRoot.classList.add('is-loaded');
    const venues = JSON.parse(mapRoot.dataset.venues || '[]');
    const leaflet = await import('leaflet');
    await import('leaflet/dist/leaflet.css');
    // Leaflet finds its pin images relative to its stylesheet, which a bundled
    // build moves, so hand it the built URLs.
    const [pin, pin2x, pinShadow] = await Promise.all([
      import('leaflet/dist/images/marker-icon.png?url'),
      import('leaflet/dist/images/marker-icon-2x.png?url'),
      import('leaflet/dist/images/marker-shadow.png?url'),
    ]);
    delete leaflet.Icon.Default.prototype._getIconUrl;
    leaflet.Icon.Default.mergeOptions({
      iconUrl: pin.default,
      iconRetinaUrl: pin2x.default,
      shadowUrl: pinShadow.default,
    });
    mapRoot.replaceChildren();
    const map = leaflet.map(mapRoot).setView([37.7749, -122.4194], 11);
    leaflet.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap contributors',
    }).addTo(map);
    const regionBounds = {};
    venues.forEach((venue) => {
      const marker = leaflet.marker([venue.lat, venue.lng]).addTo(map);
      const countLabel = `${venue.count} ${venue.count === 1 ? 'event' : 'events'}`;
      marker.bindPopup(`<strong>${venue.venue}</strong><br>${countLabel}<br><a href="/#event-${venue.firstEventId}">First event</a>`);
      (regionBounds[venue.region] ??= []).push([venue.lat, venue.lng]);
    });

    // One view per region: fitting every pin at once would show mostly ocean.
    const showRegion = (region) => {
      const bounds = regionBounds[region];
      if (!bounds?.length) return;
      map.fitBounds(bounds, { padding: [24, 24], maxZoom: 14 });
      viewButtons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.region === region));
      });
    };
    const viewButtons = Array.from(mapViews?.querySelectorAll('button') ?? []);
    viewButtons.forEach((button) => {
      button.addEventListener('click', () => showRegion(button.dataset.region));
    });
    if (mapViews) mapViews.hidden = false;
    showRegion(venues[0]?.region);
  }

  loadButton?.addEventListener('click', loadMap);
</script>

<style>
  .map-panel {
    margin-bottom: var(--space-xl);
  }

  .venue-map {
    min-height: 14rem;
    display: grid;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background:
      radial-gradient(circle at 30% 40%, var(--color-surface-raised), transparent 60%),
      var(--color-surface);
    overflow: hidden;
  }

  .venue-map.is-loaded {
    min-height: min(65vh, 32rem);
  }

  .map-placeholder {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.9rem;
    padding: 2rem 1rem;
    text-align: center;
  }

  .map-placeholder p {
    margin: 0;
    max-width: 28rem;
    color: var(--color-text-muted);
  }

  .map-views {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .map-views[hidden] {
    display: none;
  }

  .map-views .chip[aria-pressed="true"] {
    border-color: var(--color-text-strong);
    background: var(--color-text-strong);
    color: var(--color-bg);
  }

  .venue-group + .venue-group {
    margin-top: var(--space-xl);
  }

  .venue-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .venue-card {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .venue-card h3 {
    margin: 0;
    font: 700 1.15rem / 1.25 var(--font-body);
  }

  .venue-count {
    margin: 0;
    font: var(--text-caption);
    color: var(--color-text-muted);
  }

  .venue-events {
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .venue-events a {
    display: flex;
    gap: 0.75rem;
    padding: 0.35rem 0;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font: var(--text-caption);
    text-decoration: none;
  }

  .venue-events a:hover {
    color: var(--color-accent-text);
  }

  .venue-events span {
    flex: none;
    font: var(--text-date);
    font-variant-numeric: tabular-nums;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .venue-phases {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .venue-phases h2 {
    margin-top: 0;
  }
</style>
