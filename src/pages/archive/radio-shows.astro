<style>
  .show-grid {
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .show-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    aspect-ratio: 1 / 1;
  }

  .show-card img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    filter: grayscale(0.4);
    transition: filter 700ms ease;
  }

  .show-card:hover img,
  .show-card:focus-within img {
    filter: grayscale(0);
  }

  .show-overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.5rem 0.9rem 0.8rem;
    background: linear-gradient(0deg, rgb(0 0 0 / 92%) 30%, rgb(0 0 0 / 0) 100%);
    transform: translateY(calc(100% - 2.6rem));
    transition: transform 350ms ease;
  }

  .show-card:hover .show-overlay,
  .show-card:focus-within .show-overlay {
    transform: translateY(0);
  }

  .show-title {
    margin: 0;
    font: 600 1rem / 1.15 var(--font-display);
    color: var(--color-text);
  }

  .show-date {
    margin: 0.35rem 0 0;
    font: var(--text-caption);
    color: var(--color-accent-muted);
  }

  .show-action {
    display: inline-block;
    margin-top: 0.5rem;
    font: var(--text-overline);
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
  }

  .show-action:hover,
  .show-action:focus-visible {
    text-decoration: underline;
  }

  .channel-directory {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .channel-directory h2 {
    margin: 0 0 var(--space-md);
    font: var(--text-title);
  }

  .channel-directory h3 {
    margin: var(--space-lg) 0 var(--space-sm);
    font: var(--text-subtitle);
    color: var(--color-text);
  }

  .channel-directory ul,
  .channel-directory ol {
    margin: 0 0 var(--space-md) var(--space-md);
    padding-left: var(--space-lg);
  }

  .channel-directory li {
    margin: var(--space-xs) 0;
    line-height: 1.6;
  }

  .channel-directory a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .channel-directory a:hover {
    text-decoration: underline;
  }

  .channel-directory strong {
    color: var(--color-text);
  }

  .channel-directory p {
    margin: var(--space-sm) 0;
    color: var(--color-text-muted);
  }
</style>

<style>
  @media (hover: none), (max-width: 780px) {
    .show-overlay {
      transform: translateY(0);
    }

    .show-action {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
    }
  }
</style>
