---
import data from "../../data/radio-shows.json";
import ArchiveLayout from "../../layouts/ArchiveLayout.astro";
import { createItemListSchema } from "../../utils/structuredData";

const { radioShows, uniqueGuestCount, monthCount } = data;

const breadcrumbItems = [
	{ label: "Home", href: "/" },
	{ label: "Archive", href: "/archive/" },
	{ label: "Radio shows" },
];

const imageListStructuredData = createItemListSchema({
	name: "BREAD FM Radio Show Artwork",
	description:
		"Radio show cards built from image file names in the public radio folder.",
	itemListElement: radioShows.map((show, index) => ({
		"@type": "ImageObject",
		name: `${show.guests} — ${show.dateLabel}`,
		position: index + 1,
		contentUrl: Astro.site
			? new URL(show.imagePath, Astro.site).toString()
			: show.imagePath,
	})),
});

const summaryStats = [
	{ label: "Shows", value: radioShows.length },
	{ label: "Guest lineups", value: uniqueGuestCount },
	{ label: "Months covered", value: monthCount },
];
---

<ArchiveLayout
  title="BREAD Archive: Radio Shows"
  description="Browse BREAD FM radio show images with lineup names and dates pulled from file names."
  breadcrumbItems={breadcrumbItems}
  stats={summaryStats}
  intro="Radio show images turned into cards with guest names and dates."
  context='Need all channel links? Open <a href="/archive/channel-profile-directory/">Links</a>. Looking for party visuals? Open <a href="/archive/flyers/">Flyers</a>.'
  ogImageAlt="BREAD FM radio show artwork gallery"
>
  <section class="show-grid" aria-label="Radio show artwork gallery">
    {radioShows.map((show, index) => (
      <article class="show-card" id={`show-${index + 1}`}>
        <img src={show.imagePath} alt={`BREAD FM artwork for ${show.guests} on ${show.dateLabel}`} loading="lazy" decoding="async" />
        <div class="show-overlay">
          <p class="show-title">{show.guests}</p>
          <p class="show-date">{show.dateLabel}</p>
          <a href={show.imagePath} target="_blank" rel="noreferrer noopener" class="show-action">Open full image</a>
        </div>
      </article>
    ))}
  </section>
</ArchiveLayout>

<style>
  .page-header {
    display: grid;
    gap: 0.45rem;
  }

  .show-grid {
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .show-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    aspect-ratio: 1 / 1;
  }

  .show-card img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    filter: grayscale(0.4);
    transition: filter 700ms ease;
  }

  .show-card:hover img,
  .show-card:focus-within img {
    filter: grayscale(0);
  }

  .show-overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.5rem 0.9rem 0.8rem;
    background: linear-gradient(0deg, rgb(0 0 0 / 92%) 30%, rgb(0 0 0 / 0) 100%);
    transform: translateY(calc(100% - 2.6rem));
    transition: transform 350ms ease;
  }

  .show-card:hover .show-overlay,
  .show-card:focus-within .show-overlay {
    transform: translateY(0);
  }

  .show-title {
    margin: 0;
    font: 600 1rem / 1.15 var(--font-display);
    color: var(--color-text);
  }

  .show-date {
    margin: 0.35rem 0 0;
    font: var(--text-caption);
    color: #fdba74;
  }

  .show-action {
    display: inline-block;
    margin-top: 0.5rem;
    font: var(--text-overline);
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
  }

  .show-action:hover,
  .show-action:focus-visible {
    text-decoration: underline;
  }
</style>

<style>
  @media (hover: none), (max-width: 780px) {
    .show-overlay {
      transform: translateY(0);
    }

    .show-action {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
    }
  }
</style>
