---
import ResponsiveImage from "../../components/ResponsiveImage.astro";
import data from "../../data/radio-shows.json";
import ArchiveLayout from "../../layouts/ArchiveLayout.astro";
import { GALLERY_IMAGE_SIZES } from "../../utils/images";
import { createItemListSchema } from "../../utils/structuredData";

const { radioShows, uniqueGuestCount, monthCount } = data;

const breadcrumbItems = [
	{ label: "Home", href: "/" },
	{ label: "Archive", href: "/archive/" },
	{ label: "Radio shows" },
];

const imageListStructuredData = createItemListSchema({
	name: "BREAD FM Radio Show Artwork",
	description: "Cover art for BREAD FM radio shows, with guests and dates.",
	itemListElement: radioShows.map((show, index) => ({
		"@type": "ImageObject",
		name: `${show.guests} — ${show.dateLabel}`,
		position: index + 1,
		contentUrl: Astro.site
			? new URL(show.imagePath, Astro.site).toString()
			: show.imagePath,
	})),
});

const summaryStats = [
	{ label: "Shows", value: radioShows.length },
	{ label: "Lineups", value: uniqueGuestCount },
	{ label: "Months covered", value: monthCount },
];
---

<ArchiveLayout
  title="BREAD Archive: Radio Shows"
  heading="Radio shows"
  description="Cover art for BREAD FM radio shows, plus links to BREAD's SoundCloud, Instagram, and residents."
  breadcrumbItems={breadcrumbItems}
  stats={summaryStats}
  intro="Cover art for BREAD FM's Wednesday show on Radio Valencia, with who played and when."
  context='Club night flyers are on the <a href="/archive/flyers/">Flyers</a> page.'
  ogImage="/og/archive/radio-shows.png"
  ogImageAlt="BREAD FM radio show cover art"
>
  <ul class="gallery gallery--square" aria-label="Radio show cover art">
    {radioShows.map((show, index) => (
      <li id={`show-${index + 1}`}>
        <a class="gallery-item" href={show.imagePath} target="_blank" rel="noreferrer noopener">
          <span class="gallery-frame">
            <ResponsiveImage src={show.imagePath} alt={`BREAD FM cover art for ${show.guests}, ${show.dateLabel}`} sizes={GALLERY_IMAGE_SIZES} priority={index === 0} />
          </span>
          <span class="gallery-caption">
            <span class="gallery-title">{show.guests}</span>
            <span class="gallery-meta">{show.dateLabel}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>

  <section class="channel-directory" aria-labelledby="channel-directory-title">
    <h2 id="channel-directory-title">Where to find BREAD</h2>

    <div class="directory-grid">
      <div>
        <h3>BREAD</h3>
        <ul>
          <li><a href="https://soundcloud.com/breadfm" target="_blank" rel="noreferrer noopener">SoundCloud</a> (<a href="https://soundcloud.com/breadfm/tracks" target="_blank" rel="noreferrer noopener">all tracks</a>)</li>
          <li><a href="https://www.internetpublicradio.live/shows/bread-fm" target="_blank" rel="noreferrer noopener">Internet Public Radio show page</a></li>
          <li><a href="https://instagram.com/bread_sf" target="_blank" rel="noreferrer noopener">Instagram: @bread_sf</a></li>
          <li><a href="https://x.com/breadsf" target="_blank" rel="noreferrer noopener">X / Twitter: @breadsf</a></li>
          <li><a href="https://ra.co/promoters/51043" target="_blank" rel="noreferrer noopener">Resident Advisor promoter page</a></li>
          <li><a href="http://www.radiovalencia.fm/" target="_blank" rel="noreferrer noopener">Radio Valencia</a></li>
        </ul>
      </div>
      <div>
        <h3>Radio episodes</h3>
        <ul>
          <li>2023-04-26: <a href="https://soundcloud.com/breadfm/bread-fm-on-internet-public-radio-prawns-botaz-04262023" target="_blank" rel="noreferrer noopener">Prawns &amp; Botaz on IPR</a> (SoundCloud)</li>
          <li>2023-03-29: <a href="https://soundcloud.com/breadfm/bread-fm-on-internet-public-radio-bastiengoat-03292023" target="_blank" rel="noreferrer noopener">bastiengoat on IPR</a> (SoundCloud)</li>
          <li>2022-11-30: <a href="https://podcasts.apple.com/gb/podcast/bread-fm-on-internet-public-radio-exteeng-baowao-11-30-2022/id1227134378?i=1000588387545" target="_blank" rel="noreferrer noopener">Exteeng &amp; Baowao on IPR</a> (Apple Podcasts)</li>
          <li>2022-09-28: <a href="https://www.internetpublicradio.live/episodes/bread-fm-w-botaz-shl-28th-september-2022" target="_blank" rel="noreferrer noopener">Botaz &amp; Shl on IPR</a></li>
        </ul>
      </div>
      <div>
        <h3>Instagram posts</h3>
        <ul>
          <li>2024-03-21: <a href="https://www.instagram.com/p/C4ygjDoynTY/" target="_blank" rel="noreferrer noopener">SF night announced</a></li>
          <li>2023-06-15: <a href="https://www.instagram.com/p/CthThTOpds1/" target="_blank" rel="noreferrer noopener">HKCR residency announced</a></li>
          <li>2023-06-15: <a href="https://www.instagram.com/p/CthVnIVpIgv/" target="_blank" rel="noreferrer noopener">First HKCR episode</a></li>
          <li>2023-03-29: <a href="https://www.instagram.com/p/CqYuOcTyg7v/" target="_blank" rel="noreferrer noopener">IPR monthly episode</a></li>
          <li>2022-07-26: <a href="https://www.instagram.com/p/Cgfdlh4Pdtx/" target="_blank" rel="noreferrer noopener">IPR monthly show announced</a></li>
          <li>2021-03-01: <a href="https://www.instagram.com/p/CL44SfGli4d/" target="_blank" rel="noreferrer noopener">Six Years fundraiser stream announced</a></li>
          <li>2021-01-02: <a href="https://www.instagram.com/p/CJed4dGFKbz/" target="_blank" rel="noreferrer noopener">New Year fundraiser stream announced</a></li>
          <li>2017-09-22: <a href="https://www.instagram.com/p/BZUfch2nGBD/" target="_blank" rel="noreferrer noopener">Underground SF night</a></li>
        </ul>
      </div>
      <div>
        <h3>Collaborators</h3>
        <ul>
          <li><a href="https://surething.info" target="_blank" rel="noreferrer noopener">Sure Thing</a></li>
          <li><a href="https://parameterpresents.com" target="_blank" rel="noreferrer noopener">Parameter</a></li>
          <li><a href="https://www.instagram.com/fakeandgayinc" target="_blank" rel="noreferrer noopener">Nightsweats / Fake and Gay</a></li>
        </ul>
      </div>
      <div>
        <h3>Residents</h3>
        <ul>
          <li><strong>Prawns</strong>: <a href="https://soundcloud.com/prawns" target="_blank" rel="noreferrer noopener">SoundCloud</a> · <a href="https://instagram.com/_prawns" target="_blank" rel="noreferrer noopener">Instagram</a> · <a href="https://ra.co/dj/prawns" target="_blank" rel="noreferrer noopener">RA</a></li>
          <li><strong>Botaz</strong>: <a href="https://soundcloud.com/botaz" target="_blank" rel="noreferrer noopener">SoundCloud</a> · <a href="https://botaz.bandcamp.com/" target="_blank" rel="noreferrer noopener">Bandcamp</a> · <a href="https://instagram.com/brian_aviles" target="_blank" rel="noreferrer noopener">Instagram</a> · <a href="https://ra.co/dj/botaz" target="_blank" rel="noreferrer noopener">RA</a></li>
          <li><strong>TF1000 / Tranespotting</strong>: <a href="https://soundcloud.com/tranespotting" target="_blank" rel="noreferrer noopener">SoundCloud</a> · <a href="https://instagram.com/tf1000_" target="_blank" rel="noreferrer noopener">Instagram</a> · <a href="https://ra.co/dj/tf1000" target="_blank" rel="noreferrer noopener">RA</a></li>
          <li><strong>Adam Kraft</strong>: <a href="https://soundcloud.com/adamkraftneindanke" target="_blank" rel="noreferrer noopener">SoundCloud</a> · <a href="https://instagram.com/adamkraft_" target="_blank" rel="noreferrer noopener">Instagram</a> · <a href="https://ra.co/dj/adamkraft" target="_blank" rel="noreferrer noopener">RA</a></li>
          <li><strong>Gewzer</strong>: <a href="https://soundcloud.com/gewzer" target="_blank" rel="noreferrer noopener">SoundCloud</a> · <a href="https://cyberspa.bandcamp.com/album/g-love-s" target="_blank" rel="noreferrer noopener">Bandcamp</a> · <a href="https://instagram.com/gewzer" target="_blank" rel="noreferrer noopener">Instagram</a></li>
          <li><strong>Exteeng</strong>: <a href="https://soundcloud.com/exteeng" target="_blank" rel="noreferrer noopener">SoundCloud</a> · <a href="https://instagram.com/exteeng" target="_blank" rel="noreferrer noopener">Instagram</a> · <a href="https://ra.co/dj/exteeng" target="_blank" rel="noreferrer noopener">RA</a></li>
          <li><strong>Judy (dhra)</strong>: co-founder</li>
          <li><strong>Misoh</strong>: resident until around 2018</li>
          <li><strong>Shl</strong>: resident from 2021</li>
        </ul>
      </div>
    </div>

    <p>Sources for individual nights are on the <a href="/archive/event-ledger/">Event list</a>.</p>
  </section>
</ArchiveLayout>

<style>
  .channel-directory {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .channel-directory h2 {
    margin: 0 0 var(--space-lg);
    font: var(--text-title);
  }

  .directory-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-lg) var(--space-xl);
  }

  .channel-directory h3 {
    margin: 0 0 var(--space-sm);
    font: var(--text-overline);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .channel-directory ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .channel-directory li {
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--color-border);
    font: var(--text-caption);
    color: var(--color-text-muted);
  }

  .channel-directory a {
    text-decoration: none;
  }

  .channel-directory a:hover {
    text-decoration: underline;
  }

  .channel-directory strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .channel-directory > p {
    margin: var(--space-lg) 0 0;
    color: var(--color-text-muted);
  }
</style>
