---
import { getCollection } from "astro:content";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, toContentSlug } from "../../utils/content";
import {
	createBreadcrumbListSchema,
	createCollectionPageSchema,
} from "../../utils/structuredData";

const timelinePage = (await getCollection("archive")).find(
	(page) => toContentSlug(page.id) === "timeline",
);

if (!timelinePage) {
	throw new Error("Timeline archive entry is missing.");
}

const structuredData = [
	createCollectionPageSchema({
		site: Astro.site,
		pathname: Astro.url.pathname,
		name: timelinePage.data.title,
		description: timelinePage.data.description,
		isPartOf: "BREAD",
	}),
	createBreadcrumbListSchema({
		site: Astro.site,
		items: [
			{ name: "Home", pathname: "/" },
			{ name: "Archive", pathname: "/archive/" },
			{ name: "Timeline", pathname: "/archive/timeline/" },
		],
	}),
].filter((entry): entry is Record<string, unknown> => Boolean(entry));

const eras = [
	{
		range: "2014–2015",
		title: "A pilot at F8",
		summary:
			"Planning in 2014, a pilot in February 2015, then numbered nights.",
		highlights: [
			"BREAD's own profiles date the start to 2014, when the planning began.",
			"The pilot, with Grime City at F8 on February 13, 2015: Nevermind, Helix, and DJ Vague.",
			"BREAD #1 in May with Rushmore and Kid Antoine, then Rabit at #2 in July and Doctor Jeep at #3 in November, all at F8.",
		],
	},
	{
		range: "2016",
		title: "Twelve nights",
		summary:
			"The busiest year on record, across seven rooms and one secret location.",
		highlights: [
			"BREAD #4, on Presidents' Day, is a one-year anniversary day party at F8 with Addison Groove.",
			"Guests included Addison Groove, Jlin, Celestial Trax, Distal, Neana, Deadboy, Murlo, Blackdown, Pinch, Mumdance, Logos, and Rabit.",
			"Shared bills with Nightsweats, Parameter, and Sure Thing.",
			"Toasted Trax, a second party by BREAD, starts at Codeword in June.",
			"BREAD #12 in December gives half its presale proceeds to a relief fund for victims of the Ghost Ship fire.",
		],
	},
	{
		range: "2017–2018",
		title: "Underground SF, and a radio show",
		summary:
			"A regular room in the Lower Haight and a weekly show on Radio Valencia.",
		highlights: [
			"DJ J Heat, Mr. Mitch, Roska, and Kelman Duran play Underground SF in 2017.",
			"BREAD FM starts on Radio Valencia in January 2017 and goes out weekly, on Wednesday afternoons.",
			"The last club night on record is May 12, 2018, at OMG, with Gila, Neana, and London Jade.",
		],
	},
	{
		range: "2021",
		title: "Three fundraiser streams",
		summary: "With the clubs closed, BREAD comes back on Twitch.",
		highlights: [
			"The DJs play from New York, Denver, Atlanta, Oakland, San Francisco, Los Angeles, and Tokyo.",
			"The streams raise money for six groups: National Black Deaf Advocates, the Atlanta Solidarity Fund, DFW Mutual Aid Fund, the Women's Prison Book Project, Rebuilding Alliance, and Oxygen for India.",
			"The New Year stream alone raises $6,360.",
		],
	},
	{
		range: "2022–2024",
		title: "BREAD FM again",
		summary: "A monthly radio show, a residency, and a few nights in rooms.",
		highlights: [
			"BREAD FM returns as a monthly show on Internet Public Radio in July 2022 and takes up a residency on HKCR in June 2023.",
			"Two nights in Tokyo in March 2023 and one at Slug Bar in Oakland that April.",
			"The last entry on record: a night in SoMa, announced in March 2024.",
		],
	},
];

const milestones = [
	{
		date: "2015-02-13",
		venue: "F8, SF",
		label: "Pilot night: BREAD x Grime City",
		sourceLabel: "Facebook event",
		sourceHref: "https://www.facebook.com/events/588841281252200/",
	},
	{
		date: "2016-02-15",
		venue: "F8, SF",
		label: "BREAD #4: one-year anniversary day party, with Addison Groove",
		sourceLabel: "Flyer image",
		sourceHref: "/drive/bread-no-4-v4_cards-3.png",
	},
	{
		date: "2016-03-25",
		venue: "F8, SF",
		label: "BREAD #5 with Jlin",
		sourceLabel: "Flyer image",
		sourceHref: "/bread-5-jlin-planet-mu-iyer-2016-03-25-flyer.jpg",
	},
	{
		date: "2016-06-29",
		venue: "Codeword, SF",
		label: "Toasted Trax #1",
		sourceLabel: "Flyer image",
		sourceHref: "/toasted-trax-number-one-2016-06-29.jpg",
	},
	{
		date: "2016-08-19",
		venue: "F8, SF",
		label: "BREAD #10 / Parameter x BREAD",
		sourceLabel: "Flyer image",
		sourceHref:
			"/bread-number-ten-pinch-rabit-mumdance-logos-caski-ganesa-2016-08-19.png",
	},
	{
		date: "2016-11-19",
		venue: "Club 6ix, SF",
		label: "Sure Thing x BREAD showcase",
		sourceLabel: "Facebook event",
		sourceHref:
			"https://www.facebook.com/events/60-6th-st-san-francisco-ca-94103-1609-united-states/sure-thing-bread-sf-lobster-theremin-showcase/1062894940491694/",
	},
	{
		date: "2017-05-26",
		venue: "Underground SF",
		label: "BREAD SF: Mr. Mitch",
		sourceLabel: "Facebook event",
		sourceHref:
			"https://www.facebook.com/events/d41d8cd9/bread-sf-mr-mitch-planet-mu-kozee-prawns/277151372731142/",
	},
	{
		date: "2017-09-22",
		venue: "Underground SF",
		label: "BREAD SF: Kelman Duran",
		sourceLabel: "Flyer image",
		sourceHref: "/bread-suda-kelman-duran-bread-djs-2017-09-22.png",
	},
	{
		date: "2018-05-12",
		venue: "OMG, SF",
		label: "Last club night on record: Gila, Neana & London Jade",
		sourceLabel: "BREAD mailer",
	},
	{
		date: "2021-01-02",
		venue: "Twitch",
		label: "New Year fundraiser stream",
		sourceLabel: "Instagram post",
		sourceHref: "https://www.instagram.com/p/CJed4dGFKbz/",
	},
	{
		date: "2021-03-13",
		venue: "Twitch",
		label: "Six Years of BREAD fundraiser stream",
		sourceLabel: "Instagram post",
		sourceHref: "https://www.instagram.com/p/CL44SfGli4d/",
	},
	{
		date: "2021-07-10",
		venue: "Twitch",
		label: "Long Bread Summer fundraiser stream",
		sourceLabel: "Flyer image",
		sourceHref: "/bread-long-bread-summer-fundraiser-2021-07-10.jpg",
	},
	{
		date: "2022-07-27",
		venue: "Internet Public Radio",
		label: "BREAD FM launches on IPR",
		sourceLabel: "Instagram post",
		sourceHref: "https://www.instagram.com/p/Cgfdlh4Pdtx/",
	},
	{
		date: "2023-06-15",
		venue: "HKCR",
		label: "BREAD FM joins HKCR",
		sourceLabel: "Instagram post",
		sourceHref: "https://www.instagram.com/p/CthThTOpds1/",
	},
	{
		date: "2024-03-21",
		venue: "SoMa, SF",
		label: "BREAD SF: Nhac Gay, announced",
		sourceLabel: "Instagram post",
		sourceHref: "https://www.instagram.com/p/C4ygjDoynTY/",
	},
];
---

<BaseLayout
  title={timelinePage.data.title}
  description={timelinePage.data.description}
  structuredData={structuredData}
  ogImage="/og/timeline.png"
  ogImageAlt="BREAD timeline, 2015–2024"
>
  <header class="page-header">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Archive", href: "/archive/" }, { label: "Timeline" }]} />
    <h1>{timelinePage.data.title}</h1>
    <p class="intro">{timelinePage.data.description}</p>
    <p class="context">Every event, with sources, is on the <a href="/archive/event-ledger/">Event list</a>.</p>
    <p class="section-meta">Updated {formatDate(timelinePage.data.updated)}</p>
  </header>

  <ol class="eras" aria-label="BREAD eras">
    {
      eras.map((era) => (
        <li class="era">
          <p class="era-range">{era.range}</p>
          <div class="era-body">
            <h2>{era.title}</h2>
            <p class="era-summary">{era.summary}</p>
            <ul>
              {era.highlights.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>

  <section class="key-dates" aria-labelledby="key-dates-title">
    <h2 id="key-dates-title">Key dates</h2>
    <ol>
      {
        milestones.map((milestone) => (
          <li>
            <p class="key-date">{milestone.date}</p>
            <div>
              <p class="key-label">{milestone.label}</p>
              <p class="key-venue">{milestone.venue}</p>
            </div>
            {milestone.sourceHref && (
              <p class="key-source">
                <a
                  href={milestone.sourceHref}
                  target={milestone.sourceHref.startsWith('http') ? '_blank' : undefined}
                  rel={milestone.sourceHref.startsWith('http') ? 'noreferrer noopener' : undefined}
                >
                  {milestone.sourceLabel ?? 'Source'}{milestone.sourceHref.startsWith('http') ? ' ↗' : ''}
                </a>
              </p>
            )}
            {!milestone.sourceHref && milestone.sourceLabel && (
              <p class="key-source">{milestone.sourceLabel}</p>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <section class="see-also" aria-labelledby="see-also-title">
    <h2 class="group-heading" id="see-also-title">See also</h2>
    <ul>
      <li class="tile"><a class="card-link" href="/archive/event-ledger/">Event list</a><p>Every night, with lineups and sources.</p></li>
      <li class="tile"><a class="card-link" href="/archive/map/">Venue map</a><p>Where it all happened.</p></li>
      <li class="tile"><a class="card-link" href="/archive/people-network/">People</a><p>Founders, residents, and collaborators.</p></li>
      <li class="tile"><a class="card-link" href="/story/">The Story of BREAD</a><p>The whole run in one read.</p></li>
    </ul>
  </section>
</BaseLayout>

<style>
  .eras {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .era {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1.5rem;
    padding-bottom: var(--space-xl);
  }

  .era-range {
    margin: 0;
    font: 800 condensed 1.9rem / 0.95 var(--font-display);
    color: var(--color-text-strong);
    font-variant-numeric: tabular-nums;
  }

  .era-body {
    position: relative;
    padding-left: 1.5rem;
    border-left: 1px solid var(--color-border-strong);
  }

  .era-body::before {
    content: '';
    position: absolute;
    left: -0.4rem;
    top: 0.45rem;
    width: 0.7rem;
    height: 0.7rem;
    background: var(--color-text-strong);
  }

  .era-body h2 {
    margin: 0 0 0.35rem;
    font: var(--text-title);
    text-transform: uppercase;
  }

  .era-summary {
    margin: 0 0 0.75rem;
    max-width: 60ch;
    font: var(--text-lede);
    color: var(--color-text-secondary);
  }

  .era-body ul {
    max-width: 62ch;
    margin: 0;
    padding-left: 1.1rem;
    color: var(--color-text-secondary);
  }

  .era-body li + li {
    margin-top: 0.35rem;
  }

  .key-dates,
  .see-also {
    margin-top: var(--space-xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .key-dates h2 {
    margin: 0 0 var(--space-md);
    font: var(--text-title);
    text-transform: uppercase;
  }

  .key-dates ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .key-dates li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.25rem 1.25rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .key-dates p {
    margin: 0;
  }

  .key-date {
    font: var(--text-date);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  .key-label {
    font: var(--text-body-strong);
  }

  .key-venue {
    font: var(--text-caption);
    color: var(--color-text-muted);
  }

  .key-source {
    font: var(--text-footnote);
  }

  .key-source a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .key-source a:hover {
    color: var(--color-accent-text);
    text-decoration: underline;
  }

  .see-also ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 640px) {
    .era {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }

    .key-dates li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
