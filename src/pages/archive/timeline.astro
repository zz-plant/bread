---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const timelinePage = (await getCollection('archive')).find((page) => page.slug === 'timeline');

if (!timelinePage) {
  throw new Error('Timeline archive entry is missing.');
}

const eras = [
  {
    range: '2014–2015',
    title: 'Formation & Pilot',
    summary: 'The project identity takes shape, then quickly moves into recurring public programming in San Francisco.',
    highlights: [
      '2014 project framing appears publicly as "since 2014."',
      '2015-02-13 pilot event at F8 with Helix.',
      '2015-05 onward recurring event cadence appears in SF listings.'
    ]
  },
  {
    range: '2015–2016',
    title: 'Booking Expansion',
    summary: 'Residency structure and visual identity tighten while bookings expand into UK/US crossover club networks.',
    highlights: [
      'Growth phase includes a stronger resident framework and clear flyer language.',
      'A May 29, 2015 listing confirms mid-2015 public programming cadence.',
      '2016 records cluster around Jlin, Distal, Celestial Trax, Deadboy, Murlo, Rabit, Logos, Mumdance, and Pinch-linked context.'
    ]
  },
  {
    range: '2017–2018',
    title: 'UGSF / Bunker Shift',
    summary: 'Programming moves toward Underground SF while the sonic direction widens toward warmer, diasporic rhythmic frameworks.',
    highlights: [
      '2017 timeline markers include Mr. Mitch + Kozee and Kelman Duran period events.',
      'Context from citywide venue shifts appears in event-level records.',
      '2018 tracks as the final core club-night phase in the current archive model.'
    ]
  },
  {
    range: '2020–2023',
    title: 'Remote Mutual Aid + Radio Network',
    summary: 'The archive pivots from in-room events to fundraising streams and distributed radio programming.',
    highlights: [
      '2020–2021 livestream and telethon formats focus on mutual-aid fundraising.',
      'Captured notes align around approximately USD 12K raised across multiple streams.',
      '2022–2023 traces show BREAD FM activity through Internet Public Radio and HKCR.'
    ]
  }
];

const milestones = [
  { date: '2015-02-13', venue: 'F8, SF', label: 'Pilot (Grime City vs BREAD)' },
  { date: '2016-03-25', venue: 'F8 residency context', label: 'BREAD #5 / Jlin window' },
  { date: '2017-09-22', venue: 'Underground SF', label: 'Late UGSF marker' },
  { date: '2018-05-12', venue: 'OMG (noted)', label: 'Final club-night era marker' },
  { date: '2021-01-02', venue: 'Twitch', label: 'New Year fundraiser' },
  { date: '2021-07-10', venue: 'Twitch', label: 'Long Bread Summer fundraiser' }
];
---

<BaseLayout title={timelinePage.data.title} description={timelinePage.data.description}>
  <header class="timeline-hero">
    <p class="eyebrow">Archive section</p>
    <h1>{timelinePage.data.title}</h1>
    <p>{timelinePage.data.description}</p>
    <p class="route-note">Want the full event list? Continue to the <a href="/archive/event-ledger/">Event List (Working)</a>.</p>
    <small>Last updated: {timelinePage.data.updated.toISOString().slice(0, 10)}</small>
  </header>

  <section aria-label="BREAD era timeline" class="timeline-grid">
    {
      eras.map((era) => (
        <article class="era-card">
          <p class="era-range">{era.range}</p>
          <h2>{era.title}</h2>
          <p>{era.summary}</p>
          <ul>
            {era.highlights.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))
    }
  </section>

  <section class="milestones" aria-label="Key dated markers">
    <h2>Key dated markers</h2>
    <ol>
      {
        milestones.map((milestone) => (
          <li>
            <p class="date">{milestone.date}</p>
            <p class="label">{milestone.label}</p>
            <p class="venue">{milestone.venue}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="next-links" aria-label="Related archive material">
    <h2>Where to deepen the timeline</h2>
    <ul>
      <li><a href="/archive/event-ledger/">Event List (Working)</a> for the full event-by-event chronology.</li>
      <li><a href="/archive/venues-format-shifts/">Venues &amp; Format Shifts</a> for place and format transitions.</li>
      <li><a href="/archive/people-network/">People &amp; Network</a> for recurring collaborators and lineup context.</li>
      <li><a href="/archive/research-methods-confidence/">Research Methods</a> for research approach and project notes.</li>
    </ul>
  </section>
</BaseLayout>

<style>
  .timeline-hero p {
    margin: 0.5rem 0;
  }

  .eyebrow {
    margin: 0;
    color: #94a3b8;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .route-note {
    color: #cbd5e1;
  }

  .timeline-grid {
    position: relative;
    margin-top: 1.8rem;
    display: grid;
    gap: 1rem;
  }

  .timeline-grid::before {
    content: '';
    position: absolute;
    left: 0.5rem;
    top: 0.2rem;
    bottom: 0.2rem;
    width: 2px;
    background: linear-gradient(180deg, rgb(249 115 22 / 35%), rgb(51 65 85));
  }

  .era-card {
    position: relative;
    margin-left: 1.5rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--surface-dark-muted);
    background: linear-gradient(180deg, #111827, #0b1220);
    border-radius: var(--radius-md);
  }

  .era-card::before {
    content: '';
    position: absolute;
    left: -1.35rem;
    top: 1.2rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    border: 2px solid #f97316;
    background: #020617;
  }

  .era-card h2 {
    margin: 0.15rem 0 0.3rem;
    font-size: 1.1rem;
  }

  .era-range {
    margin: 0;
    color: #fdba74;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .era-card ul {
    margin: 0.55rem 0 0;
    padding-left: 1.1rem;
  }

  .milestones,
  .next-links {
    margin-top: 2rem;
  }

  .milestones ol {
    list-style: none;
    padding: 0;
    margin: 0.8rem 0 0;
    display: grid;
    gap: 0.65rem;
  }

  .milestones li {
    border: 1px dashed #334155;
    border-radius: var(--radius-md);
    padding: 0.75rem 0.9rem;
    background: rgb(15 23 42 / 55%);
  }

  .date,
  .label,
  .venue {
    margin: 0;
  }

  .date {
    color: #fdba74;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9rem;
  }

  .label {
    margin-top: 0.2rem;
    font-weight: 600;
  }

  .venue {
    color: #94a3b8;
    margin-top: 0.1rem;
    font-size: 0.92rem;
  }

  .next-links ul {
    margin-top: 0.6rem;
  }

  @media (min-width: 48rem) {
    .timeline-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .timeline-grid::before {
      left: 50%;
      transform: translateX(-50%);
    }

    .era-card {
      margin-left: 0;
    }

    .era-card:nth-child(odd) {
      margin-right: 1.3rem;
    }

    .era-card:nth-child(even) {
      margin-left: 1.3rem;
    }

    .era-card::before {
      left: auto;
      right: -1.72rem;
    }

    .era-card:nth-child(even)::before {
      left: -1.72rem;
      right: auto;
    }
  }
</style>
