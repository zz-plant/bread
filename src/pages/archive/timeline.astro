---
import { getCollection } from "astro:content";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, toContentSlug } from "../../utils/content";
import {
	createBreadcrumbListSchema,
	createCollectionPageSchema,
} from "../../utils/structuredData";

const timelinePage = (await getCollection("archive")).find(
	(page) => toContentSlug(page.id) === "timeline",
);

if (!timelinePage) {
	throw new Error("Timeline archive entry is missing.");
}

const structuredData = [
	createCollectionPageSchema({
		site: Astro.site,
		pathname: Astro.url.pathname,
		name: timelinePage.data.title,
		description: timelinePage.data.description,
		isPartOf: "BREAD",
	}),
	createBreadcrumbListSchema({
		site: Astro.site,
		items: [
			{ name: "Home", pathname: "/" },
			{ name: "Archive", pathname: "/archive/" },
			{ name: "Timeline", pathname: "/archive/timeline/" },
		],
	}),
].filter((entry): entry is Record<string, unknown> => Boolean(entry));

const eras = [
	{
		range: "2014–2015",
		title: "Getting started",
		summary: "A pilot at F8, then a regular night in San Francisco.",
		highlights: [
			"BREAD's own profiles date the start to 2014.",
			"Pilot night with Grime City at F8 on February 13, 2015, with Nevermind and Helix.",
			"Numbered BREAD nights start in May 2015.",
		],
	},
	{
		range: "2015–2016",
		title: "Bigger bookings",
		summary: "The residents settle in and the guest list gets bigger.",
		highlights: [
			"Flyers from this stretch show a steady group of residents.",
			"Guests in 2016 included Jlin, Distal, Celestial Trax, Deadboy, Murlo, Rabit, Logos, and Mumdance.",
			"Partner nights with Parameter and Sure Thing, and the Toasted Trax series.",
		],
	},
	{
		range: "2017–2018",
		title: "Underground SF",
		summary: "More nights move to Underground SF in the Lower Haight.",
		highlights: [
			"2017 guests included DJ J Heat, Mr. Mitch, Kozee, Roska, and Kelman Duran.",
			"The regular club nights wind down in 2018.",
		],
	},
	{
		range: "2020–2024",
		title: "Streams and radio",
		summary:
			"Fundraiser streams during the pandemic, then a monthly radio show.",
		highlights: [
			"Twitch streams in 2020 and 2021 raised money for mutual aid groups, including NBDA, Atlanta Solidarity Fund, Rebuilding Alliance, and Oxygen for India.",
			"BREAD FM starts a monthly show on Internet Public Radio in 2022, then a residency on HKCR in 2023.",
			"A BREAD night in SoMa is announced in March 2024.",
		],
	},
];

const milestones = [
	{
		date: "2015-02-13",
		venue: "F8, SF",
		label: "Pilot night: BREAD x Grime City",
		sourceLabel: "Facebook event",
		sourceHref: "https://www.facebook.com/events/588841281252200/",
	},
	{
		date: "2016-03-25",
		venue: "F8, SF",
		label: "BREAD #5 with Jlin",
		sourceLabel: "Flyer image",
		sourceHref: "/bread-5-jlin-planet-mu-iyer-2016-03-25-flyer.jpg",
	},
	{
		date: "2016-06-29",
		venue: "Codeword, SF",
		label: "Toasted Trax #1",
		sourceLabel: "Flyer image",
		sourceHref: "/toasted-trax-number-one-2016-06-29.jpg",
	},
	{
		date: "2016-08-19",
		venue: "F8, SF",
		label: "BREAD #10 / Parameter x BREAD",
		sourceLabel: "Flyer image",
		sourceHref:
			"/bread-number-ten-pinch-rabit-mumdance-logos-caski-ganesa-2016-08-19.png",
	},
	{
		date: "2016-11-19",
		venue: "60 6th St, SF",
		label: "Sure Thing x BREAD showcase",
		sourceLabel: "Facebook event",
		sourceHref:
			"https://www.facebook.com/events/60-6th-st-san-francisco-ca-94103-1609-united-states/sure-thing-bread-sf-lobster-theremin-showcase/1062894940491694/",
	},
	{
		date: "2017-05-26",
		venue: "Underground SF",
		label: "BREAD SF: Mr. Mitch",
		sourceLabel: "Facebook event",
		sourceHref:
			"https://www.facebook.com/events/d41d8cd9/bread-sf-mr-mitch-planet-mu-kozee-prawns/277151372731142/",
	},
	{
		date: "2017-09-22",
		venue: "Underground SF",
		label: "BREAD SF: Kelman Duran",
		sourceLabel: "Flyer image",
		sourceHref: "/bread-suda-kelman-duran-bread-djs-2017-09-22.png",
	},
	{
		date: "2021-01-02",
		venue: "Twitch",
		label: "New Year fundraiser",
		sourceLabel: "Instagram post",
		sourceHref: "https://www.instagram.com/p/CJed4dGFKbz/",
	},
	{
		date: "2021-03-13",
		venue: "Twitch",
		label: "Six Years of BREAD stream",
		sourceLabel: "Instagram post",
		sourceHref: "https://www.instagram.com/p/CL44SfGli4d/",
	},
	{
		date: "2022-07-27",
		venue: "Internet Public Radio",
		label: "BREAD FM launches on IPR",
		sourceLabel: "Instagram post",
		sourceHref: "https://www.instagram.com/p/Cgfdlh4Pdtx/",
	},
	{
		date: "2023-06-15",
		venue: "HKCR",
		label: "BREAD FM joins HKCR",
		sourceLabel: "Instagram post",
		sourceHref: "https://www.instagram.com/p/CthThTOpds1/",
	},
	{
		date: "2024-03-21",
		venue: "SoMa, SF",
		label: "BREAD SF: Nhac Gay",
		sourceLabel: "Instagram post",
		sourceHref: "https://www.instagram.com/p/C4ygjDoynTY/",
	},
];
---

<BaseLayout
  title={timelinePage.data.title}
  description={timelinePage.data.description}
  structuredData={structuredData}
  ogImage="/og/timeline.png"
  ogImageAlt="BREAD timeline, 2015–2024"
>
  <header class="page-header">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Archive", href: "/archive/" }, { label: "Timeline" }]} />
    <h1>{timelinePage.data.title}</h1>
    <p class="intro">{timelinePage.data.description}</p>
    <p class="context">Every event, with sources, is on the <a href="/archive/event-ledger/">Event list</a>.</p>
    <p class="section-meta">Updated {formatDate(timelinePage.data.updated)}</p>
  </header>

  <ol class="eras" aria-label="BREAD eras">
    {
      eras.map((era) => (
        <li class="era">
          <p class="era-range">{era.range}</p>
          <div class="era-body">
            <h2>{era.title}</h2>
            <p class="era-summary">{era.summary}</p>
            <ul>
              {era.highlights.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>

  <section class="key-dates" aria-labelledby="key-dates-title">
    <h2 id="key-dates-title">Key dates</h2>
    <ol>
      {
        milestones.map((milestone) => (
          <li>
            <p class="key-date">{milestone.date}</p>
            <div>
              <p class="key-label">{milestone.label}</p>
              <p class="key-venue">{milestone.venue}</p>
            </div>
            {milestone.sourceHref && (
              <p class="key-source">
                <a
                  href={milestone.sourceHref}
                  target={milestone.sourceHref.startsWith('http') ? '_blank' : undefined}
                  rel={milestone.sourceHref.startsWith('http') ? 'noreferrer noopener' : undefined}
                >
                  {milestone.sourceLabel ?? 'Source'}{milestone.sourceHref.startsWith('http') ? ' ↗' : ''}
                </a>
              </p>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <section class="see-also" aria-labelledby="see-also-title">
    <h2 class="group-heading" id="see-also-title">See also</h2>
    <ul>
      <li class="tile"><a class="card-link" href="/archive/event-ledger/">Event list</a><p>Every night, with lineups and sources.</p></li>
      <li class="tile"><a class="card-link" href="/archive/map/">Venue map</a><p>Where it all happened.</p></li>
      <li class="tile"><a class="card-link" href="/archive/people-network/">People</a><p>Founders, residents, and collaborators.</p></li>
      <li class="tile"><a class="card-link" href="/story/">The Story of BREAD</a><p>The whole run in one read.</p></li>
    </ul>
  </section>
</BaseLayout>

<style>
  .eras {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .era {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1.5rem;
    padding-bottom: var(--space-xl);
  }

  .era-range {
    margin: 0;
    font: 800 condensed 1.9rem / 0.95 var(--font-display);
    color: var(--color-text-strong);
    font-variant-numeric: tabular-nums;
  }

  .era-body {
    position: relative;
    padding-left: 1.5rem;
    border-left: 1px solid var(--color-border-strong);
  }

  .era-body::before {
    content: '';
    position: absolute;
    left: -0.4rem;
    top: 0.45rem;
    width: 0.7rem;
    height: 0.7rem;
    background: var(--color-text-strong);
  }

  .era-body h2 {
    margin: 0 0 0.35rem;
    font: var(--text-title);
    text-transform: uppercase;
  }

  .era-summary {
    margin: 0 0 0.75rem;
    max-width: 60ch;
    font: var(--text-lede);
    color: var(--color-text-secondary);
  }

  .era-body ul {
    max-width: 62ch;
    margin: 0;
    padding-left: 1.1rem;
    color: var(--color-text-secondary);
  }

  .era-body li + li {
    margin-top: 0.35rem;
  }

  .key-dates,
  .see-also {
    margin-top: var(--space-xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .key-dates h2 {
    margin: 0 0 var(--space-md);
    font: var(--text-title);
    text-transform: uppercase;
  }

  .key-dates ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .key-dates li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.25rem 1.25rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .key-dates p {
    margin: 0;
  }

  .key-date {
    font: var(--text-date);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  .key-label {
    font: var(--text-body-strong);
  }

  .key-venue {
    font: var(--text-caption);
    color: var(--color-text-muted);
  }

  .key-source {
    font: var(--text-footnote);
  }

  .key-source a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .key-source a:hover {
    color: var(--color-accent-text);
    text-decoration: underline;
  }

  .see-also ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 640px) {
    .era {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }

    .key-dates li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
