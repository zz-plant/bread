---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, toContentSlug } from '../../utils/content';
import { createArticleSchema, createBreadcrumbListSchema } from '../../utils/structuredData';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return posts
    .filter((post) => toContentSlug(post.id) !== 'the-story-of-bread')
    .map((post) => ({
      params: { slug: toContentSlug(post.id) },
      props: { post }
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const currentSlug = toContentSlug(post.id);
const postStructuredData = createArticleSchema({
  site: Astro.site,
  pathname: Astro.url.pathname,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date,
  dateModified: post.data.date,
  section: 'Journal post',
  siteName: 'BREAD'
});

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Story', href: '/story/' },
  { label: post.data.title }
];

const breadcrumbStructuredData = createBreadcrumbListSchema({
  site: Astro.site,
  items: [
    { name: 'Home', pathname: '/' },
    { name: 'Story', pathname: '/story/' },
    { name: post.data.title, pathname: `/blog/${currentSlug}/` }
  ]
});

const structuredDataEntries = [postStructuredData, breadcrumbStructuredData].filter((entry): entry is Record<string, unknown> => Boolean(entry));
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  structuredData={structuredDataEntries}
  ogImage={`/og/blog/${toContentSlug(post.id)}.svg`}
  ogImageAlt={`${post.data.title} — ${post.data.description}`}
>
  <article class="story-shell">
    <header class="story-header">
      <p class="section-kicker">Journal post</p>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <p class="section-meta">Published {formatDate(post.data.date)}</p>
      <Breadcrumbs items={breadcrumbItems} />
      <nav class="section-links" aria-label="Story links">
        <a href="/story/">Story</a>
        <a href="/archive/">Archive</a>
      </nav>
    </header>
    <hr />
    <Content />
  </article>
</BaseLayout>


<style>
  .story-shell {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    padding: var(--space-md);
  }

  .story-header {
    display: grid;
    gap: 0.35rem;
  }

  .section-meta {
    margin: 0.35rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .section-links {
    margin-top: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .section-links a {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.45rem 0.8rem;
    color: var(--color-accent);
    text-decoration: none;
    font-size: 0.84rem;
    background: var(--color-surface);
  }

  .section-links a:hover,
  .section-links a:focus-visible {
    border-color: var(--color-border-strong);
    text-decoration: underline;
  }
</style>
