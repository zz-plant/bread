---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, toContentSlug } from '../../utils/content';
import { createArticleSchema } from '../../utils/structuredData';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: toContentSlug(post.id) },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const currentIndex = posts.findIndex((entry) => entry.id === post.id);
const newerPost = currentIndex > 0 ? posts[currentIndex - 1] : undefined;
const olderPost = currentIndex >= 0 && currentIndex < posts.length - 1
  ? posts[currentIndex + 1]
  : undefined;

const postStructuredData = createArticleSchema({
  site: Astro.site,
  pathname: Astro.url.pathname,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date,
  dateModified: post.data.date,
  section: 'Story post',
  siteName: 'BREAD'
});
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  structuredData={postStructuredData}
  ogImage={`/og/blog/${toContentSlug(post.id)}.svg`}
  ogImageAlt={`${post.data.title} — ${post.data.description}`}
>
  <article class="story-shell">
    <header class="story-header">
      <p class="section-kicker">Story post</p>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <p class="section-meta">Published {formatDate(post.data.date)}</p>
      <nav class="section-links" aria-label="Story links">
        <a href="/archive/">Archive index</a>
        {newerPost && <a href={`/blog/${toContentSlug(newerPost.id)}/`}>← {newerPost.data.title}</a>}
        {olderPost && <a href={`/blog/${toContentSlug(olderPost.id)}/`}>{olderPost.data.title} →</a>}
      </nav>
    </header>
    <hr />
    <Content />
  </article>
</BaseLayout>


<style>
  .story-shell {
    border: 1px solid var(--surface-dark-muted);
    border-radius: var(--radius-md);
    background: rgb(15 23 42 / 55%);
    padding: 1rem;
  }

  .story-header {
    display: grid;
    gap: 0.35rem;
  }

  .section-kicker {
    margin: 0;
    color: #94a3b8;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .section-meta {
    margin: 0.35rem 0 0;
    color: #cbd5e1;
    font-size: 0.82rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .section-links {
    margin-top: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .section-links a {
    border: 1px solid var(--surface-dark-muted);
    border-radius: 999px;
    padding: 0.45rem 0.8rem;
    color: var(--accent-link-dark);
    text-decoration: none;
    font-size: 0.84rem;
    background: rgb(2 6 23 / 45%);
  }

  .section-links a:hover,
  .section-links a:focus-visible {
    border-color: #475569;
    text-decoration: underline;
  }
</style>
