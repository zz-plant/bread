---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CardLink from '../../components/CardLink.astro';
import { getCollection } from 'astro:content';
import { formatDate, toContentSlug } from '../../utils/content';
import { createCollectionPageSchema } from '../../utils/structuredData';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((post) => ({
    ...post,
    href: `/blog/${toContentSlug(post.id)}/`
  }));

const blogStructuredData = createCollectionPageSchema({
  site: Astro.site,
  pathname: Astro.url.pathname,
  name: 'BREAD Journal',
  description: 'Editorial posts, retrospectives, and updates adjacent to the archive.',
  isPartOf: 'BREAD'
});
---

<BaseLayout
  title="BREAD Journal"
  description="Editorial posts, retrospectives, and updates adjacent to the BREAD archive."
  structuredData={blogStructuredData}
  ogImage="/og/archive.svg"
  ogImageAlt="BREAD Journal entries"
>
  <header class="journal-header panel">
    <p class="section-kicker">Editorial</p>
    <h1>BREAD Journal</h1>
    <p class="intro">Editorial posts and updates, including the narrative history. Use <a href="/archive/">Archive</a> for records.</p>
  </header>

  <ul class="journal-list">
    {posts.map((post) => (
      <li>
        <p class="section-kicker">{formatDate(post.data.date)}</p>
        <CardLink href={post.href} label={`${post.data.title} →`} />
        <p>{post.data.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .panel {
    border: 1px solid var(--surface-dark-muted);
    border-radius: var(--radius-md);
    background: rgb(15 23 42 / 55%);
    padding: 1rem;
  }

  .section-kicker {
    margin: 0;
    color: #94a3b8;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .intro {
    margin: 0;
    color: #cbd5e1;
  }

  .journal-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .journal-list li {
    border: 1px solid var(--surface-dark-muted);
    border-radius: var(--radius-md);
    background: rgb(15 23 42 / 55%);
    padding: 0.9rem 1rem;
  }

  .journal-list p {
    margin: 0.45rem 0 0;
    color: #cbd5e1;
  }

  .journal-list :global(.card-link) {
    color: var(--accent-link-dark);
    font-weight: 600;
    text-decoration: none;
  }

  .journal-list :global(.card-link:hover),
  .journal-list :global(.card-link:focus-visible) {
    text-decoration: underline;
  }
</style>
