---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CardLink from '../../components/CardLink.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { formatDate, toContentSlug } from '../../utils/content';
import { createCollectionPageSchema, createBreadcrumbListSchema } from '../../utils/structuredData';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((post) => {
    const slug = toContentSlug(post.id);

    return {
      ...post,
      href: slug === 'the-story-of-bread' ? '/story/' : `/blog/${slug}/`,
      tags: post.data.tags || []
    };
  });

const allTags = [...new Set(posts.flatMap(p => p.tags))].sort();

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Journal', href: '/blog/' }
];

const breadcrumbStructuredData = createBreadcrumbListSchema({
  site: Astro.site,
  items: [
    { name: 'Home', pathname: '/' },
    { name: 'Journal', pathname: '/blog/' }
  ]
});

const blogStructuredData = createCollectionPageSchema({
  site: Astro.site,
  pathname: Astro.url.pathname,
  name: 'BREAD Journal',
  description: 'Posts, reflections, and updates around the BREAD archive.',
  isPartOf: 'BREAD'
});

const structuredDataEntries = [blogStructuredData, breadcrumbStructuredData].filter((entry): entry is Record<string, unknown> => Boolean(entry));
---

<BaseLayout
  title="BREAD Journal"
  description="Posts, reflections, and updates around the BREAD archive."
  structuredData={structuredDataEntries}
  ogImage="/og/archive.svg"
  ogImageAlt="BREAD Journal and Story entries"
>
  <header class="journal-header panel">
    <p class="section-kicker">Journal</p>
    <h1>BREAD Journal</h1>
    <p class="intro">Posts and updates. Use <a href="/archive/">Archive</a> for event records and <a href="/story/">Story</a> for the full background.</p>
    <Breadcrumbs items={breadcrumbItems} />
  </header>

  {allTags.length > 0 && (
    <div class="tag-filters" aria-label="Filter posts by tag">
      <button class="chip active" data-tag="all">All</button>
      {allTags.map(tag => (
        <button class="chip" data-tag={tag}>{tag}</button>
      ))}
    </div>
  )}

  <ul class="journal-list">
    {posts.map((post) => (
      <li data-tags={post.tags.join(',')}>
        <p class="section-kicker">{formatDate(post.data.date)}</p>
        <CardLink href={post.href} label={`${post.data.title} →`} />
        <p>{post.data.description}</p>
        {post.tags.length > 0 && (
          <div class="post-tags">
            {post.tags.map(tag => <span class="tag">{tag}</span>)}
          </div>
        )}
      </li>
    ))}
  </ul>

  <script>
    const tagFilters = document.querySelectorAll('.tag-filters .chip');
    const posts2 = document.querySelectorAll('.journal-list li');

    tagFilters.forEach(btn => {
      btn.addEventListener('click', () => {
        const tag = btn.getAttribute('data-tag');

        tagFilters.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        posts2.forEach(post => {
          if (tag === 'all') {
            post.style.display = '';
            return;
          }
          const postTags = post.getAttribute('data-tags').split(',');
          post.style.display = postTags.includes(tag) ? '' : 'none';
        });
      });
    });
  </script>
</BaseLayout>

<style>
  .panel {
    border: 1px solid var(--surface-dark-muted);
    border-radius: var(--radius-md);
    background: rgb(15 23 42 / 55%);
    padding: 1rem;
  }

  .section-kicker {
    margin: 0;
    color: #94a3b8;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .intro {
    margin: 0;
    color: #cbd5e1;
  }

  .journal-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .journal-list li {
    border: 1px solid var(--surface-dark-muted);
    border-radius: var(--radius-md);
    background: rgb(15 23 42 / 55%);
    padding: 0.9rem 1rem;
  }

  .journal-list p {
    margin: 0.45rem 0 0;
    color: #cbd5e1;
  }

  .journal-list :global(.card-link) {
    color: var(--accent-link-dark);
    font-weight: 600;
    text-decoration: none;
  }

  .journal-list :global(.card-link:hover),
  .journal-list :global(.card-link:focus-visible) {
    text-decoration: underline;
  }

  .tag-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 1rem 0;
  }

  .tag-filters .chip {
    border: 1px solid var(--surface-dark-muted);
    border-radius: 999px;
    background: rgb(15 23 42 / 55%);
    color: #cbd5e1;
    padding: 0.4rem 0.7rem;
    font-size: 0.78rem;
    cursor: pointer;
    transition: border-color 160ms ease, color 160ms ease;
  }

  .tag-filters .chip.active,
  .tag-filters .chip:hover {
    border-color: var(--accent-link-dark);
    color: #f8fafc;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.4rem;
  }

  .tag {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--surface-dark-muted);
    border-radius: 999px;
    color: #94a3b8;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
