---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CardLink from '../../components/CardLink.astro';
import { getCollection } from 'astro:content';
import { formatDate, toContentSlug } from '../../utils/content';
import { createCollectionPageSchema } from '../../utils/structuredData';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((post) => {
    const slug = toContentSlug(post.id);

    return {
      ...post,
      href: slug === 'the-story-of-bread' ? '/story/' : `/blog/${slug}/`
    };
  });

const blogStructuredData = createCollectionPageSchema({
  site: Astro.site,
  pathname: Astro.url.pathname,
  name: 'BREAD Journal',
  description: 'Posts, reflections, and updates around the BREAD archive.',
  isPartOf: 'BREAD'
});
---

<BaseLayout
  title="BREAD Journal"
  description="Posts, reflections, and updates around the BREAD archive."
  structuredData={blogStructuredData}
  ogImage="/og/archive.svg"
  ogImageAlt="BREAD Journal and Story entries"
>
  <header class="journal-header panel">
    <p class="section-kicker">Journal</p>
    <h1>BREAD Journal</h1>
    <p class="intro">Posts and updates. Use <a href="/archive/">Archive</a> for event records and <a href="/story/">Story</a> for the full background.</p>
  </header>

  <ul class="journal-list">
    {posts.map((post) => (
      <li>
        <p class="section-kicker">{formatDate(post.data.date)}</p>
        <CardLink href={post.href} label={`${post.data.title} →`} />
        <p>{post.data.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .panel {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    padding: var(--space-md);
  }

  .journal-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .journal-list li {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    padding: 0.9rem 1rem;
  }

  .journal-list p {
    margin: 0.45rem 0 0;
    color: var(--color-text-muted);
  }
</style>
