    .shell {
      grid-template-columns: 220px minmax(0, 1fr);
      min-height: calc(100vh - 104px);
    }

    .nav-rail {
      position: static;
      top: auto;
      max-height: none;
    }

    .content,
    .deck {
      max-height: none;
    }

    .deck {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 780px) {
    .topline {
      font-size: 0.62rem;
      flex-wrap: wrap;
    }

    .shell {
      grid-template-columns: 1fr;
      padding: 0.7rem;
      padding-bottom: calc(6rem + env(safe-area-inset-bottom));
      max-width: none;
      min-height: auto;
    }

    .nav-rail,
    .content,
  .deck {
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

    .rail-head,
    .rail-card {
      padding: 0.65rem;
    }

    .deck {
      position: fixed;
      left: 0.7rem;
      right: 0.7rem;
      bottom: calc(0.7rem + env(safe-area-inset-bottom));
      max-height: min(54vh, 28rem);
      margin: 0;
      z-index: 35;
      overflow: auto;
    }

    .deck-toggle {
      display: block;
      width: 100%;
      border: 1px solid #3a3a3a;
      border-radius: 0.7rem;
      background: #0f0f0f;
      color: #f3f3f3;
      padding: 0.65rem 0.8rem;
      text-align: left;
      font-weight: 600;
      margin-bottom: 0.6rem;
      min-height: 44px;
      touch-action: manipulation;
    }

    .deck-content {
      display: none;
    }

    .deck.is-open .deck-content {
      display: grid;
      gap: 0.55rem;
    }

    h2 {
      font-size: 2.2rem;
    }

    .title {
      font-size: 1.02rem;
    }
  }

  @media (hover: none) {
    .tab:hover,
    .card:hover,
    .primary-routes :global(.card-link:hover),
    .route-list :global(.card-link:hover) {
      transform: none;
      box-shadow: none;
    }
  }

  @media (max-width: 600px) {
    .deck {
      left: 0.55rem;
      right: 0.55rem;
      bottom: calc(0.55rem + env(safe-area-inset-bottom));
    }

    .topline {
      gap: 0.35rem;
      font-size: 0.57rem;
      letter-spacing: 0.08em;
      padding-inline: max(0.75rem, env(safe-area-inset-left)) max(0.75rem, env(safe-area-inset-right));
    }

    .topline-nav {
      padding-inline: max(0.75rem, env(safe-area-inset-left)) max(0.75rem, env(safe-area-inset-right));
      gap: 0.3rem;
    }

    .topline-nav a {
      min-height: 34px;
      font-size: 0.72rem;
      padding: 0.28rem 0.52rem;
    }

    .shell {
      padding: 0.55rem;
      padding-bottom: calc(5.6rem + env(safe-area-inset-bottom));
      gap: 0.6rem;
    }

    .nav-rail,
    .content,
    .deck {
      padding: 0.8rem;
    }

  .tab {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 0.45rem 0.75rem;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 500;
    font-size: 0.76rem;
    letter-spacing: 0.07em;
    cursor: pointer;
    text-align: center;
    line-height: 1.1;
    text-transform: uppercase;
    min-height: 44px;
    touch-action: manipulation;
    color: var(--color-text-muted);
  }

  .tab.active {
    color: var(--color-text);
    border-color: var(--color-accent);
  }

  .tab:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }

  .tab.active {
    border-bottom: 2px solid var(--color-accent);
  }

    .card {
      padding: 0.75rem;
    }

    .featured-visual-grid {
      grid-template-columns: 1fr;
    }

    .pick-btn {
      gap: 0.55rem;
    }

    .meta,
    .status {
      font-size: 0.74rem;
    }

    .home-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.45rem;
      padding: 0.7rem 0.75rem calc(0.8rem + env(safe-area-inset-bottom));
    }
  }

  @media (max-width: 760px) {
    .topline {
      font-size: 0.6rem;
      letter-spacing: 0.1em;
      padding-bottom: 0.35rem;
    }

    .topline-nav {
      width: 100%;
      gap: 0.35rem;
      padding-top: 0.3rem;
      padding-bottom: 0.5rem;
    }

    .topline-nav a {
      white-space: nowrap;
      min-height: 36px;
      font-size: 0.74rem;
      padding: 0.32rem 0.6rem;
    }

    .home-footer {
      width: calc(100% - 1.1rem);
      margin-bottom: 0.55rem;
    }
  }

  @media (max-width: 360px) {
    .home-footer nav {
      width: 100%;
      justify-content: space-between;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

</style>

<script is:inline define:vars={{ documentedChronology, roster }}>
  const tabs = Array.from(document.querySelectorAll('.tab'));
  const panels = document.querySelectorAll('.panel');

  const deckTag = document.getElementById('deckTag');
  const deckTitle = document.getElementById('deckTitle');
  const deckData = document.getElementById('deckData');
  const deckDesc = document.getElementById('deckDesc');
  const deckLinks = document.getElementById('deckLinks');
  const detailDeck = document.getElementById('detailDeck');
  const deckToggle = document.getElementById('deckToggle');
  const deckStateStorageKey = 'bread:detailDeckOpen';

  // Event filtering
  const eventSearch = document.getElementById('eventSearch');
  const yearFilters = document.getElementById('yearFilters');
  const venueFilters = document.getElementById('venueFilters');
  const eventCards = Array.from(document.querySelectorAll('.cards .card[data-kind="event"]'));
  const resultCount = document.getElementById('eventsResultCount');

  // Extract unique years and venues
  const years = [...new Set(documentedChronology.map(e => e.year))].sort();
  const venues = [...new Set(documentedChronology.map(e => e.venue))].sort();

  // Create filter chips
  function createChips(container, items, filterType) {
    if (!container) return;
    const allChip = document.createElement('button');
    allChip.className = 'chip active';
    allChip.textContent = 'All';
    allChip.setAttribute('data-filter', 'all');
    allChip.setAttribute('data-type', filterType);
    container.appendChild(allChip);

    items.forEach(item => {
      const chip = document.createElement('button');
      chip.className = 'chip';
      chip.textContent = item;
      chip.setAttribute('data-filter', item);
      chip.setAttribute('data-type', filterType);
      container.appendChild(chip);
    });
  }

  function initImageLoading() {
    const images = Array.from(document.querySelectorAll('.featured-visual-grid img'));
    
    images.forEach(img => {
      img.classList.add('is-loading');
      
      const loadHandler = () => {
        img.classList.add('loaded');
        img.classList.remove('is-loading');
      };
      
      img.addEventListener('load', loadHandler);
      img.addEventListener('error', () => {
        img.classList.remove('is-loading');
        img.style.display = 'none';
      });
      
      if (img.complete) {
        loadHandler();
      }
    });
  }

  createChips(yearFilters, years, 'year');
  createChips(venueFilters, venues, 'venue');
  initImageLoading();

  let activeFilters = { year: 'all', venue: 'all', search: '' };
  const EVENTS_PER_PAGE = 20;
  let visibleEvents = [];

  function filterEvents() {
    const searchTerm = activeFilters.search.toLowerCase();
    visibleEvents = [];

    eventCards.forEach(card => {
      const year = card.getAttribute('data-year');
      const venue = card.getAttribute('data-venue');
      const lineup = card.getAttribute('data-lineup').toLowerCase();
      const title = card.querySelector('.title')?.textContent.toLowerCase() || '';

      const matchesSearch = !searchTerm ||
        title.includes(searchTerm) ||
        venue.toLowerCase().includes(searchTerm) ||
        lineup.includes(searchTerm);

      const matchesYear = activeFilters.year === 'all' || year === activeFilters.year;
      const matchesVenue = activeFilters.venue === 'all' || venue === activeFilters.venue;

      const isVisible = matchesSearch && matchesYear && matchesVenue;
      card.style.display = 'none';
      if (isVisible) visibleEvents.push(card);
    });

    showEventsPage(1);

    const loadMoreBtn = document.getElementById('loadMoreEvents');
    if (loadMoreBtn) {
      loadMoreBtn.style.display = visibleEvents.length > EVENTS_PER_PAGE ? '' : 'none';
    }
  }

  let currentPage = 1;

  function showEventsPage(page) {
    currentPage = page;
    const start = 0;
    const end = page * EVENTS_PER_PAGE;

    visibleEvents.forEach((card, index) => {
      card.style.display = index >= start && index < end ? '' : 'none';
    });

    if (resultCount) {
      resultCount.textContent = `${visibleEvents.length} events shown (showing ${Math.min(end, visibleEvents.length)} of ${visibleEvents.length})`;
    }

    const loadMoreBtn = document.getElementById('loadMoreEvents');
    if (loadMoreBtn) {
      loadMoreBtn.style.display = end >= visibleEvents.length ? 'none' : '';
      loadMoreBtn.textContent = `Load more (${visibleEvents.length - end} remaining)`;
    }
  }

  const loadMoreBtn = document.getElementById('loadMoreEvents');
  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', () => {
      showEventsPage(currentPage + 1);
    });
  }

  if (eventSearch) {
    eventSearch.addEventListener('input', (e) => {
      activeFilters.search = e.target.value;
      filterEvents();
    });
  }

  [yearFilters, venueFilters].forEach(container => {
    if (!container) return;
    container.addEventListener('click', (e) => {
      const chip = e.target.closest('.chip');
      if (!chip) return;

      const type = chip.getAttribute('data-type');
      const filter = chip.getAttribute('data-filter');

      container.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
      chip.classList.add('active');

      activeFilters[type] = filter;
      filterEvents();
    });
  });

  function triggerHaptic(pattern = 10) {
    if (!('vibrate' in navigator)) return;
    navigator.vibrate(pattern);
  }

  function setDeckOpenState(isOpen, { persist = true } = {}) {
    if (!detailDeck || !deckToggle) return;

    detailDeck.classList.toggle('is-open', isOpen);
    deckToggle.setAttribute('aria-expanded', String(isOpen));
    deckToggle.textContent = isOpen ? 'Hide info' : 'Show info';

    if (!persist) return;
    try {
      window.localStorage.setItem(deckStateStorageKey, String(isOpen));
    } catch {
      // Ignore storage access restrictions.
    }
  }

  function hydrateDeckState() {
    if (!detailDeck || !deckToggle) return;

    let storedPreference = null;
    try {
      storedPreference = window.localStorage.getItem(deckStateStorageKey);
    } catch {
      storedPreference = null;
    }

    const shouldOpenByDefault = storedPreference === 'true';
    setDeckOpenState(shouldOpenByDefault, { persist: false });
  }

  function hydrateAudioEmbeds() {
    const targets = document.querySelectorAll('iframe[data-embed-src]');
    targets.forEach((frame) => {
      const src = frame.getAttribute('data-embed-src');
      const safeSrc = sanitizeClientHref(src);
      if (!safeSrc || frame.getAttribute('src') === safeSrc) return;
      frame.setAttribute('src', safeSrc);
    });
  }

  function activateTab(tab, { focus = false } = {}) {
    const panelId = tab.getAttribute('data-panel');
    tabs.forEach((item) => {
      const isActive = item === tab;
      item.classList.toggle('active', isActive);
      item.setAttribute('aria-selected', String(isActive));
      item.tabIndex = isActive ? 0 : -1;
    });

    panels.forEach((panel) => {
      const isActive = panel.id === panelId;
      panel.classList.toggle('active', isActive);
      panel.hidden = !isActive;
    });

    if (panelId === 'panel-audio') hydrateAudioEmbeds();
    if (focus) tab.focus();
    triggerHaptic(8);
  }

  tabs.forEach((tab, index) => {
    tab.tabIndex = tab.classList.contains('active') ? 0 : -1;

    tab.addEventListener('click', () => activateTab(tab));

    tab.addEventListener('keydown', (event) => {
      const key = event.key;
      if (!['ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(key)) return;

      event.preventDefault();
      let nextIndex = index;

      if (key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
      if (key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
      if (key === 'Home') nextIndex = 0;
      if (key === 'End') nextIndex = tabs.length - 1;

      activateTab(tabs[nextIndex], { focus: true });
    });
  });
  function updateDeck(payload) {
    if (!deckTag || !deckTitle || !deckData || !deckDesc || !deckLinks) return;
    deckTag.textContent = payload.tag;
    deckTitle.textContent = payload.title;
    deckData.textContent = payload.data;
    deckDesc.textContent = payload.desc;
    deckLinks.innerHTML = '';
    (payload.links || []).forEach((link) => {
      const safeHref = sanitizeClientHref(link.href);
      if (!safeHref) return;

      const a = document.createElement('a');
      a.href = safeHref;
      a.textContent = link.label;
      if (link.external) {
        a.target = '_blank';
        a.rel = 'noreferrer noopener';
      }
      deckLinks.append(a);
    });

    setDeckOpenState(true);
  }

  function sanitizeClientHref(value) {
    if (!value) return null;
    if (value.startsWith('/') || value.startsWith('#') || value.startsWith('?')) return value;

    try {
      const parsed = new URL(value, window.location.origin);
      return ['http:', 'https:', 'mailto:', 'tel:'].includes(parsed.protocol) ? value : null;
    } catch {
      return null;
    }
  }

  if (deckToggle && detailDeck) {
    deckToggle.addEventListener('click', () => {
      const isOpen = !detailDeck.classList.contains('is-open');
      setDeckOpenState(isOpen);
      triggerHaptic(14);
    });
  }

  hydrateDeckState();

  document.querySelectorAll('.pick-btn').forEach((row) => {
    row.addEventListener('click', () => {
      document.querySelectorAll('.pick-btn').forEach((item) => item.classList.remove('is-selected'));
      row.classList.add('is-selected');
      triggerHaptic([10, 24, 10]);

      const kind = row.getAttribute('data-kind');
      const index = Number(row.getAttribute('data-index') || 0);

      if (kind === 'event') {
        const event = documentedChronology[index];
        if (!event) return;
        const statusDescription = event.status && event.status !== 'played' ? ` Status: ${event.status}.` : '';

        const eventLinks = [
          { href: '/archive/timeline/', label: 'Open timeline →', external: false },
          { href: '/archive/event-ledger/', label: 'Open event list →', external: false }
        ];
        if (event.source.href) {
          eventLinks.push({ href: event.source.href, label: `${event.source.label} ↗`, external: Boolean(event.source.external) });
        }

        updateDeck({
          tag: 'Event',
          title: event.title,
          data: `${event.year} · ${event.date} · ${event.venue}`,
          desc: `${event.lineup}. Link: ${event.source.label}.${statusDescription}`,
          links: eventLinks
        });
        return;
      }

      if (kind === 'person') {
        const person = roster[index];
        if (!person) return;
        const links = [];
        if (person.links.sc) links.push({ href: person.links.sc, label: 'SoundCloud ↗', external: true });
        if (person.links.ig) links.push({ href: person.links.ig, label: 'Instagram ↗', external: true });
        if (person.links.ra) links.push({ href: person.links.ra, label: 'Resident Advisor ↗', external: true });
        if (person.links.bc) links.push({ href: person.links.bc, label: 'Bandcamp reference ↗', external: true });

        updateDeck({
          tag: 'Person',
          title: person.name,
          data: person.role,
          desc: "Quick links to each resident's pages.",
          links
        });
      }

    });
  });

</script>
