---
import BaseLayout from '../layouts/BaseLayout.astro';
import CardLink from '../components/CardLink.astro';
import {
  createCollectionPageSchema,
  createEventSchema,
  createItemListSchema,
  createWebsiteSchema
} from '../utils/structuredData';

const chronology = [
  { year: '2015', date: 'Feb 13', title: 'Pilot: Grime City vs BREAD', venue: 'F8', lineup: 'Helix + locals', confidence: 'user-archive', status: 'played' },
  { year: '2015', date: 'May 29', title: 'BREAD #1', venue: 'F8', lineup: 'Rushmore, Kid Antoine, residents', confidence: 'strong', status: 'played' },
  { year: '2015', date: 'Jul 24', title: 'BREAD #2', venue: 'F8', lineup: 'Rabit, Korma, Sheen, Victoria Kim', confidence: 'user-archive', status: 'played' },
  { year: '2015', date: 'Nov 06', title: 'BREAD #3', venue: 'F8', lineup: 'Doctor Jeep, Sha Sha Kimbo, support incl. Club Chai context', confidence: 'user-archive', status: 'played' },
  { year: '2015', date: 'Nov 13', title: 'Special Event', venue: 'F8', lineup: 'Addison Groove', confidence: 'user-archive', status: 'played' },
  { year: '2016', date: 'Feb 19', title: 'BREAD #4 (Residents Night)', venue: 'F8', lineup: 'Residents', confidence: 'user-archive', status: 'played' },
  { year: '2016', date: 'Mar 25', title: 'BREAD #5', venue: 'F8', lineup: 'Jlin (+ residents)', confidence: 'user-archive', status: 'played' },
  { year: '2016', date: 'Apr 23', title: 'Nightsweats Collaboration', venue: 'SF (venue varies by source)', lineup: "Air Max '97, False Witness", confidence: 'user-archive', status: 'played' },
  { year: '2016', date: 'May 20', title: 'BREAD #7', venue: 'F8 / UGSF period transition', lineup: 'Distal, Celestial Trax, Endgame', confidence: 'user-archive', status: 'played' },
  { year: '2016', date: 'Jun 16', title: 'BREAD #8', venue: 'Mighty (user-archive venue note)', lineup: 'Neana, Bleaker', confidence: 'user-archive', status: 'played' },
  { year: '2016', date: 'Jun 29', title: 'Toasted Trax #1', venue: 'Codeword (user-archive venue note)', lineup: 'Abyss X, DJ Spider', confidence: 'user-archive', status: 'played' },
  { year: '2016', date: 'Jul 22', title: 'BREAD #9', venue: 'Public Works Loft (user-archive venue note)', lineup: 'Deadboy, Murlo, Blackdown', confidence: 'user-archive', status: 'played' },
  { year: '2016', date: 'Aug 19', title: 'BREAD #10', venue: 'F8', lineup: 'Rabit (live), Logos, Mumdance, Pinch, Caski', confidence: 'user-archive', status: 'played' },
  { year: '2016', date: 'Sep 04', title: 'BREAD #11', venue: "Bruno's (Long Weekend Special)", lineup: 'Dehousy, The Dance Pit', confidence: 'user-archive', status: 'played' },
  { year: '2016', date: 'Oct 21', title: 'Toasted Trax #2', venue: 'Codeword', lineup: 'Iyer, Adam Kraft, Prawns', confidence: 'user-archive', status: 'unlisted/canceled claim' },
  { year: '2016', date: 'Nov 19', title: 'Sure Thing Collaboration', venue: 'Club 6ix (Lobster Theremin showcase)', lineup: 'Route 8, Asquith', confidence: 'user-archive', status: 'played' },
  { year: '2016', date: 'Dec 09', title: 'BREAD #12', venue: 'F8', lineup: 'NA, TSVI, Dubbel Dutch', confidence: 'user-archive', status: 'played' },
  { year: '2017', date: 'Feb 24', title: 'BREAD #13 (Residents Night)', venue: 'Underground SF', lineup: 'Residents', confidence: 'user-archive', status: 'played' },
  { year: '2017', date: 'Mar 24', title: 'UGSF Night', venue: 'Underground SF', lineup: 'DJ J Heat, Kieran Loftus', confidence: 'user-archive', status: 'played' },
  { year: '2017', date: 'May 26', title: 'UGSF Night', venue: 'Underground SF', lineup: 'Mr. Mitch, Kozee', confidence: 'user-archive', status: 'played' },
  { year: '2017', date: 'Jul 28', title: 'UGSF Night', venue: 'Underground SF', lineup: 'Roska, Misoh', confidence: 'user-archive', status: 'played' },
  { year: '2017', date: 'Sep 22', title: 'UGSF Night', venue: 'Underground SF', lineup: 'Kelman Duran, Suda', confidence: 'user-archive', status: 'played' },
  { year: '2018', date: 'May 12', title: 'Final Club Night', venue: 'OMG', lineup: 'Gila, Neana', confidence: 'user-archive', status: 'played' },
  { year: '2021', date: 'Jan 02', title: 'BREAD New Year Stream', venue: 'Twitch', lineup: 'Zaida, Wonja, Color Plus, Gila', confidence: 'strong', status: 'played' },
  { year: '2021', date: 'Mar 13', title: 'Six Years of BREAD Stream', venue: 'Twitch', lineup: 'Residents-led lineup', confidence: 'strong', status: 'played' },
  { year: '2021', date: 'Jul 10', title: 'Long Bread Summer Stream', venue: 'Twitch', lineup: 'Residents + collaborators', confidence: 'strong', status: 'played' }
];

const roster = [
  { name: 'Cage A (Kanav)', role: 'Founder', links: { sc: 'https://soundcloud.com/cage_a' } },
  { name: 'Prawns', role: 'Founder', links: { sc: 'https://soundcloud.com/prawns', ig: 'https://instagram.com/_prawns' } },
  {
    name: 'Judy (dhra)',
    role: 'Co-founder',
    notes: 'Co-founding member; later artistic direction shifted away from the lane that originally brought the crew together.',
    links: {}
  },
  { name: 'Botaz', role: 'Resident', links: { sc: 'https://soundcloud.com/botaz', ig: 'https://instagram.com/brian_aviles' } },
  { name: 'Misoh', role: 'Resident (through ~2018)', notes: 'Part of the resident era through the 2018 transition.', links: {} },
  { name: 'TF1000 / Tranespotting', role: 'Resident', links: { sc: 'https://soundcloud.com/tranespotting', ig: 'https://instagram.com/tf1000_' } },
  { name: 'Adam Kraft', role: 'Resident', links: { sc: 'https://soundcloud.com/adamkraftneindanke', ig: 'https://instagram.com/adamkraft_', ra: 'https://ra.co/dj/adamkraft' } },
  { name: 'Gewzer', role: 'Resident', links: { sc: 'https://soundcloud.com/gewzer', ig: 'https://instagram.com/gewzer', bc: 'https://cyberspa.bandcamp.com/album/g-love-s' } },
  { name: 'Exteeng', role: 'Resident (from 2018)', links: { sc: 'https://soundcloud.com/exteeng', ig: 'https://instagram.com/exteeng', ra: 'https://ra.co/dj/exteeng' } },
  { name: 'Shl', role: 'Resident (from 2021)', links: {} }
];

const documentedChronology = chronology.filter((event) => event.confidence !== 'unverified');
const hasMeaningfulStatus = (event: (typeof chronology)[number]) => event.status && event.status !== 'played';
const activeYears = new Set(documentedChronology.map((event) => event.year)).size;
const summaryStats = [
  { label: 'Documented events', value: documentedChronology.length },
  { label: 'Active years', value: activeYears },
  { label: 'Residents listed', value: roster.length }
];

const directoryLinks = [
  { label: 'BREAD SoundCloud ↗', href: 'https://soundcloud.com/breadfm', external: true },
  { label: 'IPR show page ↗', href: 'https://www.internetpublicradio.live/shows/bread-fm', external: true },
  { label: 'Featured mix (Prawns + Botaz, 2023-04-26) ↗', href: 'https://soundcloud.com/breadfm/bread-fm-on-internet-public-radio-prawns-botaz-04262023', external: true },
  { label: 'BREAD Instagram ↗', href: 'https://instagram.com/bread_sf', external: true },
  { label: 'BREAD X / Twitter ↗', href: 'https://x.com/breadsf', external: true },
  { label: 'RA promoter page ↗', href: 'https://ra.co/promoters/51043', external: true },
  { label: 'Radio Valencia ↗', href: 'http://www.radiovalencia.fm/', external: true },
  { label: 'Channel & profile directory →', href: '/archive/channel-profile-directory/', external: false },
  { label: 'Timeline & eras →', href: '/archive/timeline/', external: false },
  { label: 'Story archive →', href: '/blog/the-story-of-bread/', external: false }
];

const soundcloudEmbedCollections = [
  {
    title: 'BREAD profile stream',
    description: 'Main profile feed with published uploads and artist updates.',
    href: 'https://soundcloud.com/breadfm',
    height: 420,
    visual: true
  },
  {
    title: 'BREAD playlists',
    description: 'Dive into set-based listening with curated archives and series.',
    href: 'https://soundcloud.com/breadfm/sets',
    height: 300,
    visual: false
  },
  {
    title: 'BREAD likes',
    description: 'Explore adjacent scenes and inspirations via liked tracks.',
    href: 'https://soundcloud.com/breadfm/likes',
    height: 300,
    visual: false
  },
  {
    title: 'BREAD reposts',
    description: 'Browse network signals and collaborations through repost activity.',
    href: 'https://soundcloud.com/breadfm/reposts',
    height: 300,
    visual: false
  }
];

const platformEmbeds = {
  ipr: {
    title: 'Internet Public Radio episode (via Mixcloud)',
    href: 'https://www.internetpublicradio.live/episodes/bread-fm-w-botaz-shl-28th-september-2022',
    src: 'https://player-widget.mixcloud.com/widget/iframe/?hide_cover=0&mini=0&light=1&feed=%2Finternetpublicradio%2Fbread-fm-w-botaz-shl-28th-september-2022%2F',
    height: 120
  },
  appleShow: {
    title: 'Apple Podcasts show embed',
    href: 'https://podcasts.apple.com/us/podcast/bread-fm/id1227134378',
    src: 'https://embed.podcasts.apple.com/us/podcast/bread-fm/id1227134378',
    height: 450
  },
  appleEpisode: {
    title: 'Apple Podcasts episode embed (Prawns + Botaz live)',
    href: 'https://podcasts.apple.com/us/podcast/bread-fm-on-internet-public-radio-prawns-botaz-live/id1227134378?i=1000610844660',
    src: 'https://embed.podcasts.apple.com/us/podcast/bread-fm-on-internet-public-radio-prawns-botaz-live/id1227134378?i=1000610844660',
    height: 450
  },
  facebook: {
    title: 'Facebook page plugin',
    href: 'https://www.facebook.com/breadfm/',
    src: 'https://www.facebook.com/plugins/page.php?href=https%3A%2F%2Fwww.facebook.com%2Fbreadfm%2F&tabs=timeline&width=500&height=540&small_header=false&adapt_container_width=true&hide_cover=false&show_facepile=true&appId',
    height: 540
  }
};

const residentSoundcloudProfiles = roster
  .filter((person): person is (typeof roster)[number] & { links: { sc: string } } => Boolean(person.links.sc))
  .map((person) => ({
    name: person.name,
    role: person.role,
    href: person.links.sc
  }));



const monthMap: Record<string, number> = {
  Jan: 1,
  Feb: 2,
  Mar: 3,
  Apr: 4,
  May: 5,
  Jun: 6,
  Jul: 7,
  Aug: 8,
  Sep: 9,
  Oct: 10,
  Nov: 11,
  Dec: 12
};

const toIsoDate = (year: string, shortDate: string): string | undefined => {
  const [monthLabel, dayRaw] = shortDate.split(' ');
  const month = monthMap[monthLabel];
  const day = Number(dayRaw);
  if (!month || Number.isNaN(day)) return undefined;

  return `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
};

const mapEventStatus = (status: string): string | undefined => {
  if (status.includes('canceled')) return 'https://schema.org/EventCancelled';
  if (status === 'played') return 'https://schema.org/EventCompleted';
  return undefined;
};

const eventSchemas = documentedChronology
  .map((event, index) => {
    const startDate = toIsoDate(event.year, event.date);
    if (!startDate) return undefined;

    return createEventSchema({
      site: Astro.site,
      pagePathname: Astro.url.pathname,
      position: index + 1,
      name: event.title,
      startDate,
      venueName: event.venue,
      description: event.lineup,
      status: mapEventStatus(event.status)
    });
  })
  .filter((entry): entry is Record<string, unknown> => Boolean(entry));

const homeStructuredData = [
  createWebsiteSchema({
    site: Astro.site,
    name: 'BREAD',
    description: 'BREAD historical archive and narrative resources.'
  }),
  createCollectionPageSchema({
    site: Astro.site,
    pathname: Astro.url.pathname,
    name: 'BREAD Home',
    description: 'Primary discovery page for chronology, residents, archive routes, and listening resources.',
    isPartOf: 'BREAD'
  }),
  createItemListSchema({
    name: 'BREAD Event History',
    description: 'Chronological event records from the BREAD archive homepage.',
    itemListElement: eventSchemas
  })
].filter((entry): entry is Record<string, unknown> => Boolean(entry));

const buildSoundCloudEmbedSrc = (href: string, visual = false) => {
  const params = new URLSearchParams({
    url: href,
    color: '#ff5a1f',
    auto_play: 'false',
    hide_related: 'false',
    show_comments: 'true',
    show_user: 'true',
    show_reposts: 'true',
    show_teaser: 'true',
    visual: visual ? 'true' : 'false'
  });

  return `https://w.soundcloud.com/player/?${params.toString()}`;
};

---

<BaseLayout
  title="BREAD // Archive"
  description="BREAD archive timeline, people, and links."
  showSiteFrame={false}
  structuredData={homeStructuredData}
>
  <div class="bg-mark">BREAD</div>
  <header class="topline">
    <span>ARCHIVE NODE // SAN FRANCISCO</span>
    <span>2015—2021</span>
  </header>

  <section class="shell">
    <aside class="nav-rail">
      <div class="rail-head">
        <h1 class="wordmark">BREAD</h1>
      </div>
      <section class="snapshot rail-card" aria-label="Summary">
        <p class="snapshot-title">Summary</p>
        <ul class="snapshot-list">
          {summaryStats.map((item) => (
            <li>
              <span class="snapshot-value">{item.value}</span>
              <span class="snapshot-label">{item.label}</span>
            </li>
          ))}
        </ul>
      </section>
      <section class="route-start rail-card" aria-label="Primary routes">
        <p class="route-start-title">Start here</p>
        <p class="route-start-copy">Top-level destinations stay pinned here for quick route switching.</p>
        <nav class="primary-routes" aria-label="Primary routes">
          <CardLink href="/archive/" label="Archive index →" />
          <CardLink href="/archive/timeline/" label="Timeline & eras →" />
          <CardLink href="/archive/event-ledger/" label="Event ledger →" />
          <CardLink href="/blog/the-story-of-bread/" label="Narrative history →" />
        </nav>
      </section>
      <nav class="tabs rail-card" id="tabs">
        <p class="tabs-title">Browse sections</p>
        <p class="tabs-copy">Use this single switcher for events, people, audio, and links.</p>
        <div class="tablist" role="tablist" aria-label="Archive sections">
          <button class="tab active" role="tab" aria-selected="true" aria-controls="panel-ledger" id="tab-ledger" data-panel="panel-ledger">events</button>
          <button class="tab" role="tab" aria-selected="false" aria-controls="panel-people" id="tab-people" data-panel="panel-people">people</button>
          <button class="tab" role="tab" aria-selected="false" aria-controls="panel-audio" id="tab-audio" data-panel="panel-audio">audio</button>
          <button class="tab" role="tab" aria-selected="false" aria-controls="panel-links" id="tab-links" data-panel="panel-links">links</button>
        </div>
      </nav>
      <p class="policy rail-policy">Events gathered from public records in this repository.</p>
    </aside>

    <main class="content">
      <article class="panel active" id="panel-ledger" role="tabpanel" aria-labelledby="tab-ledger">
        <h2>Event History</h2>
        <p class="result-count" id="eventsResultCount">{documentedChronology.length} events shown</p>
        <ul class="cards">
          {documentedChronology.map((event, index) => (
            <li class="card" id={`event-${index + 1}`} data-kind="event" data-index={index}>
              <button class="pick-btn" data-kind="event" data-index={index} aria-label={`View details for ${event.title}`}>
                <div>
                  <p class="title">{event.title}</p>
                  <p class="meta">{event.year} · {event.date} · {event.venue}</p>
                  <p class="lineup">{event.lineup}</p>
                  {hasMeaningfulStatus(event) && <p class="status">status: {event.status}</p>}
                </div>
              </button>
            </li>
          ))}
        </ul>
      </article>

      <article class="panel" id="panel-people" role="tabpanel" aria-labelledby="tab-people" hidden>
        <h2>People</h2>
        <ul class="cards people">
          {roster.map((person, index) => (
            <li class="card" data-kind="person" data-index={index}>
              <button class="pick-btn" data-kind="person" data-index={index} aria-label={`View profile links for ${person.name}`}>
                <div>
                  <p class="title">{person.name}</p>
                  <p class="meta">{person.role}</p>
                  {person.notes && <p class="lineup">{person.notes}</p>}
                </div>
              </button>
            </li>
          ))}
        </ul>
      </article>

      <article class="panel" id="panel-links" role="tabpanel" aria-labelledby="tab-links" hidden>
        <h2>Where to explore next</h2>
        <ul class="route-list">
          {directoryLinks.map((item) => (
            <li>
              <CardLink href={item.href} label={item.label} external={item.external} />
            </li>
          ))}
        </ul>
      </article>

      <article class="panel" id="panel-audio" role="tabpanel" aria-labelledby="tab-audio" hidden>
        <h2>SoundCloud listening hub</h2>
        <p class="audio-intro">Listen to BREAD&apos;s profile, playlists, likes, reposts, plus resident SoundCloud profiles in one place.</p>
        <div class="audio-actions">
          <button class="chip" type="button" id="loadAudioEmbeds">Load audio embeds</button>
          <a href="https://soundcloud.com/breadfm" target="_blank" rel="noreferrer">Open BREAD profile ↗</a>
        </div>
        <ul class="audio-grid">
          {soundcloudEmbedCollections.map((item) => (
            <li class="audio-card">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <iframe
                title={item.title}
                width="100%"
                height={item.height}
                allow="autoplay"
                loading="lazy"
                src="about:blank"
                data-embed-src={buildSoundCloudEmbedSrc(item.href, item.visual)}
              ></iframe>
              <a href={item.href} target="_blank" rel="noreferrer">Open on SoundCloud ↗</a>
            </li>
          ))}
        </ul>
        <section class="resident-audio" aria-label="Resident SoundCloud channels">
          <h3>Resident SoundCloud channels</h3>
          <p class="resident-audio-copy">Quick-embed cards for each resident profile linked in this archive.</p>
          <ul class="resident-audio-grid">
            {residentSoundcloudProfiles.map((profile) => (
              <li>
                <h4>{profile.name}</h4>
                <p>{profile.role}</p>
                <iframe
                  title={`${profile.name} SoundCloud profile`}
                  width="100%"
                  height="166"
                  allow="autoplay"
                  loading="lazy"
                  src="about:blank"
                  data-embed-src={buildSoundCloudEmbedSrc(profile.href, false)}
                ></iframe>
                <a href={profile.href} target="_blank" rel="noreferrer">Visit profile ↗</a>
              </li>
            ))}
          </ul>
        </section>
        <section class="platform-embeds" aria-label="Other platform embeds">
          <h3>Other platform embeds</h3>
          <p class="resident-audio-copy">Integrated where supported: Internet Public Radio via Mixcloud, Apple Podcasts embeds, and Facebook page timeline. Instagram and RA are linked in the links tab.</p>
          <ul class="audio-grid">
            <li class="audio-card">
              <h4>{platformEmbeds.ipr.title}</h4>
              <iframe
                title={platformEmbeds.ipr.title}
                width="100%"
                height={platformEmbeds.ipr.height}
                loading="lazy"
                src="about:blank"
                data-embed-src={platformEmbeds.ipr.src}
              ></iframe>
              <a href={platformEmbeds.ipr.href} target="_blank" rel="noreferrer">Open IPR episode ↗</a>
            </li>
            <li class="audio-card">
              <h4>{platformEmbeds.appleShow.title}</h4>
              <iframe
                title={platformEmbeds.appleShow.title}
                width="100%"
                height={platformEmbeds.appleShow.height}
                loading="lazy"
                allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write"
                sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-top-navigation-by-user-activation"
                src="about:blank"
                data-embed-src={platformEmbeds.appleShow.src}
              ></iframe>
              <a href={platformEmbeds.appleShow.href} target="_blank" rel="noreferrer">Open Apple show ↗</a>
            </li>
            <li class="audio-card">
              <h4>{platformEmbeds.appleEpisode.title}</h4>
              <iframe
                title={platformEmbeds.appleEpisode.title}
                width="100%"
                height={platformEmbeds.appleEpisode.height}
                loading="lazy"
                allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write"
                sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-top-navigation-by-user-activation"
                src="about:blank"
                data-embed-src={platformEmbeds.appleEpisode.src}
              ></iframe>
              <a href={platformEmbeds.appleEpisode.href} target="_blank" rel="noreferrer">Open Apple episode ↗</a>
            </li>
            <li class="audio-card">
              <h4>{platformEmbeds.facebook.title}</h4>
              <iframe
                title={platformEmbeds.facebook.title}
                width="100%"
                height={platformEmbeds.facebook.height}
                loading="lazy"
                allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
                src="about:blank"
                data-embed-src={platformEmbeds.facebook.src}
              ></iframe>
              <a href={platformEmbeds.facebook.href} target="_blank" rel="noreferrer">Open Facebook page ↗</a>
            </li>
          </ul>
        </section>
      </article>
    </main>

    <aside class="deck" id="detailDeck" aria-live="polite">
      <button class="deck-toggle" type="button" id="deckToggle" aria-expanded="false" aria-controls="deckContent">Show details panel</button>
      <div id="deckContent" class="deck-content">
      <p class="deck-tag" id="deckTag">ENTRY</p>
      <h3 id="deckTitle">SELECT ITEM</h3>
      <p id="deckData">Choose an event or resident to inspect metadata.</p>
      <p id="deckDesc">This panel shows event and profile details with quick links.</p>
      <div id="deckLinks" class="deck-links"></div>
      </div>
    </aside>
  </section>
</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@200;300;400;600&family=JetBrains+Mono:wght@400&display=swap');

  :global(:root) {
    --bg: #080808;
    --bg-alt: #0d0d0d;
    --panel: #121212;
    --panel-soft: #161616;
    --panel-elevated: #1a1a1a;
    --line: #2b2b2b;
    --line-strong: #3c3c3c;
    --text: #ededed;
    --muted: #b8b8b8;
    --accent: #ff5a1f;
    --accent-soft: rgb(255 90 31 / 20%);
    --radius-card: 0.8rem;
  }

  :global(body) {
    margin: 0;
    background:
      radial-gradient(circle at 12% -4%, rgb(255 90 31 / 9%), transparent 42%),
      linear-gradient(140deg, var(--bg) 10%, #0a0a0a 64%, #080808 100%);
    color: var(--text);
  }

  :global(main) {
    max-width: none !important;
    width: 100% !important;
    min-height: 100vh;
    margin: 0 !important;
    padding: 0;
    position: relative;
    overflow: hidden;
    font-family: 'Inter', sans-serif;
  }

  .bg-mark {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 1.25rem;
    font-family: 'Archivo Black', sans-serif;
    font-size: min(22vw, 18rem);
    color: rgb(255 255 255 / 1.8%);
    letter-spacing: -0.03em;
    pointer-events: none;
    user-select: none;
  }

  .topline {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid #1f1f1f;
    padding: 0.55rem 1rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
