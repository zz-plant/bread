  }

  .confidence {
    border: 1px solid #3a3a3a;
    border-radius: 999px;
    padding: 0.28rem 0.52rem;
    height: fit-content;
    font-size: 0.68rem;
    text-transform: uppercase;
    background: #101010;
  }

  .confidence.strong {
    color: #93c5fd;
  }

  .confidence.verified {
    color: #86efac;
  }

  .confidence.user-archive {
    color: #fdba74;
  }

  .deck-tag {
    margin: 0;
    font-family: 'JetBrains Mono', monospace;
    color: var(--accent);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .deck h3 {
    margin: 0;
    font-weight: 200;
    font-size: 2rem;
    line-height: 0.88;
    text-transform: lowercase;
    letter-spacing: -0.03em;
  }

  .deck p {
    margin: 0;
    color: #b8b8b8;
    line-height: 1.45;
  }

  .deck-links {
    display: grid;
    gap: 0.45rem;
  }

  .deck-toggle {
    display: none;
  }

  .deck-links a {
    color: #dedede;
    text-decoration: none;
  }

  .deck-links a:hover,
  .deck-links a:focus-visible {
    color: var(--accent);
  }

  .content::-webkit-scrollbar,
  .deck::-webkit-scrollbar,
  .panel::-webkit-scrollbar {
    width: 0.5rem;
  }

  .content::-webkit-scrollbar-thumb,
  .deck::-webkit-scrollbar-thumb,
  .panel::-webkit-scrollbar-thumb {
    background: #2d2d2d;
    border-radius: 999px;
  }

  @media (max-width: 1200px) {
    .shell {
      grid-template-columns: 220px minmax(0, 1fr);
      min-height: calc(100vh - 36px);
    }

    .content,
    .deck {
      max-height: none;
    }

    .deck {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 780px) {
    .topline {
      font-size: 0.6rem;
      flex-wrap: wrap;
    }

    .shell {
      grid-template-columns: 1fr;
      padding: 0.7rem;
      padding-bottom: calc(6rem + env(safe-area-inset-bottom));
      max-width: none;
      min-height: auto;
    }

    .nav-rail,
    .content,
    .deck {
      border-radius: 0.7rem;
    }

    .wordmark {
      font-size: 2.1rem;
    }

    .tab {
      font-size: 1.65rem;
    }

    .tablist {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.6rem;
    }

    .deck {
      position: fixed;
      left: 0.7rem;
      right: 0.7rem;
      bottom: calc(0.7rem + env(safe-area-inset-bottom));
      max-height: min(54vh, 28rem);
      margin: 0;
      z-index: 35;
      overflow: auto;
      box-shadow: 0 20px 45px rgb(0 0 0 / 56%), inset 0 1px 0 rgb(255 255 255 / 3%);
      backdrop-filter: blur(8px);
    }

    .deck-toggle {
      display: block;
      width: 100%;
      border: 1px solid #3a3a3a;
      border-radius: 0.7rem;
      background: #0f0f0f;
      color: #f3f3f3;
      padding: 0.65rem 0.8rem;
      text-align: left;
      font-weight: 600;
      margin-bottom: 0.6rem;
      min-height: 44px;
      touch-action: manipulation;
    }

    .deck-content {
      display: none;
    }

    .deck.is-open .deck-content {
      display: grid;
      gap: 0.55rem;
    }

    h2 {
      font-size: 2.2rem;
    }

    .title {
      font-size: 1.02rem;
    }
  }

  @media (hover: none) {
    .tab:hover,
    .card:hover,
    .primary-routes :global(.card-link:hover),
    .route-list :global(.card-link:hover) {
      transform: none;
      box-shadow: none;
    }
  }

  @media (max-width: 600px) {
    .deck {
      left: 0.55rem;
      right: 0.55rem;
      bottom: calc(0.55rem + env(safe-area-inset-bottom));
    }

    .topline {
      gap: 0.35rem;
      font-size: 0.57rem;
      letter-spacing: 0.08em;
      padding-inline: max(0.75rem, env(safe-area-inset-left)) max(0.75rem, env(safe-area-inset-right));
    }

    .shell {
      padding: 0.55rem;
      padding-bottom: calc(5.6rem + env(safe-area-inset-bottom));
      gap: 0.6rem;
    }

    .nav-rail,
    .content,
    .deck {
      padding: 0.8rem;
    }

    .tablist {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.45rem;
    }

    .tab {
      border: 1px solid #333;
      border-radius: 999px;
      padding: 0.55rem 0.75rem;
      font-size: 1.1rem;
      text-align: center;
      background: #0d0d0d;
      line-height: 1;
    }

    .tab.active {
      border-color: var(--accent);
      background: rgb(255 90 31 / 12%);
    }

    .card {
      min-height: 96px;
      padding: 0.75rem;
    }

    .pick-btn {
      gap: 0.55rem;
    }

    .confidence {
      font-size: 0.62rem;
      padding: 0.25rem 0.45rem;
    }

    .meta,
    .status {
      font-size: 0.68rem;
    }
  }
</style>

<script is:inline define:vars={{ documentedChronology, roster, sourceLabelByConfidence }}>
  const tabs = Array.from(document.querySelectorAll('.tab'));
  const panels = document.querySelectorAll('.panel');
  const chips = document.querySelectorAll('.chip');
  const resetFilters = document.getElementById('resetFilters');
  const eventsEmptyState = document.getElementById('eventsEmptyState');
  const loadAudioEmbeds = document.getElementById('loadAudioEmbeds');
  const sectionJumps = document.querySelectorAll('[data-jump-panel]');
  const eventsResultCount = document.getElementById('eventsResultCount');

  const deckTag = document.getElementById('deckTag');
  const deckTitle = document.getElementById('deckTitle');
  const deckData = document.getElementById('deckData');
  const deckDesc = document.getElementById('deckDesc');
  const deckLinks = document.getElementById('deckLinks');
  const detailDeck = document.getElementById('detailDeck');
  const deckToggle = document.getElementById('deckToggle');
  const deckStateStorageKey = 'bread:detailDeckOpen';

  const activeFilters = {
    confidence: 'all',
    status: 'all'
  };

  function setDeckOpenState(isOpen, { persist = true } = {}) {
    if (!detailDeck || !deckToggle) return;

    detailDeck.classList.toggle('is-open', isOpen);
    deckToggle.setAttribute('aria-expanded', String(isOpen));
    deckToggle.textContent = isOpen ? 'Hide details panel' : 'Show details panel';

    if (!persist) return;
    try {
      window.localStorage.setItem(deckStateStorageKey, String(isOpen));
    } catch {
      // Ignore storage access restrictions.
    }
  }

  function hydrateDeckState() {
    if (!detailDeck || !deckToggle) return;

    let storedPreference = null;
    try {
      storedPreference = window.localStorage.getItem(deckStateStorageKey);
    } catch {
      storedPreference = null;
    }

    const shouldOpenByDefault = storedPreference === null ? true : storedPreference === 'true';
    setDeckOpenState(shouldOpenByDefault, { persist: false });
  }

  function hydrateAudioEmbeds() {
    const targets = document.querySelectorAll('iframe[data-embed-src]');
    targets.forEach((frame) => {
      const src = frame.getAttribute('data-embed-src');
      if (!src || frame.getAttribute('src') === src) return;
      frame.setAttribute('src', src);
    });
    if (loadAudioEmbeds) {
      loadAudioEmbeds.setAttribute('disabled', 'true');
      loadAudioEmbeds.textContent = 'Embeds loaded';
    }
  }

  function activateTab(tab, { focus = false } = {}) {
    const panelId = tab.getAttribute('data-panel');
    tabs.forEach((item) => {
      const isActive = item === tab;
      item.classList.toggle('active', isActive);
      item.setAttribute('aria-selected', String(isActive));
      item.tabIndex = isActive ? 0 : -1;
    });

    panels.forEach((panel) => {
      const isActive = panel.id === panelId;
      panel.classList.toggle('active', isActive);
      panel.hidden = !isActive;
    });

    if (panelId === 'panel-audio') hydrateAudioEmbeds();

    sectionJumps.forEach((item) => {
      const isActive = item.getAttribute('data-jump-panel') === panelId;
      item.setAttribute('aria-pressed', String(isActive));
    });

    if (focus) tab.focus();
  }

  tabs.forEach((tab, index) => {
    tab.tabIndex = tab.classList.contains('active') ? 0 : -1;

    tab.addEventListener('click', () => activateTab(tab));

    tab.addEventListener('keydown', (event) => {
      const key = event.key;
      if (!['ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(key)) return;

      event.preventDefault();
      let nextIndex = index;

      if (key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
      if (key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
      if (key === 'Home') nextIndex = 0;
      if (key === 'End') nextIndex = tabs.length - 1;

      activateTab(tabs[nextIndex], { focus: true });
    });
  });

  sectionJumps.forEach((jump) => {
    jump.addEventListener('click', () => {
      const panelId = jump.getAttribute('data-jump-panel');
      if (!panelId) return;
      const tab = tabs.find((item) => item.getAttribute('data-panel') === panelId);
      if (!tab) return;
      activateTab(tab, { focus: true });
    });
  });

  function applyFilters() {
    let visibleCount = 0;

    document.querySelectorAll('#panel-ledger .card').forEach((row) => {
      const confidence = row.getAttribute('data-confidence') || '';
      const status = row.getAttribute('data-status') || '';
      const confidenceMatch = activeFilters.confidence === 'all' || confidence === activeFilters.confidence;
      const statusMatch = activeFilters.status === 'all' || status === activeFilters.status;
      const shouldShow = confidenceMatch && statusMatch;
      row.hidden = !shouldShow;
      if (shouldShow) visibleCount += 1;
    });

    if (eventsEmptyState) eventsEmptyState.hidden = visibleCount > 0;
    if (eventsResultCount) eventsResultCount.textContent = `${visibleCount} event${visibleCount === 1 ? '' : 's'} shown`;
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const type = chip.getAttribute('data-type');
      const value = chip.getAttribute('data-filter') || 'all';
      if (!type) return;

      activeFilters[type] = value;

      document.querySelectorAll(`.chip[data-type="${type}"]`).forEach((item) => {
        const isActive = item === chip;
        item.classList.toggle('active', isActive);
        item.setAttribute('aria-pressed', String(isActive));
      });

      applyFilters();
    });
  });


  if (resetFilters) {
    resetFilters.addEventListener('click', () => {
      activeFilters.confidence = 'all';
      activeFilters.status = 'all';

      document.querySelectorAll('.chip[data-type]').forEach((item) => {
        const type = item.getAttribute('data-type');
        const isActive = item.getAttribute('data-filter') === 'all';
        if (!type) return;
        item.classList.toggle('active', isActive);
        item.setAttribute('aria-pressed', String(isActive));
      });

      applyFilters();
    });
  }

  function updateDeck(payload) {
    if (!deckTag || !deckTitle || !deckData || !deckDesc || !deckLinks) return;
    deckTag.textContent = payload.tag;
    deckTitle.textContent = payload.title;
    deckData.textContent = payload.data;
    deckDesc.textContent = payload.desc;
    deckLinks.innerHTML = '';
    (payload.links || []).forEach((link) => {
      const a = document.createElement('a');
      a.href = link.href;
      a.textContent = link.label;
      if (link.external) {
        a.target = '_blank';
        a.rel = 'noreferrer';
      }
      deckLinks.append(a);
    });

    setDeckOpenState(true);
  }

  if (loadAudioEmbeds) {
    loadAudioEmbeds.addEventListener('click', () => hydrateAudioEmbeds());
  }

  if (deckToggle && detailDeck) {
    deckToggle.addEventListener('click', () => {
      const isOpen = !detailDeck.classList.contains('is-open');
      setDeckOpenState(isOpen);
    });
  }

  hydrateDeckState();

  document.querySelectorAll('.pick-btn').forEach((row) => {
    row.addEventListener('click', () => {
      document.querySelectorAll('.pick-btn').forEach((item) => item.classList.remove('is-selected'));
      row.classList.add('is-selected');

      const kind = row.getAttribute('data-kind');
      const index = Number(row.getAttribute('data-index') || 0);

      if (kind === 'event') {
        const event = documentedChronology[index];
        if (!event) return;
        updateDeck({
          tag: 'EVENT',
          title: event.title,
          data: `${event.year} · ${event.date} · ${event.venue}`,
          desc: `${event.lineup}. Status: ${event.status}. Source note: ${sourceLabelByConfidence[event.confidence] ?? 'archive notes'}.`,
          links: [{ href: '/archive/timeline/', label: 'Open timeline notes →', external: false }]
        });
        return;
      }

      if (kind === 'person') {
        const person = roster[index];
        if (!person) return;
        const links = [];
        if (person.links.sc) links.push({ href: person.links.sc, label: 'SoundCloud ↗', external: true });
        if (person.links.ig) links.push({ href: person.links.ig, label: 'Instagram ↗', external: true });
        if (person.links.ra) links.push({ href: person.links.ra, label: 'Resident Advisor ↗', external: true });
        if (person.links.bc) links.push({ href: person.links.bc, label: 'Bandcamp reference ↗', external: true });

        updateDeck({
          tag: 'PERSON',
          title: person.name,
          data: person.role,
          desc: 'Resident profile pulled from archive network and profile directory entries.',
          links
        });
      }
    });
  });

  applyFilters();

</script>
