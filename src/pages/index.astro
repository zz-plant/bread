  .pick-btn {
    width: 100%;
    border: 0;
    background: transparent;
    color: inherit;
    text-align: left;
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0;
    cursor: pointer;
    min-height: 44px;
    touch-action: manipulation;
  }

  .card:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
    box-shadow: 0 16px 34px rgb(0 0 0 / 36%), inset 0 1px 0 rgb(255 255 255 / 3%);
  }

  .pick-btn:focus-visible,
  .tab:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
