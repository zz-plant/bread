    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .chip {
    border: 1px solid #444;
    border-radius: 999px;
    background: #0d0d0d;
    color: #ddd;
    padding: 0.5rem 0.75rem;
    min-height: 44px;
    font-size: 0.72rem;
    font-family: 'JetBrains Mono', monospace;
