---
import BaseLayout from '../layouts/BaseLayout.astro';

const chronology = [
  { year: '2015', date: 'Feb 13', title: 'Pilot: Grime City vs BREAD', venue: 'F8', lineup: 'Helix + locals', confidence: 'user-archive', status: 'played' },
  { year: '2015', date: 'May 29', title: 'BREAD #1', venue: 'F8', lineup: 'Rushmore, Kid Antoine, residents', confidence: 'strong', status: 'played' },
  { year: '2015', date: 'Jul 24', title: 'BREAD #2', venue: 'F8', lineup: 'Rabit, Korma, Sheen, Victoria Kim', confidence: 'user-archive', status: 'played' },
  { year: '2015', date: 'Nov 06', title: 'BREAD #3', venue: 'F8', lineup: 'Doctor Jeep, Sha Sha Kimbo, support incl. Club Chai context', confidence: 'user-archive', status: 'played' },
  { year: '2015', date: 'Nov 13', title: 'Special Event', venue: 'F8', lineup: 'Addison Groove', confidence: 'user-archive', status: 'played' },
  { year: '2016', date: 'Feb 19', title: 'BREAD #4 (Residents Night)', venue: 'F8', lineup: 'Residents', confidence: 'user-archive', status: 'played' },
  { year: '2016', date: 'Mar 25', title: 'BREAD #5', venue: 'F8', lineup: 'Jlin (+ residents)', confidence: 'user-archive', status: 'played' },
  { year: '2016', date: 'Apr 23', title: 'Nightsweats Collaboration', venue: 'SF (venue varies by source)', lineup: "Air Max '97, False Witness", confidence: 'user-archive', status: 'played' },
  { year: '2016', date: 'May 20', title: 'BREAD #7', venue: 'F8 / UGSF period transition', lineup: 'Distal, Celestial Trax, Endgame', confidence: 'user-archive', status: 'played' },
  { year: '2016', date: 'Jun 16', title: 'BREAD #8', venue: 'Mighty (user-archive venue note)', lineup: 'Neana, Bleaker', confidence: 'user-archive', status: 'played' },
  { year: '2016', date: 'Jun 29', title: 'Toasted Trax #1', venue: 'Codeword (user-archive venue note)', lineup: 'Abyss X, DJ Spider', confidence: 'user-archive', status: 'played' },
  { year: '2016', date: 'Jul 22', title: 'BREAD #9', venue: 'Public Works Loft (user-archive venue note)', lineup: 'Deadboy, Murlo, Blackdown', confidence: 'user-archive', status: 'played' },
  { year: '2016', date: 'Aug 19', title: 'BREAD #10', venue: 'F8', lineup: 'Rabit (live), Logos, Mumdance, Pinch, Caski', confidence: 'user-archive', status: 'played' },
  { year: '2016', date: 'Sep 04', title: 'BREAD #11', venue: "Bruno's (Long Weekend Special)", lineup: 'Dehousy, The Dance Pit', confidence: 'user-archive', status: 'played' },
  { year: '2016', date: 'Oct 21', title: 'Toasted Trax #2', venue: 'Codeword', lineup: 'Iyer, Adam Kraft, Prawns', confidence: 'user-archive', status: 'unlisted/canceled claim' },
  { year: '2016', date: 'Nov 19', title: 'Sure Thing Collaboration', venue: 'Club 6ix (Lobster Theremin showcase)', lineup: 'Route 8, Asquith', confidence: 'user-archive', status: 'played' },
  { year: '2016', date: 'Dec 09', title: 'BREAD #12', venue: 'F8', lineup: 'NA, TSVI, Dubbel Dutch', confidence: 'user-archive', status: 'played' },
  { year: '2017', date: 'Feb 24', title: 'BREAD #13 (Residents Night)', venue: 'Underground SF', lineup: 'Residents', confidence: 'user-archive', status: 'played' },
  { year: '2017', date: 'Mar 24', title: 'UGSF Night', venue: 'Underground SF', lineup: 'DJ J Heat, Kieran Loftus', confidence: 'user-archive', status: 'played' },
  { year: '2017', date: 'May 26', title: 'UGSF Night', venue: 'Underground SF', lineup: 'Mr. Mitch, Kozee', confidence: 'user-archive', status: 'played' },
  { year: '2017', date: 'Jul 28', title: 'UGSF Night', venue: 'Underground SF', lineup: 'Roska, Misoh', confidence: 'user-archive', status: 'played' },
  { year: '2017', date: 'Sep 22', title: 'UGSF Night', venue: 'Underground SF', lineup: 'Kelman Duran, Suda', confidence: 'user-archive', status: 'played' },
  { year: '2018', date: 'May 12', title: 'Final Club Night', venue: 'OMG', lineup: 'Gila, Neana', confidence: 'user-archive', status: 'played' },
  { year: '2021', date: 'Jan 02', title: 'BREAD New Year Stream', venue: 'Twitch', lineup: 'Zaida, Wonja, Color Plus, Gila', confidence: 'strong', status: 'played' },
  { year: '2021', date: 'Mar 13', title: 'Six Years of BREAD Stream', venue: 'Twitch', lineup: 'Residents-led lineup', confidence: 'strong', status: 'played' },
  { year: '2021', date: 'Jul 10', title: 'Long Bread Summer Stream', venue: 'Twitch', lineup: 'Residents + collaborators', confidence: 'strong', status: 'played' }
];

const roster = [
  { name: 'Cage A (Kanav)', role: 'Founder', links: { sc: 'https://soundcloud.com/cage_a' } },
  { name: 'Prawns', role: 'Founder', links: { sc: 'https://soundcloud.com/prawns', ig: 'https://instagram.com/_prawns' } },
  { name: 'Botaz', role: 'Resident', links: { sc: 'https://soundcloud.com/botaz', ig: 'https://instagram.com/brian_aviles' } },
  { name: 'TF1000 / Tranespotting', role: 'Resident', links: { sc: 'https://soundcloud.com/tranespotting', ig: 'https://instagram.com/tf1000_' } },
  { name: 'Adam Kraft', role: 'Resident', links: { sc: 'https://soundcloud.com/adamkraftneindanke', ig: 'https://instagram.com/adamkraft_', ra: 'https://ra.co/dj/adamkraft' } },
  { name: 'Gewzer', role: 'Resident', links: { sc: 'https://soundcloud.com/gewzer', ig: 'https://instagram.com/gewzer', bc: 'https://cyberspa.bandcamp.com/album/g-love-s' } },
  { name: 'Exteeng', role: 'Resident', links: { sc: 'https://soundcloud.com/exteeng', ig: 'https://instagram.com/exteeng', ra: 'https://ra.co/dj/exteeng' } }
];

const documentedChronology = chronology.filter((event) => event.confidence !== 'unverified');

const directoryLinks = [
  { label: 'BREAD SoundCloud ↗', href: 'https://soundcloud.com/breadfm', external: true },
  { label: 'BREAD Instagram ↗', href: 'https://instagram.com/bread_sf', external: true },
  { label: 'RA promoter page ↗', href: 'https://ra.co/promoters/50634', external: true },
  { label: 'Radio Valencia ↗', href: 'http://www.radiovalencia.fm/', external: true },
  { label: 'Channel & profile directory →', href: '/archive/channel-profile-directory/', external: false },
  { label: 'Timeline & eras →', href: '/archive/timeline/', external: false }
];

---

<BaseLayout
  title="BREAD // Confirmed Archive"
  description="Confirmed-only BREAD archive interface."
  showSiteFrame={false}
>
  <div class="bg-mark">BREAD</div>
  <header class="topline">
    <span>ARCHIVE NODE // SAN FRANCISCO</span>
    <span>DOCUMENTED HISTORY</span>
    <span>2015—2021</span>
  </header>

  <section class="shell">
    <aside class="nav-rail">
      <h1 class="wordmark">BREAD</h1>
      <p class="sub">PANORAMA VIEW<br/>DOCUMENTED HISTORY</p>
      <nav class="primary-routes" aria-label="Primary routes">
        <a href="/archive/timeline/">Timeline &amp; eras →</a>
        <a href="/archive/event-ledger/">Event ledger →</a>
        <a href="/archive/research-methods-confidence/">Methods + confidence →</a>
        <a href="/archive/narrative-history/">Narrative story →</a>
      </nav>
      <nav class="tabs" id="tabs">
        <button class="tab active" data-panel="panel-ledger">events</button>
        <button class="tab" data-panel="panel-people">people</button>
        <button class="tab" data-panel="panel-links">links</button>
      </nav>
      <p class="policy">Documented events from archive notes and links in this repository.</p>
    </aside>

    <main class="content">
      <article class="panel active" id="panel-ledger">
        <h2>Event History</h2>
        <ul class="cards">
          {documentedChronology.map((event, index) => (
            <li class="card pick" data-kind="event" data-index={index}>
              <div>
                <p class="title">{event.title}</p>
                <p class="meta">{event.year} · {event.date} · {event.venue}</p>
                <p class="lineup">{event.lineup}</p>
                <p class="status">status: {event.status}</p>
              </div>
              <span class={`confidence ${event.confidence}`}>{event.confidence}</span>
            </li>
          ))}
        </ul>
      </article>

      <article class="panel" id="panel-people">
        <h2>People</h2>
        <ul class="cards people">
          {roster.map((person, index) => (
            <li class="card pick" data-kind="person" data-index={index}>
              <div>
                <p class="title">{person.name}</p>
                <p class="meta">{person.role}</p>
              </div>
            </li>
          ))}
        </ul>
      </article>

      <article class="panel" id="panel-links">
        <h2>Where to explore next</h2>
        <ul class="route-list">
          {directoryLinks.map((item) => (
            <li>
              <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noreferrer' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
          <li><a href="/archive/research-methods-confidence/">Methods + confidence →</a></li>
          <li><a href="/archive/narrative-history/">Narrative story →</a></li>
        </ul>
      </article>
    </main>

    <aside class="deck">
      <p class="deck-tag" id="deckTag">ENTRY</p>
      <h3 id="deckTitle">SELECT ITEM</h3>
      <p id="deckData">Click an event or resident profile.</p>
      <p id="deckDesc">This panel renders documented event details and known resident links.</p>
      <div id="deckLinks" class="deck-links"></div>
    </aside>
  </section>
</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@200;300;400;600&family=JetBrains+Mono:wght@400&display=swap');
  :global(:root){--bg:#050505;--panel:#0b0b0b;--line:#242424;--text:#f3f3f3;--muted:#8e8e8e;--accent:#ff5a1f;--cyan:#b5b5b5}
  :global(body){margin:0;background:var(--bg);color:var(--text)}
  :global(main){max-width:none !important;margin:0 !important;width:100% !important;padding:0;min-height:100vh;position:relative;overflow:hidden;font-family:'Inter',sans-serif}

  .bg-mark{position:fixed;inset:0;display:flex;align-items:flex-end;justify-content:flex-end;padding:2rem;font-family:'Archivo Black',sans-serif;font-size:22vw;color:#0e0e0e;letter-spacing:-.03em;pointer-events:none;user-select:none}
  .topline{position:relative;z-index:2;display:flex;justify-content:space-between;gap:1rem;border-bottom:1px solid var(--line);padding:.55rem 1rem;font-family:'JetBrains Mono',monospace;font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:#ababab;background:#090909}

  .shell{position:relative;z-index:2;display:grid;grid-template-columns:260px minmax(620px,1fr) 340px;gap:.9rem;padding:.9rem;height:calc(100vh - 36px);max-width:1440px;margin:0 auto}
  .nav-rail,.content,.deck{border:1px solid var(--line);background:var(--panel)}

  .nav-rail{padding:1rem;display:flex;flex-direction:column;gap:.9rem}
  .wordmark{margin:0;font-family:'Archivo Black',sans-serif;font-size:2.6rem;line-height:.9;letter-spacing:-.03em;transform:scaleX(1.28);transform-origin:left center;text-transform:uppercase}
  .sub{margin:0;color:var(--muted);font-family:'Inter',sans-serif;font-weight:300;font-size:.86rem;letter-spacing:.04em;text-transform:uppercase}

  .primary-routes{display:grid;gap:.35rem;margin:.25rem 0 .1rem}
  .primary-routes a{display:block;padding:.6rem .7rem;border:1px solid #2c2c2c;color:#d8d8d8;text-decoration:none;text-transform:uppercase;font-size:.74rem;letter-spacing:.05em;background:#0d0d0d}
  .primary-routes a:hover,.primary-routes a:focus-visible{border-color:var(--accent);color:var(--accent);outline:none}

  .tabs{display:flex;flex-direction:column;gap:.2rem;margin-top:.4rem}
  .tab{background:none;border:none;color:#7b7b7b;padding:.2rem 0;font-family:'Inter',sans-serif;font-weight:200;font-size:2.05rem;letter-spacing:-.03em;cursor:pointer;text-align:left;line-height:.9;text-transform:lowercase}
  .tab.active{color:#fff}
  .tab:hover{color:var(--accent)}
  .policy{margin-top:auto;font-size:.77rem;color:#8b8b8b;line-height:1.4}

  .content{padding:1rem;overflow:hidden}
  .panel{display:none;height:100%;overflow:auto;padding-right:.3rem}
  .panel.active{display:block}
  h2{font-family:'Inter',sans-serif;font-weight:200;margin:0 0 .9rem;font-size:clamp(2.4rem,4.2vw,3.8rem);letter-spacing:-.04em;text-transform:lowercase;line-height:.9;overflow-wrap:anywhere}

  .cards{list-style:none;margin:0;padding:0;display:grid;gap:.5rem}
  .card{border:1px solid #2c2c2c;background:#0e0e0e;padding:.85rem;display:flex;justify-content:space-between;gap:.8rem;cursor:pointer;min-height:108px}
  .card:hover{border-color:var(--accent)}
  .card:focus-visible,.tab:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .title{margin:0;font-family:'Archivo Black',sans-serif;font-size:1.22rem;line-height:.96;text-transform:uppercase;letter-spacing:-.01em}
  .meta{margin:.2rem 0;font-family:'JetBrains Mono',monospace;font-size:.74rem;color:#8f8f8f;text-transform:uppercase}
  .lineup{margin:0;color:#d8d8d8}
  .status{margin:.2rem 0 0;color:#969696;font-size:.74rem;text-transform:uppercase}
  .confidence{font-family:'JetBrains Mono',monospace;border:1px solid #333;padding:.25rem .45rem;height:fit-content;font-size:.7rem;text-transform:uppercase}
  .confidence.strong{color:#93c5fd}.confidence.verified{color:#86efac}.confidence.user-archive{color:#fdba74}
  .people .card{background:#0b0b0b}

  .route-list{list-style:none;margin:0;padding:0;display:grid;gap:.45rem}
  .route-list a{display:block;padding:.8rem;border:1px solid #2c2c2c;color:#d8d8d8;text-decoration:none;text-transform:uppercase;font-size:.83rem;letter-spacing:.04em;background:#0d0d0d}
  .route-list a:hover{border-color:var(--accent);color:var(--accent)}

  .deck{padding:1rem;display:grid;gap:.65rem;align-content:start;background:#0b0b0b;overflow:auto}
  .deck-tag{margin:0;font-family:'JetBrains Mono',monospace;color:var(--accent);font-size:.7rem;letter-spacing:.12em;text-transform:uppercase}
  .deck h3{margin:0;font-family:'Inter',sans-serif;font-weight:200;font-size:2rem;line-height:.88;text-transform:lowercase;letter-spacing:-.03em}
  .deck p{margin:0;color:#b8b8b8;line-height:1.4}
  .deck-links{display:grid;gap:.4rem}
  .deck-links a{color:#ddd;text-decoration:none}

  @media (max-width: 1200px){
    .shell{grid-template-columns:220px minmax(0,1fr);height:auto;min-height:calc(100vh - 36px)}
    .deck{grid-column:1/-1}
  }
  @media (max-width: 780px){
    .topline{font-size:.6rem;flex-wrap:wrap}
    .shell{grid-template-columns:1fr;padding:.7rem;max-width:none}
    .wordmark{font-size:2.1rem}
    .tab{font-size:1.65rem}
    h2{font-size:2.2rem}
    .title{font-size:1.02rem}
  }
</style>

<script is:inline define:vars={{ documentedChronology, roster }}>
  const tabs = document.querySelectorAll('.tab');
  const panels = document.querySelectorAll('.panel');

  const deckTag = document.getElementById('deckTag');
  const deckTitle = document.getElementById('deckTitle');
  const deckData = document.getElementById('deckData');
  const deckDesc = document.getElementById('deckDesc');
  const deckLinks = document.getElementById('deckLinks');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const panelId = tab.getAttribute('data-panel');
      tabs.forEach((item) => item.classList.toggle('active', item === tab));
      panels.forEach((panel) => panel.classList.toggle('active', panel.id === panelId));
    });
  });

  function updateDeck(payload) {
    if (!deckTag || !deckTitle || !deckData || !deckDesc || !deckLinks) return;
    deckTag.textContent = payload.tag;
    deckTitle.textContent = payload.title;
    deckData.textContent = payload.data;
    deckDesc.textContent = payload.desc;
    deckLinks.innerHTML = '';
    (payload.links || []).forEach((link) => {
      const a = document.createElement('a');
      a.href = link.href;
      a.textContent = link.label;
      if (link.external) {
        a.target = '_blank';
        a.rel = 'noreferrer';
      }
      deckLinks.append(a);
    });
  }

  document.querySelectorAll('.pick').forEach((row) => {
    row.tabIndex = 0;

    row.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      row.click();
    });

    row.addEventListener('click', () => {
      const kind = row.getAttribute('data-kind');
      const index = Number(row.getAttribute('data-index') || 0);

      if (kind === 'event') {
        const event = documentedChronology[index];
        if (!event) return;
        updateDeck({
          tag: 'EVENT',
          title: event.title,
          data: `${event.year} · ${event.date} · ${event.venue}`,
          desc: `${event.lineup}. Status: ${event.status}. Confidence: ${event.confidence}.`,
          links: [{ href: '/archive/timeline/', label: 'Open timeline notes →', external: false }]
        });
        return;
      }

      if (kind === 'person') {
        const person = roster[index];
        if (!person) return;
        const links = [];
        if (person.links.sc) links.push({ href: person.links.sc, label: 'SoundCloud ↗', external: true });
        if (person.links.ig) links.push({ href: person.links.ig, label: 'Instagram ↗', external: true });
        if (person.links.ra) links.push({ href: person.links.ra, label: 'Resident Advisor ↗', external: true });
        if (person.links.bc) links.push({ href: person.links.bc, label: 'Bandcamp reference ↗', external: true });

        updateDeck({
          tag: 'PERSON',
          title: person.name,
          data: person.role,
          desc: 'Resident profile from documented archive network and profile directory entries.',
          links
        });
      }
    });
  });

</script>
