    }
  }

  @media (max-width: 780px) {
    .topline {
      font-size: 0.62rem;
      flex-wrap: wrap;
    }

    .shell {
      grid-template-columns: 1fr;
      padding: 0.7rem;
      padding-bottom: calc(6rem + env(safe-area-inset-bottom));
      max-width: none;
      min-height: auto;
    }

    .nav-rail,
    .content,
    .deck {
      border-radius: 0.7rem;
    }

    .rail-head,
    .rail-card {
      padding: 0.65rem;
    }

    .deck {
      position: fixed;
      left: 0.7rem;
      right: 0.7rem;
      bottom: calc(0.7rem + env(safe-area-inset-bottom));
      max-height: min(54vh, 28rem);
      margin: 0;
      z-index: 35;
      overflow: auto;
      box-shadow: 0 14px 30px rgb(0 0 0 / 44%);
    }

    .deck-toggle {
      display: block;
      width: 100%;
      border: 1px solid #3a3a3a;
      border-radius: 0.7rem;
      background: #0f0f0f;
      color: #f3f3f3;
      padding: 0.65rem 0.8rem;
      text-align: left;
      font-weight: 600;
      margin-bottom: 0.6rem;
      min-height: 44px;
      touch-action: manipulation;
    }

    .deck-content {
      display: none;
    }

    .deck.is-open .deck-content {
      display: grid;
      gap: 0.55rem;
    }

    h2 {
      font-size: 2.2rem;
    }

    .title {
      font-size: 1.02rem;
    }
  }

  @media (hover: none) {
    .tab:hover,
    .card:hover,
    .primary-routes :global(.card-link:hover),
    .route-list :global(.card-link:hover) {
      transform: none;
      box-shadow: none;
    }
  }

  @media (max-width: 600px) {
    .deck {
      left: 0.55rem;
      right: 0.55rem;
      bottom: calc(0.55rem + env(safe-area-inset-bottom));
    }

    .topline {
      gap: 0.35rem;
      font-size: 0.57rem;
      letter-spacing: 0.08em;
      padding-inline: max(0.75rem, env(safe-area-inset-left)) max(0.75rem, env(safe-area-inset-right));
    }

    .topline-nav {
      padding-inline: max(0.75rem, env(safe-area-inset-left)) max(0.75rem, env(safe-area-inset-right));
