---
import EventPanel from "../components/EventPanel.astro";
import AudioTabs from "../components/homepage/AudioTabs.astro";
import PeopleTab from "../components/homepage/PeopleTab.astro";
import { getHomepageData } from "../data/homepage";
import BaseLayout from "../layouts/BaseLayout.astro";

const {
	documentedChronology,
	roster,
	featuredVisuals,
	directoryLinks,
	soundcloudEmbedCollections,
	platformEmbeds,
	residentSoundcloudProfiles,
	homeStructuredData,
	buildSoundCloudEmbedSrc,
} = await getHomepageData();
---

<BaseLayout
  title="BREAD"
  description="BREAD: a San Francisco club night, fundraiser stream, and radio show, 2015–2024."
  structuredData={homeStructuredData}
  ogImage="/og/home.png"
  ogImageAlt="BREAD, San Francisco, 2015–2024"
>
  <noscript>
    <style>
      .section-tabs { display: none !important; }
      .panel { display: block !important; }
    </style>
  </noscript>

  <section class="shell" aria-labelledby="home-title">
    <header class="home-intro">
      <h1 id="home-title">BREAD</h1>
      <div class="home-intro-copy">
        <p class="eyebrow">San Francisco · 2015–2024</p>
        <p class="home-lede">Club nights, fundraiser streams, and a radio show. Lineups, flyers, and mixes from the whole run.</p>
        <div class="link-row">
          <a class="chip-link" href="/?section=audio" data-tab-link="panel-audio">Listen</a>
          <a class="chip-link" href="/story/">Read the story</a>
        </div>
      </div>
    </header>

    <nav class="section-tabs" aria-label="Browse BREAD" role="tablist">
      <button class="tab active" type="button" role="tab" aria-selected="true" aria-controls="panel-events" id="tab-events" data-panel="panel-events">Events</button>
      <button class="tab" type="button" role="tab" aria-selected="false" aria-controls="panel-people" id="tab-people" data-panel="panel-people">People</button>
      <button class="tab" type="button" role="tab" aria-selected="false" aria-controls="panel-audio" id="tab-audio" data-panel="panel-audio">Listen</button>
    </nav>

    <div class="content">
      <EventPanel visuals={featuredVisuals} events={documentedChronology} />
      <PeopleTab roster={roster} />
      <AudioTabs
        directoryLinks={directoryLinks}
        soundcloudEmbedCollections={soundcloudEmbedCollections}
        platformEmbeds={platformEmbeds}
        residentSoundcloudProfiles={residentSoundcloudProfiles}
        buildSoundCloudEmbedSrc={buildSoundCloudEmbedSrc}
      />
    </div>
  </section>
</BaseLayout>

<style is:global>
  @import url('../styles/home.css');
</style>

<script>
  import { filterEvents, sortVisibleEvents, showEventsPage, EVENTS_PER_PAGE } from '../utils/eventFilters';

  const tabList = document.querySelector<HTMLElement>('.section-tabs');
  const tabs = Array.from(document.querySelectorAll<HTMLElement>('.tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.panel'));
  const eventSearch = document.getElementById('eventSearch') as HTMLInputElement | null;
  const eventCards = Array.from(document.querySelectorAll<HTMLElement>('.cards .card[data-kind="event"]'));
  const resultCount = document.getElementById('eventsResultCount');
  const eventSort = document.getElementById('eventSort') as HTMLSelectElement | null;
  const loadMoreBtn = document.getElementById('loadMoreEvents');
  const emptyState = document.getElementById('eventsEmpty');

  let activeFilters = { year: 'all', venue: 'all', search: '', quick: 'all', sort: 'oldest' };
  let visibleEvents: HTMLElement[] = [];
  let currentPage = 1;

  function triggerHaptic(pattern = 8) {
    if ('vibrate' in navigator) navigator.vibrate(pattern);
  }

  // Show a year heading above the first visible event of each year.
  function markYearStarts() {
    let previousYear = '';
    for (const card of visibleEvents) {
      const shown = card.style.display !== 'none';
      const year = card.dataset.year ?? '';
      card.classList.toggle('year-start', shown && year !== previousYear);
      if (shown) previousYear = year;
    }
  }

  function showPage(page: number) {
    currentPage = showEventsPage(visibleEvents, page, resultCount, loadMoreBtn);
    markYearStarts();
  }

  function filterAndShowEvents() {
    for (const card of eventCards) card.classList.remove('year-start');
    visibleEvents = filterEvents(eventCards, activeFilters);
    sortVisibleEvents(visibleEvents, activeFilters.sort);
    visibleEvents.forEach((card) => card.parentElement?.appendChild(card));
    showPage(1);
    if (emptyState) emptyState.hidden = visibleEvents.length > 0;
  }

  // The tabs are sticky, so measure from the panels below them instead.
  function scrollToPanels({ always = false } = {}) {
    const content = document.querySelector<HTMLElement>('.content');
    if (!content || !tabList) return;
    const headerHeight = document.querySelector('.site-header')?.getBoundingClientRect().height ?? 0;
    const target = content.getBoundingClientRect().top + window.scrollY - headerHeight - tabList.offsetHeight;
    if (always || window.scrollY > target) window.scrollTo({ top: Math.max(target, 0) });
  }

  function activateTab(tab: HTMLElement, { focus = false, updateUrl = true } = {}) {
    const panelId = tab.dataset.panel;
    if (!panelId) return;

    tabs.forEach((item) => {
      const active = item.dataset.panel === panelId;
      item.classList.toggle('active', active);
      item.setAttribute('aria-selected', String(active));
      item.tabIndex = active ? 0 : -1;
    });

    panels.forEach((panel) => {
      const active = panel.id === panelId;
      panel.classList.toggle('active', active);
      panel.hidden = !active;
    });

    if (panelId === 'panel-audio') hydrateAudioEmbeds();
    if (focus) tab.focus();

    if (updateUrl) {
      const url = new URL(window.location.href);
      const section = panelId.replace('panel-', '');
      if (section === 'events') url.searchParams.delete('section');
      else url.searchParams.set('section', section);
      history.replaceState({}, '', url);
    }
  }

  tabs.forEach((tab, index) => {
    tab.tabIndex = tab.classList.contains('active') ? 0 : -1;
    tab.addEventListener('click', () => {
      activateTab(tab);
      scrollToPanels();
      triggerHaptic();
    });
    tab.addEventListener('keydown', (event) => {
      if (!['ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      let nextIndex = index;
      if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
      if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
      if (event.key === 'Home') nextIndex = 0;
      if (event.key === 'End') nextIndex = tabs.length - 1;
      activateTab(tabs[nextIndex], { focus: true });
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-tab-link]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const tab = tabs.find((item) => item.dataset.panel === link.dataset.tabLink);
      if (!tab) return;
      event.preventDefault();
      activateTab(tab);
      scrollToPanels({ always: true });
    });
  });

  function sanitizeClientHref(value: string | null): string | null {
    if (!value) return null;
    try {
      const parsed = new URL(value, window.location.origin);
      return ['http:', 'https:'].includes(parsed.protocol) ? value : null;
    } catch {
      return null;
    }
  }

  function loadEmbedPreview(preview: HTMLElement) {
    const src = sanitizeClientHref(preview.dataset.embedSrc ?? null);
    if (!src || preview.dataset.loaded === 'true') return;
    const iframe = document.createElement('iframe');
    iframe.title = preview.dataset.title || 'Embedded player';
    iframe.width = '100%';
    iframe.height = preview.dataset.height || '166';
    iframe.loading = 'lazy';
    iframe.src = src;
    if (preview.dataset.allow) iframe.setAttribute('allow', preview.dataset.allow);
    if (preview.dataset.sandbox) iframe.setAttribute('sandbox', preview.dataset.sandbox);
    preview.replaceChildren(iframe);
    preview.hidden = false;
    preview.dataset.loaded = 'true';
    const button = preview.closest<HTMLElement>('[data-player]')?.querySelector<HTMLButtonElement>('.load-player');
    if (button) button.hidden = true;
  }

  // Only the featured player loads with the tab; the rest wait for a tap.
  function hydrateAudioEmbeds() {
    document.querySelectorAll<HTMLElement>('.embed-preview[data-autoload]').forEach(loadEmbedPreview);
  }

  document.querySelectorAll<HTMLButtonElement>('.load-player').forEach((button) => {
    button.addEventListener('click', () => {
      const preview = button.closest<HTMLElement>('[data-player]')?.querySelector<HTMLElement>('.embed-preview');
      if (preview) loadEmbedPreview(preview);
      triggerHaptic();
    });
  });

  if (eventSearch) {
    eventSearch.addEventListener('input', () => {
      activeFilters.search = eventSearch.value;
      filterAndShowEvents();
    });
  }

  if (eventSort) {
    eventSort.addEventListener('change', () => {
      activeFilters.sort = eventSort.value;
      filterAndShowEvents();
    });
  }

  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', () => {
      showPage(currentPage + 1);
    });
  }

  function revealEventFromHash() {
    if (!window.location.hash.startsWith('#event-')) return;
    const card = document.querySelector<HTMLElement>(window.location.hash);
    if (!card) return;
    const eventsTab = tabs.find((tab) => tab.dataset.panel === 'panel-events');
    if (eventsTab) activateTab(eventsTab, { updateUrl: false });
    if (!visibleEvents.includes(card)) visibleEvents.unshift(card);
    const cardIndex = visibleEvents.indexOf(card);
    if (cardIndex >= EVENTS_PER_PAGE * currentPage) {
      showPage(Math.ceil((cardIndex + 1) / EVENTS_PER_PAGE));
    }
    card.style.display = '';
    card.scrollIntoView({ block: 'center' });
  }

  const requestedSection = new URL(window.location.href).searchParams.get('section');
  const requestedTab = tabs.find((tab) => tab.dataset.panel === `panel-${requestedSection}`);
  if (requestedTab) activateTab(requestedTab, { updateUrl: false });

  filterAndShowEvents();
  revealEventFromHash();
  window.addEventListener('hashchange', revealEventFromHash);
</script>
