---
import BaseLayout from '../layouts/BaseLayout.astro';
import CardLink from '../components/CardLink.astro';
import {
  createCollectionPageSchema,
  createEventSchema,
  createItemListSchema,
  createWebsiteSchema
} from '../utils/structuredData';
import { getCollection } from 'astro:content';

const events = (await getCollection('events'))
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const roster = (await getCollection('roster'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((person) => ({
    name: person.data.name,
    role: person.data.role,
    notes: person.data.notes,
    links: person.data.links
  }));

const documentedChronology = events
  .filter((event) => event.data.confidence !== 'unverified')
  .map((event) => ({
    id: event.id,
    title: event.data.title,
    year: event.data.year,
    date: new Date(event.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }),
    venue: event.data.venue,
    lineup: event.data.lineup,
    confidence: event.data.confidence,
    status: event.data.status,
    source: event.data.sourceHref
      ? { label: event.data.sourceLabel || 'Source', href: event.data.sourceHref, external: event.data.sourceExternal }
      : { label: event.data.sourceLabel || 'Archive notes (link coming soon)' }
  }));

// Event source directory removed - now using content collections

// documentedChronology now built from content collections above
const hasMeaningfulStatus = (event: (typeof chronology)[number]) => event.status && event.status !== 'played';
const activeYears = new Set(documentedChronology.map((event) => event.year)).size;
const sourceLinkedEvents = documentedChronology.filter((event) => Boolean(event.source.href)).length;
const summaryStats = [
  { label: 'Events listed', value: documentedChronology.length },
  { label: 'Years active', value: activeYears },
  { label: 'Events with links', value: sourceLinkedEvents },
  { label: 'Residents', value: roster.length }
];

const featuredVisuals = [
  {
    src: '/drive/bread-x-grime-city_150213-show.png',
    alt: 'BREAD x Grime City flyer featuring Nevermind and Helix',
    title: 'Pilot flyer · February 2015',
    caption: 'BREAD x Grime City at F8',
    href: '/archive/flyers/'
  },
  {
    src: '/drive/bread2-smaller.jpg',
    alt: 'BREAD #2 flyer with chain and blue artwork treatment',
    title: 'BREAD #2 flyer',
    caption: 'Rabit, Sheen, Korma, Lyeform',
    href: '/archive/flyers/'
  },
  {
    src: '/drive/2015-07-19-08.54.27.jpg',
    alt: 'Street photo of a BREAD #2 poster on a San Francisco utility pole',
    title: 'Street placement',
    caption: 'Poster in the wild, San Francisco',
    href: '/story/'
  },
  {
    src: '/drive/img_0530.jpg',
    alt: 'Party photo showing three attendees at a BREAD event',
    title: 'Party photo',
    caption: 'From the venue photo archive',
    href: '/story/'
  }
];

const directoryLinks = [
  { label: 'BREAD SoundCloud ↗', href: 'https://soundcloud.com/breadfm', external: true },
  { label: 'IPR show page ↗', href: 'https://www.internetpublicradio.live/shows/bread-fm', external: true },
  { label: 'Flyer gallery →', href: '/archive/flyers/', external: false },
  { label: 'Radio shows gallery →', href: '/archive/radio-shows/', external: false },
  { label: 'Featured mix (Prawns + Botaz, 2023-04-26) ↗', href: 'https://soundcloud.com/breadfm/bread-fm-on-internet-public-radio-prawns-botaz-04262023', external: true },
  { label: 'BREAD Instagram ↗', href: 'https://instagram.com/bread_sf', external: true },
  { label: 'BREAD X / Twitter ↗', href: 'https://x.com/breadsf', external: true },
  { label: 'RA promoter page ↗', href: 'https://ra.co/promoters/51043', external: true },
  { label: 'Radio Valencia ↗', href: 'http://www.radiovalencia.fm/', external: true },
  { label: 'Links →', href: '/archive/channel-profile-directory/', external: false },
  { label: 'Timeline →', href: '/archive/timeline/', external: false },
  { label: 'Read the story →', href: '/story/', external: false },
  { label: 'Journal posts →', href: '/blog/', external: false }
];

const soundcloudEmbedCollections = [
  {
    title: 'BREAD profile stream',
    description: 'Main feed with uploads and mixes.',
    href: 'https://soundcloud.com/breadfm',
    height: 420,
    visual: true
  },
  {
    title: 'BREAD playlists',
    description: 'Curated playlists and series.',
    href: 'https://soundcloud.com/breadfm/sets',
    height: 300,
    visual: false
  },
  {
    title: 'BREAD likes',
    description: 'Tracks the crew has been into.',
    href: 'https://soundcloud.com/breadfm/likes',
    height: 300,
    visual: false
  },
  {
    title: 'BREAD reposts',
    description: 'Reposts from friends and collaborators.',
    href: 'https://soundcloud.com/breadfm/reposts',
    height: 300,
    visual: false
  }
];

const platformEmbeds = {
  ipr: {
    title: 'Internet Public Radio episode',
    href: 'https://www.internetpublicradio.live/episodes/bread-fm-w-botaz-shl-28th-september-2022',
    src: 'https://player-widget.mixcloud.com/widget/iframe/?hide_cover=0&mini=0&light=1&feed=%2Finternetpublicradio%2Fbread-fm-w-botaz-shl-28th-september-2022%2F',
    height: 120
  },
  appleShow: {
    title: 'Apple Podcasts show',
    href: 'https://podcasts.apple.com/us/podcast/bread-fm/id1227134378',
    src: 'https://embed.podcasts.apple.com/us/podcast/bread-fm/id1227134378',
    height: 450
  },
  appleEpisode: {
    title: 'Apple Podcasts episode (Prawns + Botaz live)',
    href: 'https://podcasts.apple.com/us/podcast/bread-fm-on-internet-public-radio-prawns-botaz-live/id1227134378?i=1000610844660',
    src: 'https://embed.podcasts.apple.com/us/podcast/bread-fm-on-internet-public-radio-prawns-botaz-live/id1227134378?i=1000610844660',
    height: 450
  },
  facebook: {
    title: 'Facebook page',
    href: 'https://www.facebook.com/breadfm/',
    src: 'https://www.facebook.com/plugins/page.php?href=https%3A%2F%2Fwww.facebook.com%2Fbreadfm%2F&tabs=timeline&width=500&height=540&small_header=false&adapt_container_width=true&hide_cover=false&show_facepile=true&appId',
    height: 540
  }
};

const residentSoundcloudProfiles = roster
  .filter((person): person is (typeof roster)[number] & { links: { sc: string } } => Boolean(person.links.sc))
  .map((person) => ({
    name: person.name,
    role: person.role,
    href: person.links.sc
  }));



const monthMap: Record<string, number> = {
  Jan: 1,
  Feb: 2,
  Mar: 3,
  Apr: 4,
  May: 5,
  Jun: 6,
  Jul: 7,
  Aug: 8,
  Sep: 9,
  Oct: 10,
  Nov: 11,
  Dec: 12
};

const toIsoDate = (year: string, shortDate: string): string | undefined => {
  const [monthLabel, dayRaw] = shortDate.split(' ');
  const month = monthMap[monthLabel];
  const day = Number(dayRaw);
  if (!month || Number.isNaN(day)) return undefined;

  return `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
};

const mapEventStatus = (status: string): string | undefined => {
  if (status.includes('canceled')) return 'https://schema.org/EventCancelled';
  if (status === 'played') return 'https://schema.org/EventCompleted';
  return undefined;
};

const eventSchemas = documentedChronology
  .map((event, index) => {
    const startDate = toIsoDate(event.year, event.date);
    if (!startDate) return undefined;

    return createEventSchema({
      site: Astro.site,
      pagePathname: Astro.url.pathname,
      position: index + 1,
      name: event.title,
      startDate,
      venueName: event.venue,
      description: event.lineup,
      status: mapEventStatus(event.status)
    });
  })
  .filter((entry): entry is Record<string, unknown> => Boolean(entry));

const homeStructuredData = [
  createWebsiteSchema({
    site: Astro.site,
    name: 'BREAD',
    description: 'BREAD history, flyers, and listening links.'
  }),
  createCollectionPageSchema({
    site: Astro.site,
    pathname: Astro.url.pathname,
    name: 'BREAD Home',
    description: 'Main page for the timeline, residents, visuals, and listening links.',
    isPartOf: 'BREAD'
  }),
  createItemListSchema({
    name: 'BREAD Events',
    description: 'Event timeline shown on the BREAD homepage.',
    itemListElement: eventSchemas
  })
].filter((entry): entry is Record<string, unknown> => Boolean(entry));

const buildSoundCloudEmbedSrc = (href: string, visual = false) => {
  const params = new URLSearchParams({
    url: href,
    color: '#ff5a1f',
    auto_play: 'false',
    hide_related: 'false',
    show_comments: 'true',
    show_user: 'true',
    show_reposts: 'true',
    show_teaser: 'true',
    visual: visual ? 'true' : 'false'
  });

  return `https://w.soundcloud.com/player/?${params.toString()}`;
};

---

<BaseLayout
  title="BREAD"
  description="Timeline, people, visuals, and listening links from BREAD."
  showSiteFrame={false}
  structuredData={homeStructuredData}
  ogImage="/og/home.svg"
  ogImageAlt="BREAD home page with timeline, people, and listening links"
>
  <div class="bg-mark">BREAD</div>
  <div class="top-chrome">
    <header class="topline">
      <span>BREAD // SAN FRANCISCO</span>
      <span>2015—2024</span>
    </header>

        <nav class="topline-nav" aria-label="Primary routes">
          <a href="/" aria-current="page">Home</a>
          <a href="/archive/">Archive</a>
          <a href="/archive/flyers/">Flyers</a>
          <a href="/archive/radio-shows/">Radio shows</a>
          <a href="/archive/timeline/">Timeline</a>
          <a href="/story/">Story</a>
        </nav>
  </div>

  <a class="skip-link-home" href="#home-main">Skip to content</a>

  <section class="shell">
    <aside class="nav-rail">
      <div class="rail-head">
        <h1 class="wordmark">BREAD</h1>
      </div>
      <section class="snapshot rail-card" aria-label="At a glance">
        <p class="snapshot-title">At a glance</p>
        <ul class="snapshot-list">
          {summaryStats.map((item) => (
            <li>
              <span class="snapshot-value">{item.value}</span>
              <span class="snapshot-label">{item.label}</span>
            </li>
          ))}
        </ul>
      </section>
      <section class="route-start rail-card" aria-label="Quick links">
        <p class="route-start-title">Quick links</p>
        <p class="route-start-copy">Jump into the archive or read the story.</p>
        <nav class="primary-routes" aria-label="Quick links">
          <CardLink href="/archive/" label="Explore archive →" />
          <CardLink href="/archive/flyers/" label="Flyers →" />
          <CardLink href="/archive/radio-shows/" label="Radio shows →" />
          <CardLink href="/story/" label="Read the story →" />
          <CardLink href="/archive/timeline/" label="Timeline →" />
          <CardLink href="/archive/event-ledger/" label="Event list →" />
          <CardLink href="/archive/people-network/" label="People →" />
          <CardLink href="/archive/venues-format-shifts/" label="Venues →" />
        </nav>
      </section>
      <nav class="tabs rail-card" id="tabs">
        <p class="tabs-title">Pick a section</p>
        <div class="tablist" role="tablist" aria-label="Sections">
          <button class="tab active" role="tab" aria-selected="true" aria-controls="panel-events" id="tab-events" data-panel="panel-events">events</button>
          <button class="tab" role="tab" aria-selected="false" aria-controls="panel-people" id="tab-people" data-panel="panel-people">people</button>
          <button class="tab" role="tab" aria-selected="false" aria-controls="panel-audio" id="tab-audio" data-panel="panel-audio">audio</button>
          <button class="tab" role="tab" aria-selected="false" aria-controls="panel-links" id="tab-links" data-panel="panel-links">links</button>
        </div>
      </nav>
    </aside>

    <main id="home-main" class="content">
      <article class="panel active" id="panel-events" role="tabpanel" aria-labelledby="tab-events">
        <h2>Events</h2>
        <p class="result-count" id="eventsResultCount">{documentedChronology.length} events shown</p>
        <p class="events-intro">Each card shows date, series, venue, lineup, and where the info came from.</p>
        <p class="click-hint"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="vertical-align:-0.125em;margin-right:0.3em"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg> Click any event or person card to see details in the side panel.</p>
        <div class="events-toolbar" aria-label="Filter and search events">
          <div class="search-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
            <input type="search" id="eventSearch" placeholder="Filter events..." aria-label="Filter events by title, venue, or lineup" />
          </div>
          <div class="filter-chips" id="yearFilters"></div>
          <div class="filter-chips" id="venueFilters"></div>
        </div>
        <section class="featured-visuals" aria-label="Featured visuals">
          <div class="featured-visuals-head">
            <h3>Flyers + photos</h3>
            <p>A few flyer and party photos from the archive.</p>
          </div>
          <ul class="featured-visual-grid">
            {featuredVisuals.map((item) => (
              <li>
                <figure>
                  <img src={item.src} alt={item.alt} loading="eager" decoding="sync" />
                  <figcaption>
                    <p>{item.title}</p>
                    <small>{item.caption}</small>
                    <a href={item.href}>Open related archive →</a>
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </section>
        <ul class="cards">
           {documentedChronology.map((event, index) => (
             <li class="card" id={`event-${index + 1}`} data-kind="event" data-index={index} data-year={event.year} data-venue={event.venue} data-lineup={event.lineup}>
               <button class="pick-btn" data-kind="event" data-index={index} aria-label={`Open info for ${event.title}`}>
                 <div>
                   <div class="card-header">
                     <p class="title">{event.title}</p>
                     <span class={`status-badge status-${event.status}`}>{event.status}</span>
                   </div>
                   <p class="meta">{event.year} · {event.date} · {event.venue}</p>
                   <p class="lineup">{event.lineup}</p>
                 </div>
               </button>
               <div class="card-footer">
                 {event.source.href ? (
                   <p class="status source-row">source: <a href={event.source.href} target={event.source.external ? '_blank' : undefined} rel={event.source.external ? 'noreferrer noopener' : undefined}>{event.source.label}</a></p>
                 ) : (
                   <p class="status source-row">source: {event.source.label}</p>
                 )}
                 <div class="share-buttons" data-url={`/events/${event.id}`} data-title={event.title}>
                    <button class="share-btn" data-platform="copy" aria-label="Copy link">Copy</button>
                    <button class="share-btn" data-platform="twitter" aria-label="Share on Twitter">X</button>
                 </div>
               </div>
             </li>
            ))}
        </ul>
        <div class="load-more-container">
          <button class="chip" type="button" id="loadMoreEvents">Load more events</button>
        </div>
      </article>

      <article class="panel" id="panel-people" role="tabpanel" aria-labelledby="tab-people" hidden>
        <h2>People</h2>
        <p class="click-hint"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="vertical-align:-0.125em;margin-right:0.3em"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></svg> Click any person card to see details in the side panel.</p>
        <ul class="cards people">
          {roster.map((person, index) => (
            <li class="card" data-kind="person" data-index={index}>
              <button class="pick-btn" data-kind="person" data-index={index} aria-label={`Open links for ${person.name}`}>
                <div>
                  <p class="title">{person.name}</p>
                  <p class="meta">{person.role}</p>
                  {person.notes && <p class="lineup">{person.notes}</p>}
                </div>
              </button>
              <div class="person-links">
                {person.links.sc && (
                  <a href={person.links.sc} class="person-link" target="_blank" rel="noreferrer noopener" aria-label={`${person.name} SoundCloud`}>SC ↗</a>
                )}
                {person.links.ig && (
                  <a href={person.links.ig} class="person-link" target="_blank" rel="noreferrer noopener" aria-label={`${person.name} Instagram`}>IG ↗</a>
                )}
                {person.links.ra && (
                  <a href={person.links.ra} class="person-link" target="_blank" rel="noreferrer noopener" aria-label={`${person.name} Resident Advisor`}>RA ↗</a>
                )}
              </div>
            </li>
          ))}
        </ul>
      </article>

      <article class="panel" id="panel-links" role="tabpanel" aria-labelledby="tab-links" hidden>
        <h2>More links</h2>
        <ul class="route-list">
          {directoryLinks.map((item) => (
            <li>
              <CardLink href={item.href} label={item.label} external={item.external} />
            </li>
          ))}
        </ul>
      </article>

      <article class="panel" id="panel-audio" role="tabpanel" aria-labelledby="tab-audio" hidden>
        <h2>Listen</h2>
        <p class="audio-intro">Listen to BREAD uploads, playlists, and resident pages. Players load automatically when you open this tab.</p>
        <div class="audio-actions">
          <span class="chip" style="opacity:0.6; cursor:default;">Players auto-load</span>
          <a href="https://soundcloud.com/breadfm" target="_blank" rel="noreferrer noopener">Open BREAD profile ↗</a>
        </div>
        <ul class="audio-grid">
          {soundcloudEmbedCollections.map((item) => (
            <li class="audio-card">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <iframe
                title={item.title}
                width="100%"
                height={item.height}
                allow="autoplay"
                loading="lazy"
                src="about:blank"
                data-embed-src={buildSoundCloudEmbedSrc(item.href, item.visual)}
              ></iframe>
              <a href={item.href} target="_blank" rel="noreferrer noopener">Open on SoundCloud ↗</a>
            </li>
          ))}
        </ul>
        <section class="resident-audio" aria-label="Resident channels">
          <h3>Resident pages</h3>
          <p class="resident-audio-copy">Quick player cards for each resident profile in this archive.</p>
          <ul class="resident-audio-grid">
            {residentSoundcloudProfiles.map((profile) => (
              <li>
                <h4>{profile.name}</h4>
                <p>{profile.role}</p>
                <iframe
                  title={`${profile.name} SoundCloud profile`}
                  width="100%"
                  height="166"
                  allow="autoplay"
                  loading="lazy"
                  src="about:blank"
                  data-embed-src={buildSoundCloudEmbedSrc(profile.href, false)}
                ></iframe>
                <a href={profile.href} target="_blank" rel="noreferrer noopener">Visit profile ↗</a>
              </li>
            ))}
          </ul>
        </section>
        <section class="platform-embeds" aria-label="Other players">
          <h3>Other players</h3>
          <p class="resident-audio-copy">More listening spots: Internet Public Radio, Apple Podcasts, and Facebook. Instagram and RA are linked in the links tab.</p>
          <ul class="audio-grid">
            <li class="audio-card">
              <h4>{platformEmbeds.ipr.title}</h4>
              <iframe
                title={platformEmbeds.ipr.title}
                width="100%"
                height={platformEmbeds.ipr.height}
                loading="lazy"
                src="about:blank"
                data-embed-src={platformEmbeds.ipr.src}
              ></iframe>
              <a href={platformEmbeds.ipr.href} target="_blank" rel="noreferrer noopener">Open IPR episode ↗</a>
            </li>
            <li class="audio-card">
              <h4>{platformEmbeds.appleShow.title}</h4>
              <iframe
                title={platformEmbeds.appleShow.title}
                width="100%"
                height={platformEmbeds.appleShow.height}
                loading="lazy"
                allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write"
                sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-top-navigation-by-user-activation"
                src="about:blank"
                data-embed-src={platformEmbeds.appleShow.src}
              ></iframe>
              <a href={platformEmbeds.appleShow.href} target="_blank" rel="noreferrer noopener">Open Apple show ↗</a>
            </li>
            <li class="audio-card">
              <h4>{platformEmbeds.appleEpisode.title}</h4>
              <iframe
                title={platformEmbeds.appleEpisode.title}
                width="100%"
                height={platformEmbeds.appleEpisode.height}
                loading="lazy"
                allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write"
                sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-top-navigation-by-user-activation"
                src="about:blank"
                data-embed-src={platformEmbeds.appleEpisode.src}
              ></iframe>
              <a href={platformEmbeds.appleEpisode.href} target="_blank" rel="noreferrer noopener">Open Apple episode ↗</a>
            </li>
            <li class="audio-card">
              <h4>{platformEmbeds.facebook.title}</h4>
              <iframe
                title={platformEmbeds.facebook.title}
                width="100%"
                height={platformEmbeds.facebook.height}
                loading="lazy"
                allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
                src="about:blank"
                data-embed-src={platformEmbeds.facebook.src}
              ></iframe>
              <a href={platformEmbeds.facebook.href} target="_blank" rel="noreferrer noopener">Open Facebook page ↗</a>
            </li>
          </ul>
        </section>
      </article>
    </main>

    <aside class="deck" id="detailDeck" aria-live="polite">
      <button class="deck-toggle" type="button" id="deckToggle" aria-expanded="false" aria-controls="deckContent">Show info</button>
      <div id="deckContent" class="deck-content">
      <p class="deck-tag" id="deckTag">Info</p>
      <h3 id="deckTitle">Pick a card</h3>
      <p id="deckData">Choose an event or resident.</p>
      <p id="deckDesc">Dates, venue, lineup, and links show here.</p>
      <div id="deckLinks" class="deck-links"></div>
      </div>
    </aside>
  </section>

  <footer class="home-footer" aria-label="Site footer">
    <p>BREAD archive • San Francisco and beyond</p>
    <nav aria-label="Footer routes">
      <a href="/">Home</a>
      <a href="/archive/">Archive</a>
      <a href="/archive/flyers/">Flyers</a>
      <a href="/archive/radio-shows/">Radio shows</a>
      <a href="/archive/timeline/">Timeline</a>
      <a href="/story/">Story</a>
    </nav>
  </footer>
</BaseLayout>

<style>
  :global(main) {
    max-width: none !important;
    width: 100% !important;
    min-height: 100vh;
    margin: 0 !important;
    padding: 0;
    position: relative;
    overflow: hidden;
  }

  .bg-mark {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 1.25rem;
