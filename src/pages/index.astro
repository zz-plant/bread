---

<BaseLayout title="BREAD // Archive" description="BREAD archive with full known chronology, roster, and source-confidence framing.">
  <div class="bg-watermark" id="bgText">BREAD</div>

  <header class="pivot" id="pivotContainer">
    <button class="pivot-item active" data-tab="chronology">chronology</button>
    <button class="pivot-item" data-tab="roster">roster</button>
    <button class="pivot-item" data-tab="manifesto">manifesto</button>
  </header>

  <section class="viewport">
    <article class="panel active" id="panel-chronology">
      <h1>Chronology</h1>
      <p class="lede">Complete known event ledger from current in-repo research + canonical notes, including unlisted/canceled claims when present.</p>
      <ul class="event-list">
        {chronology.map((event) => (
          <li>
            <div>
              <p class="event-title">{event.title}</p>
              <p class="event-meta">{event.year} · {event.date} · {event.venue}</p>
              <p class="event-lineup">{event.lineup}</p>
              <p class="event-status">status: {event.status}</p>
            </div>
            <span class={`badge ${event.confidence}`}>{event.confidence}</span>
          </li>
        ))}
      </ul>
      <p class="links"><a href="/archive/timeline/">Open full timeline notes →</a></p>
    </article>

    <article class="panel" id="panel-roster">
      <h1>Roster</h1>
      <p class="lede">Founders and resident ecosystem from in-repo archive research.</p>
      <div class="roster-grid">
        {roster.map((person) => (
          <div class="card">
            <p class="event-title">{person.name}</p>
            <p class="event-meta">{person.role}</p>
            <p class="links">
              {person.links.sc && <a href={person.links.sc} target="_blank">SoundCloud</a>}
              {person.links.ig && <a href={person.links.ig} target="_blank">Instagram</a>}
            </p>
          </div>
        ))}
      </div>
      <p class="links"><a href="/archive/people-network/">Open people + network page →</a></p>
    </article>

    <article class="panel" id="panel-manifesto">
      <h1>Manifesto</h1>
      <p class="big-quote"><span>BREAD</span> was a glitch in San Francisco's monoculture.</p>
      <p class="lede">The archive favors verifiable claims over mythmaking. The narrative is preserved, but each claim is tracked by source confidence.</p>
      <ul class="confidence-list">
        {confidenceInfo.map((item) => (
          <li>
            <strong>{item.label}</strong>
            <span>{item.text}</span>
          </li>
        ))}
      </ul>
      <p class="lede">Known cleanup preserved: over-specific ticket-price claims and unsupported biographical assertions remain excluded unless directly sourced.</p>
      <p class="links">
        <a href="/archive/research-methods-confidence/">Methods + confidence</a>
        <a href="/archive/channel-profile-directory/">Channel directory</a>
        <a href="/blog/the-story-of-bread/">Narrative story</a>
      </p>
    </article>
  </section>
</BaseLayout>

<style>
  :global(:root){--bg:#000;--text:#fff;--dim:#8a8a8a;--accent:#f04e23}
  :global(body){background:#000;color:#fff}
  :global(main){max-width:none;padding:0;position:relative;min-height:100vh;overflow:hidden}
  .bg-watermark{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;font-size:28vw;font-weight:800;color:#090909;pointer-events:none;z-index:0}
  .pivot{position:relative;z-index:2;display:flex;gap:2rem;padding:2.5rem 3rem 0}
  .pivot-item{background:none;border:none;color:var(--dim);font-size:2.2rem;font-weight:300;cursor:pointer}
  .pivot-item.active{color:var(--text)}
  .viewport{position:relative;z-index:2;padding:2rem 3rem 3rem;max-width:960px}
  .panel{display:none;max-height:75vh;overflow:auto;padding-right:1rem}
  .panel.active{display:block}
  h1{font-size:3rem;font-weight:300;margin:0 0 .25rem}
  .lede{color:#b2b2b2;max-width:70ch}
  .event-list{list-style:none;padding:0;margin:1.25rem 0;display:grid;gap:.85rem}
  .event-list li{display:flex;justify-content:space-between;gap:1rem;padding:.9rem 0;border-bottom:1px solid #1f1f1f}
  .event-title{font-size:1.35rem;line-height:1.2;margin:0}
  .event-meta{font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;color:#7d7d7d;margin:.25rem 0}
  .event-lineup{margin:0;color:#d2d2d2}
  .event-status{margin:.3rem 0 0;color:#9ca3af;font-size:.72rem;text-transform:uppercase;letter-spacing:.07em}
  .badge{font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;padding:.3rem .5rem;border:1px solid #333;height:fit-content}
  .badge.strong{color:#93c5fd}.badge.verified{color:#86efac}.badge.unverified{color:#fca5a5}.badge.user-archive{color:#fdba74}
  .roster-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:.9rem;margin:1rem 0}
  .card{border:1px solid #202020;background:#0b0b0b;padding:1rem}
  .links{display:flex;gap:1rem;flex-wrap:wrap}
  .big-quote{font-size:2.25rem;line-height:1.05;max-width:20ch}.big-quote span{color:var(--accent)}
  .confidence-list{list-style:none;padding:0;margin:1rem 0;display:grid;gap:.7rem}
  .confidence-list li{display:grid;gap:.2rem;border-left:2px solid #2a2a2a;padding-left:.75rem}
  a{color:#ddd} a:hover{color:var(--accent)}
  @media (max-width: 700px){.pivot{padding:1rem 1rem 0;gap:.75rem;flex-wrap:wrap}.pivot-item{font-size:1.5rem}.viewport{padding:1rem}.panel{max-height:80vh}h1{font-size:2rem}}
</style>

<script>
  const items = document.querySelectorAll('.pivot-item');
  const panels = document.querySelectorAll('.panel');
  const bgText = document.getElementById('bgText');

  items.forEach((item) => {
    item.addEventListener('click', () => {
      const tab = item.getAttribute('data-tab') || 'chronology';
      items.forEach((i) => i.classList.remove('active'));
      item.classList.add('active');
      panels.forEach((panel) => panel.classList.toggle('active', panel.id === `panel-${tab}`));
      if (bgText) bgText.textContent = tab.toUpperCase();
    });
  });

  document.addEventListener('mousemove', (e) => {
    if (!bgText) return;
    const x = (e.clientX / window.innerWidth - 0.5) * 25;
    const y = (e.clientY / window.innerHeight - 0.5) * 25;
    bgText.style.transform = `translate(${x}px, ${y}px)`;
  });
</script>
