            </li>
          </ul>
        </section>
      </article>
    </main>

    <aside class="deck" id="detailDeck" aria-live="polite">
      <button class="deck-toggle" type="button" id="deckToggle" aria-expanded="false" aria-controls="deckContent">Show info</button>
