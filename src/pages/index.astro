    role: person.role,
    href: person.links.sc
  }));



const monthMap: Record<string, number> = {
  Jan: 1,
  Feb: 2,
  Mar: 3,
  Apr: 4,
  May: 5,
  Jun: 6,
  Jul: 7,
  Aug: 8,
  Sep: 9,
  Oct: 10,
  Nov: 11,
  Dec: 12
};

const toIsoDate = (year: string, shortDate: string): string | undefined => {
  const [monthLabel, dayRaw] = shortDate.split(' ');
  const month = monthMap[monthLabel];
  const day = Number(dayRaw);
  if (!month || Number.isNaN(day)) return undefined;

  return `${year}-${String(month).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
};

const mapEventStatus = (status: string): string | undefined => {
  if (status.includes('canceled')) return 'https://schema.org/EventCancelled';
  if (status === 'played') return 'https://schema.org/EventCompleted';
  return undefined;
};

const eventSchemas = documentedChronology
  .map((event, index) => {
    const startDate = toIsoDate(event.year, event.date);
    if (!startDate) return undefined;

    return createEventSchema({
      site: Astro.site,
      pagePathname: Astro.url.pathname,
      position: index + 1,
      name: event.title,
      startDate,
      venueName: event.venue,
      description: event.lineup,
      status: mapEventStatus(event.status)
    });
  })
  .filter((entry): entry is Record<string, unknown> => Boolean(entry));

const homeStructuredData = [
  createWebsiteSchema({
    site: Astro.site,
    name: 'BREAD',
    description: 'BREAD history, flyers, and listening links.'
  }),
  createCollectionPageSchema({
    site: Astro.site,
    pathname: Astro.url.pathname,
    name: 'BREAD Home',
    description: 'Main page for the timeline, residents, visuals, and listening links.',
    isPartOf: 'BREAD'
  }),
  createItemListSchema({
    name: 'BREAD Events',
    description: 'Event timeline shown on the BREAD homepage.',
    itemListElement: eventSchemas
  })
].filter((entry): entry is Record<string, unknown> => Boolean(entry));

const buildSoundCloudEmbedSrc = (href: string, visual = false) => {
  const params = new URLSearchParams({
    url: href,
    color: '#ff5a1f',
    auto_play: 'false',
    hide_related: 'false',
    show_comments: 'true',
    show_user: 'true',
    show_reposts: 'true',
    show_teaser: 'true',
    visual: visual ? 'true' : 'false'
  });

  return `https://w.soundcloud.com/player/?${params.toString()}`;
};

---

<BaseLayout
  title="BREAD"
  description="Timeline, people, visuals, and listening links from BREAD."
  showSiteFrame={false}
  structuredData={homeStructuredData}
  ogImage="/og/home.svg"
  ogImageAlt="BREAD home page with timeline, people, and listening links"
>
  <div class="bg-mark">BREAD</div>
  <div class="top-chrome">
    <header class="topline">
      <span>BREAD // SAN FRANCISCO</span>
      <span>2015—2024</span>
    </header>

    <nav class="topline-nav" aria-label="Primary routes">
      <a href="/" aria-current="page">Home</a>
      <a href="/archive/">Archive</a>
      <a href="/archive/flyers/">Flyers</a>
      <a href="/archive/radio-shows/">Radio shows</a>
      <a href="/archive/timeline/">Timeline</a>
      <a href="/story/">Story</a>
      <a href="/blog/">Journal</a>
    </nav>
  </div>

  <a class="skip-link-home" href="#home-main">Skip to content</a>

  <section class="shell">
    <aside class="nav-rail">
      <div class="rail-head">
        <h1 class="wordmark">BREAD</h1>
      </div>
      <section class="snapshot rail-card" aria-label="At a glance">
        <p class="snapshot-title">At a glance</p>
        <ul class="snapshot-list">
          {summaryStats.map((item) => (
            <li>
              <span class="snapshot-value">{item.value}</span>
              <span class="snapshot-label">{item.label}</span>
            </li>
          ))}
        </ul>
      </section>
      <section class="route-start rail-card" aria-label="Quick links">
        <p class="route-start-title">Quick links</p>
        <p class="route-start-copy">Jump into the archive or read the story.</p>
        <nav class="primary-routes" aria-label="Quick links">
          <CardLink href="/archive/" label="Explore archive →" />
          <CardLink href="/archive/flyers/" label="Flyers →" />
          <CardLink href="/archive/radio-shows/" label="Radio shows →" />
          <CardLink href="/story/" label="Read the story →" />
          <CardLink href="/blog/" label="Browse journal →" />
          <CardLink href="/archive/timeline/" label="Timeline →" />
          <CardLink href="/archive/event-ledger/" label="Event list →" />
          <CardLink href="/archive/people-network/" label="People →" />
          <CardLink href="/archive/venues-format-shifts/" label="Venues →" />
        </nav>
      </section>
      <nav class="tabs rail-card" id="tabs">
        <p class="tabs-title">Pick a section</p>
        <div class="tablist" role="tablist" aria-label="Sections">
          <button class="tab active" role="tab" aria-selected="true" aria-controls="panel-events" id="tab-events" data-panel="panel-events">events</button>
          <button class="tab" role="tab" aria-selected="false" aria-controls="panel-people" id="tab-people" data-panel="panel-people">people</button>
          <button class="tab" role="tab" aria-selected="false" aria-controls="panel-audio" id="tab-audio" data-panel="panel-audio">audio</button>
          <button class="tab" role="tab" aria-selected="false" aria-controls="panel-links" id="tab-links" data-panel="panel-links">links</button>
        </div>
      </nav>
    </aside>

    <main id="home-main" class="content">
      <article class="panel active" id="panel-events" role="tabpanel" aria-labelledby="tab-events">
        <h2>Events</h2>
        <p class="result-count" id="eventsResultCount">{documentedChronology.length} events shown</p>
        <p class="events-intro">Each card shows date, series, venue, lineup, and where the info came from.</p>
        <section class="featured-visuals" aria-label="Featured visuals">
          <div class="featured-visuals-head">
            <h3>Flyers + photos</h3>
            <p>A few flyer and party photos from the archive.</p>
          </div>
          <ul class="featured-visual-grid">
            {featuredVisuals.map((item) => (
              <li>
                <figure>
                  <img src={item.src} alt={item.alt} loading="lazy" decoding="async" />
                  <figcaption>
                    <p>{item.title}</p>
                    <small>{item.caption}</small>
                    <a href={item.href}>Open related archive →</a>
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </section>
        <ul class="cards">
          {documentedChronology.map((event, index) => (
            <li class="card" id={`event-${index + 1}`} data-kind="event" data-index={index}>
              <button class="pick-btn" data-kind="event" data-index={index} aria-label={`Open info for ${event.title}`}>
                <div>
                  <p class="title">{event.title}</p>
                  <p class="meta">{event.year} · {event.date} · {event.venue}</p>
                  <p class="lineup">{event.lineup}</p>
                  {hasMeaningfulStatus(event) && <p class="status">status: {event.status}</p>}
                </div>
              </button>
              {event.source.href ? (
                <p class="status source-row">source: <a href={event.source.href} target={event.source.external ? '_blank' : undefined} rel={event.source.external ? 'noreferrer noopener' : undefined}>{event.source.label}</a></p>
              ) : (
                <p class="status source-row">source: {event.source.label}</p>
              )}
            </li>
          ))}
        </ul>
      </article>

