---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Bread" description="Bread static site starter with Astro, skills, and MCP-ready workflows.">
  <h1>Bread static site</h1>
  <p>This repository now includes a working Astro baseline for publishing content.</p>

  <h2>Recent posts</h2>
  <ul>
    {
      posts.map((post) => (
        <li>
          <a href={`/blog/${post.id.replace(/\.md$/, '')}/`}>{post.data.title}</a>
          <p>{post.data.description}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
