</style>

<script is:inline define:vars={{ documentedChronology, roster }}>
  const tabs = Array.from(document.querySelectorAll('.tab'));
  const panels = document.querySelectorAll('.panel');
  const loadAudioEmbeds = document.getElementById('loadAudioEmbeds');

  const deckTag = document.getElementById('deckTag');
  const deckTitle = document.getElementById('deckTitle');
  const deckData = document.getElementById('deckData');
  const deckDesc = document.getElementById('deckDesc');
  const deckLinks = document.getElementById('deckLinks');
  const detailDeck = document.getElementById('detailDeck');
  const deckToggle = document.getElementById('deckToggle');
  const deckStateStorageKey = 'bread:detailDeckOpen';

  function triggerHaptic(pattern = 10) {
    if (!('vibrate' in navigator)) return;
    navigator.vibrate(pattern);
  }

  function setDeckOpenState(isOpen, { persist = true } = {}) {
    if (!detailDeck || !deckToggle) return;

    detailDeck.classList.toggle('is-open', isOpen);
    deckToggle.setAttribute('aria-expanded', String(isOpen));
    deckToggle.textContent = isOpen ? 'Hide details panel' : 'Show details panel';

    if (!persist) return;
    try {
      window.localStorage.setItem(deckStateStorageKey, String(isOpen));
    } catch {
      // Ignore storage access restrictions.
    }
  }

  function hydrateDeckState() {
    if (!detailDeck || !deckToggle) return;

    let storedPreference = null;
    try {
      storedPreference = window.localStorage.getItem(deckStateStorageKey);
    } catch {
      storedPreference = null;
    }

    const shouldOpenByDefault = storedPreference === null ? true : storedPreference === 'true';
    setDeckOpenState(shouldOpenByDefault, { persist: false });
  }

  function hydrateAudioEmbeds() {
    const targets = document.querySelectorAll('iframe[data-embed-src]');
    targets.forEach((frame) => {
      const src = frame.getAttribute('data-embed-src');
      if (!src || frame.getAttribute('src') === src) return;
      frame.setAttribute('src', src);
    });
    if (loadAudioEmbeds) {
      loadAudioEmbeds.setAttribute('disabled', 'true');
      loadAudioEmbeds.textContent = 'Embeds loaded';
    }
  }

  function activateTab(tab, { focus = false } = {}) {
    const panelId = tab.getAttribute('data-panel');
    tabs.forEach((item) => {
      const isActive = item === tab;
      item.classList.toggle('active', isActive);
      item.setAttribute('aria-selected', String(isActive));
      item.tabIndex = isActive ? 0 : -1;
    });

    panels.forEach((panel) => {
      const isActive = panel.id === panelId;
      panel.classList.toggle('active', isActive);
      panel.hidden = !isActive;
    });

    if (panelId === 'panel-audio') hydrateAudioEmbeds();
    if (focus) tab.focus();
    triggerHaptic(8);
  }

  tabs.forEach((tab, index) => {
    tab.tabIndex = tab.classList.contains('active') ? 0 : -1;

    tab.addEventListener('click', () => activateTab(tab));

    tab.addEventListener('keydown', (event) => {
      const key = event.key;
      if (!['ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(key)) return;

      event.preventDefault();
      let nextIndex = index;

      if (key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
      if (key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
      if (key === 'Home') nextIndex = 0;
      if (key === 'End') nextIndex = tabs.length - 1;

      activateTab(tabs[nextIndex], { focus: true });
    });
  });
  function updateDeck(payload) {
    if (!deckTag || !deckTitle || !deckData || !deckDesc || !deckLinks) return;
    deckTag.textContent = payload.tag;
    deckTitle.textContent = payload.title;
    deckData.textContent = payload.data;
    deckDesc.textContent = payload.desc;
    deckLinks.innerHTML = '';
    (payload.links || []).forEach((link) => {
      const a = document.createElement('a');
      a.href = link.href;
      a.textContent = link.label;
      if (link.external) {
        a.target = '_blank';
        a.rel = 'noreferrer';
      }
      deckLinks.append(a);
    });

    setDeckOpenState(true);
  }

  if (loadAudioEmbeds) {
    loadAudioEmbeds.addEventListener('click', () => {
      hydrateAudioEmbeds();
      triggerHaptic(12);
    });
  }

  if (deckToggle && detailDeck) {
    deckToggle.addEventListener('click', () => {
      const isOpen = !detailDeck.classList.contains('is-open');
      setDeckOpenState(isOpen);
      triggerHaptic(14);
    });
  }

  hydrateDeckState();

  document.querySelectorAll('.pick-btn').forEach((row) => {
    row.addEventListener('click', () => {
      document.querySelectorAll('.pick-btn').forEach((item) => item.classList.remove('is-selected'));
      row.classList.add('is-selected');
      triggerHaptic([10, 24, 10]);

      const kind = row.getAttribute('data-kind');
      const index = Number(row.getAttribute('data-index') || 0);

      if (kind === 'event') {
        const event = documentedChronology[index];
        if (!event) return;
        const statusDescription = event.status && event.status !== 'played' ? ` Status: ${event.status}.` : '';

        updateDeck({
          tag: 'EVENT',
          title: event.title,
          data: `${event.year} · ${event.date} · ${event.venue}`,
          desc: `${event.lineup}.${statusDescription}`,
          links: [{ href: '/archive/timeline/', label: 'Open timeline notes →', external: false }]
        });
        return;
      }

      if (kind === 'person') {
        const person = roster[index];
        if (!person) return;
        const links = [];
        if (person.links.sc) links.push({ href: person.links.sc, label: 'SoundCloud ↗', external: true });
        if (person.links.ig) links.push({ href: person.links.ig, label: 'Instagram ↗', external: true });
        if (person.links.ra) links.push({ href: person.links.ra, label: 'Resident Advisor ↗', external: true });
        if (person.links.bc) links.push({ href: person.links.bc, label: 'Bandcamp reference ↗', external: true });

        updateDeck({
          tag: 'PERSON',
          title: person.name,
          data: person.role,
          desc: 'Resident profile pulled from archive network and profile directory entries.',
          links
        });
      }
    });
  });

</script>
