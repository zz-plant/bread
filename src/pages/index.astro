    min-height: 44px;
    touch-action: manipulation;
  }

  .tab.active {
    color: #fff;
  }

  .tab:hover {
    color: var(--accent);
    transform: translateX(2px);
  }

  .policy {
    margin-top: auto;
    font-size: 0.82rem;
