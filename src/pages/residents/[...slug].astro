---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import { createPersonSchema } from '../../utils/structuredData';

export async function getStaticPaths() {
  const residents = await getCollection('roster');
  return residents.map((resident) => ({
    params: { slug: resident.id.replace(/\.(json|md)$/, '') },
    props: { resident },
  }));
}

const { resident } = Astro.props;
const data = resident.data;

const pageTitle = `${data.name} - BREAD Resident`;
const pageDescription = `${data.name} - ${data.role}${data.notes ? `. ${data.notes}` : ''}`;

const structuredData = createPersonSchema({
  site: Astro.site,
  name: data.name,
  role: data.role,
  links: data.links,
});
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  structuredData={structuredData}
  ogImage="/og/home.svg"
  ogImageAlt={`${data.name} - BREAD Resident`}
>
  <div class="resident-profile">
    <a href="/#panel-people" class="back-link">← Back to all residents</a>
    
    <header class="profile-header">
      <h1>{data.name}</h1>
      <p class="role">{data.role}</p>
      {data.notes && <p class="notes">{data.notes}</p>}
    </header>

    {Object.keys(data.links).length > 0 && (
      <section class="links-section">
        <h2>Links</h2>
        <ul class="link-list">
          {data.links.sc && (
            <li><a href={data.links.sc} target="_blank" rel="noreferrer noopener">SoundCloud ↗</a></li>
          )}
          {data.links.ig && (
            <li><a href={data.links.ig} target="_blank" rel="noreferrer noopener">Instagram ↗</a></li>
          )}
          {data.links.bc && (
            <li><a href={data.links.bc} target="_blank" rel="noreferrer noopener">Bandcamp ↗</a></li>
          )}
          {data.links.ra && (
            <li><a href={data.links.ra} target="_blank" rel="noreferrer noopener">RA ↗</a></li>
          )}
        </ul>
      </section>
    )}

    <section class="soundcloud-section">
      <h2>SoundCloud</h2>
      {data.links.sc ? (
        <div class="sc-embed">
          <iframe
            title={`${data.name} SoundCloud profile`}
            width="100%"
            height="300"
            allow="autoplay"
            loading="lazy"
            src={`https://w.soundcloud.com/player/?url=${encodeURIComponent(data.links.sc)}&color=%23ff5a1f&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=true&show_teaser=true&visual=false`}
          ></iframe>
        </div>
      ) : (
        <p class="no-sc">No SoundCloud profile available.</p>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .resident-profile {
    max-width: 48rem;
    margin: 0 auto;
    padding: 1.5rem 0;
  }

  .back-link {
    display: inline-block;
    color: var(--color-accent);
    text-decoration: none;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .profile-header {
    margin-bottom: 2rem;
  }

  .profile-header h1 {
    font-family: 'Syne', sans-serif;
    font-size: 2.5rem;
    margin: 0 0 0.5rem;
    letter-spacing: -0.03em;
  }

  .role {
    color: var(--color-accent);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .notes {
    color: var(--color-text-muted);
    margin: 1rem 0 0;
    line-height: 1.6;
  }

  .links-section,
  .soundcloud-section {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .links-section h2,
  .soundcloud-section h2 {
    font-size: 1.2rem;
    margin: 0 0 1rem;
    color: var(--color-text);
  }

  .link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  .link-list a {
    display: inline-block;
    padding: 0.6rem 1rem;
    background: var(--color-surface-raised);
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .link-list a:hover {
    background: var(--color-accent);
    color: var(--color-bg);
  }

  .sc-embed {
    margin-top: 1rem;
  }

  .sc-embed iframe {
    border: 0;
    border-radius: var(--radius-sm);
    background: #0a0a0a;
  }

  .no-sc {
    color: var(--color-text-muted);
    font-style: italic;
  }
</style>
