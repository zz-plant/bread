---
import { getCollection, render } from "astro:content";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ResponsiveImage from "../../components/ResponsiveImage.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, toContentSlug } from "../../utils/content";
import { GALLERY_IMAGE_SIZES } from "../../utils/images";
import {
	createArticleSchema,
	createBreadcrumbListSchema,
} from "../../utils/structuredData";

const posts = await getCollection(
	"blog",
	({ data }: { data: { draft: boolean } }) => !data.draft,
);
const storyPost = posts.find(
	(post: { id: string }) => toContentSlug(post.id) === "the-story-of-bread",
);

if (!storyPost) {
	throw new Error(
		'Required story entry "the-story-of-bread" was not found in blog collection.',
	);
}

const { Content: StoryContent } = await render(storyPost);

const postStructuredData = createArticleSchema({
	site: Astro.site,
	pathname: Astro.url.pathname,
	headline: storyPost.data.title,
	description: storyPost.data.description,
	datePublished: storyPost.data.date,
	dateModified: storyPost.data.date,
	section: "Story history",
	siteName: "BREAD",
	image: "/og/blog/the-story-of-bread.png",
});

const breadcrumbItems = [{ label: "Home", href: "/" }, { label: "Story" }];

const breadcrumbStructuredData = createBreadcrumbListSchema({
	site: Astro.site,
	items: [
		{ name: "Home", pathname: "/" },
		{ name: "Story", pathname: "/story/" },
	],
});

const structuredDataEntries = [
	postStructuredData,
	breadcrumbStructuredData,
].filter((entry): entry is Record<string, unknown> => Boolean(entry));

const storyGallery = [
	{
		src: "/drive/bread-x-grime-city_150213-show.png",
		alt: "BREAD x Grime City pilot flyer from February 2015",
		title: "BREAD x Grime City",
		caption: "Pilot night flyer, February 2015",
	},
	{
		src: "/drive/bread2-smaller.jpg",
		alt: "BREAD #2 flyer with chain visual treatment",
		title: "BREAD #2",
		caption: "Flyer, July 2015",
	},
	{
		src: "/drive/bread-3-flyer-final-letter.png",
		alt: "BREAD no.3 flyer featuring Doctor Jeep, Kieran Loftus, and others",
		title: "BREAD #3",
		caption: "Flyer, November 2015",
	},
	{
		src: "/drive/bread7c-01.png",
		alt: "Bread Number Seven poster with bread slice and utility crew imagery",
		title: "BREAD #7",
		caption: "Flyer, May 2016",
	},
	{
		src: "/drive/2015-07-19-08.54.27.jpg",
		alt: "Street photo of a BREAD #2 poster on a utility pole in San Francisco",
		title: "BREAD #2 poster",
		caption: "On a utility pole in San Francisco",
	},
	{
		src: "/drive/img_0530.jpg",
		alt: "Photo of attendees at a BREAD night",
		title: "Party photo",
		caption: "Inside a BREAD night",
	},
];
---

<BaseLayout
  title={storyPost.data.title}
  description={storyPost.data.description}
  structuredData={structuredDataEntries}
  canonical="/story/"
  ogType="article"
  ogImage="/og/blog/the-story-of-bread.png"
  ogImageAlt={`${storyPost.data.title} — ${storyPost.data.description}`}
>
  <article>
    <header class="page-header">
      <Breadcrumbs items={breadcrumbItems} />
      <h1>{storyPost.data.title}</h1>
      <p class="intro">{storyPost.data.description}</p>
      <p class="section-meta">Published {formatDate(storyPost.data.date)}</p>
    </header>
    <div class="prose">
      <StoryContent />
    </div>
    <section class="story-gallery" aria-labelledby="story-gallery-title">
      <div class="story-gallery-head">
        <h2 id="story-gallery-title">Flyers and photos</h2>
        <a href="/archive/flyers/">All flyers →</a>
      </div>
      <ul class="gallery">
        {storyGallery.map((item) => (
          <li>
            <figure class="gallery-item">
              <span class="gallery-frame">
                <ResponsiveImage src={item.src} alt={item.alt} sizes={GALLERY_IMAGE_SIZES} />
              </span>
              <figcaption class="gallery-caption">
                <span class="gallery-title">{item.title}</span>
                <span class="gallery-meta">{item.caption}</span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>
    <nav class="pager" aria-label="Keep reading">
      <a class="pager-prev" href="/archive/timeline/">
        <span>Year by year</span>
        <strong>Timeline</strong>
      </a>
      <a class="pager-next" href="/archive/event-ledger/">
        <span>Every night, with sources</span>
        <strong>Event list</strong>
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .story-gallery {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }

  .story-gallery-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: var(--space-lg);
  }

  .story-gallery-head h2 {
    margin: 0;
    font: var(--text-title);
  }

  .story-gallery-head a {
    font: var(--text-caption);
    color: var(--color-text-secondary);
    text-decoration: none;
  }

  .story-gallery-head a:hover {
    color: var(--color-accent-text);
  }

  .story-gallery figure {
    margin: 0;
  }
</style>
