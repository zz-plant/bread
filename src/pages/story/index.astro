---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getCollection, render } from "astro:content";
import { formatDate, toContentSlug } from "../../utils/content";
import {
	createArticleSchema,
	createBreadcrumbListSchema,
} from "../../utils/structuredData";

const posts = await getCollection("blog", ({ data }: { data: { draft: boolean } }) => !data.draft);
const storyPost = posts.find(
	(post: { id: string }) => toContentSlug(post.id) === "the-story-of-bread",
);

if (!storyPost) {
	throw new Error(
		'Required story entry "the-story-of-bread" was not found in blog collection.',
	);
}

const { Content: StoryContent } = await render(storyPost);

const whatBreadWasPost = posts.find(
	(post: { id: string }) => toContentSlug(post.id) === "bread-san-francisco-dj-collective",
);

let WhatBreadWasContent: Awaited<ReturnType<typeof render>>["Content"] | null = null;
if (whatBreadWasPost) {
	const { Content } = await render(whatBreadWasPost);
	WhatBreadWasContent = Content;
}

const postStructuredData = createArticleSchema({
	site: Astro.site,
	pathname: Astro.url.pathname,
	headline: storyPost.data.title,
	description: storyPost.data.description,
	datePublished: storyPost.data.date,
	dateModified: storyPost.data.date,
	section: "Story history",
	siteName: "BREAD",
});

const breadcrumbItems = [{ label: "Home", href: "/" }, { label: "Story" }];

const breadcrumbStructuredData = createBreadcrumbListSchema({
	site: Astro.site,
	items: [
		{ name: "Home", pathname: "/" },
		{ name: "Story", pathname: "/story/" },
	],
});

const structuredDataEntries = [
	postStructuredData,
	breadcrumbStructuredData,
].filter((entry): entry is Record<string, unknown> => Boolean(entry));

const storyGallery = [
	{
		src: "/drive/bread-x-grime-city_150213-show.png",
		alt: "BREAD x Grime City pilot flyer from February 2015",
		title: "Pilot flyer",
		caption: "BREAD x Grime City · February 2015",
	},
	{
		src: "/drive/bread2-smaller.jpg",
		alt: "BREAD #2 flyer with chain visual treatment",
		title: "BREAD #2",
		caption: "Flyer artwork · July 2015",
	},
	{
		src: "/drive/bread-3-flyer-final-letter.png",
		alt: "BREAD no.3 flyer featuring Doctor Jeep, Kieran Loftus, and others",
		title: "BREAD no.3",
		caption: "Flyer artwork · November 2015",
	},
	{
		src: "/drive/bread7c-01.png",
		alt: "Bread Number Seven poster with bread slice and utility crew imagery",
		title: "BREAD Number Seven",
		caption: "Flyer artwork · May 2016",
	},
	{
		src: "/drive/2015-07-19-08.54.27.jpg",
		alt: "Street photo of a BREAD #2 poster on a utility pole in San Francisco",
		title: "Street posting",
		caption: "Poster in the city",
	},
	{
		src: "/drive/img_0530.jpg",
		alt: "Photo of attendees at a BREAD night",
		title: "Inside the venue",
		caption: "Party photo",
	},
];
---

<BaseLayout
  title={storyPost.data.title}
  description={storyPost.data.description}
  structuredData={structuredDataEntries}
  canonical="/story/"
  ogImage="/og/blog/the-story-of-bread.svg"
  ogImageAlt={`${storyPost.data.title} — ${storyPost.data.description}`}
>
  <article class="panel">
    <header class="page-header">
      <p class="section-kicker">Story</p>
      <h1>{storyPost.data.title}</h1>
      <p>{storyPost.data.description}</p>
      <p class="section-meta">Published {formatDate(storyPost.data.date)}</p>
      <Breadcrumbs items={breadcrumbItems} />
      <nav class="link-row" aria-label="Story links">
        <a class="chip-link" href="/archive/">Archive</a>
        <a class="chip-link" href="/archive/timeline/">Timeline</a>
      </nav>
    </header>
    <section class="story-gallery" aria-label="Story gallery">
      <p class="section-kicker">Visual trail</p>
      <h2>Story Gallery</h2>
      <p class="story-gallery-intro">A few flyers and party photos to read alongside the story.</p>
      <ul class="story-gallery-grid">
        {storyGallery.map((item) => (
          <li>
            <figure>
              <img src={item.src} alt={item.alt} loading="lazy" decoding="async" />
              <figcaption>
                <p>{item.title}</p>
                <small>{item.caption}</small>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
      <p class="story-gallery-route"><a href="/archive/flyers/">Open full flyer archive →</a></p>
    </section>
    <hr />
    <StoryContent />
    {WhatBreadWasContent && (
      <section class="what-bread-was" aria-labelledby="what-bread-was-heading">
        <hr />
        <h2 id="what-bread-was-heading">What BREAD Was</h2>
        <WhatBreadWasContent />
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .story-gallery {
    margin: 1rem 0 1.2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    padding: 0.85rem;
    display: grid;
    gap: 0.65rem;
  }

  .story-gallery h2 {
    margin: 0;
    line-height: 1;
  }

  .story-gallery-intro {
    margin: 0;
    color: var(--color-text-muted);
  }

  .story-gallery-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .story-gallery-grid li {
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface-raised);
    overflow: hidden;
  }

  .story-gallery-grid figure {
    margin: 0;
    display: grid;
  }

  .story-gallery-grid img {
    width: 100%;
    height: auto;
    display: block;
    border-bottom: 1px solid var(--color-border);
  }

  .story-gallery-grid figcaption {
    display: grid;
    gap: 0.2rem;
    padding: 0.55rem 0.65rem 0.6rem;
  }

  .story-gallery-grid figcaption p {
    margin: 0;
    color: var(--color-text);
    font-weight: 600;
  }

  .story-gallery-grid figcaption small {
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .story-gallery-route {
    margin: 0.15rem 0 0;
  }

  .story-gallery-route a {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
  }

  .story-gallery-route a:hover,
  .story-gallery-route a:focus-visible {
    text-decoration: underline;
    border-bottom-color: var(--color-border-strong);
  }

  @media (max-width: 620px) {
    .story-gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
